# shared-mime-info
PKG_VER=2.5.1
PKG_URL="https://gitlab.freedesktop.org/xdg/shared-mime-info/-/archive/${PKG_VER}/shared-mime-info-${PKG_VER}.tar.gz"
PKG_DEPS="lfs/GLib"
PKG_DEPS+=" lfs/libxml2"
BUILD_PROCESS=mesonninja
### The MIME database is made in the image (postinstall.sh), by its update-mime-database: a cross build
### would run the one of the build machine, which has none, and it covers the MIME types of every
### package, the ones installed after this
CONF_FLAGS="-Dupdate-mimedb=false"
#PKG_MAKETARGETS="all,install"
