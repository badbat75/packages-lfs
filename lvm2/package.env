# lvm2
PKG_VER=2.03.43
PKG_URL="https://sourceware.org/ftp/lvm2/LVM2.${PKG_VER}.tgz"
PKG_DEPS="lfs/libaio lfs/systemd:bootstrap"
### Optional packages
# PKG_DEPS+=" lfs/thin-provisioning"
# PKG_DEPS+=" lfs/vdo"
###
BUILD_PROCESS=configmake
PKG_AUTOCONF=1
CONF_FLAGS="--with-usrlibdir=${INSTALL_LIBDIR}${INSTALL_LIBSUFFIX}"
CONF_FLAGS+=" --with-systemdsystemunitdir=/lib/systemd/system"
CONF_FLAGS+=" --enable-cmdlib"
CONF_FLAGS+=" --enable-pkgconfig"
CONF_FLAGS+=" --enable-udev_sync"
PKG_MAKETARGETS="all,install,install_systemd_units"
PKG_COPYSRC=1

### The targets split what the build installs (split_install in the postbuild.sh of
### variants/target/<target>): :lib device-mapper, the libdevmapper of cryptsetup with its include
### file and pc file, dmsetup, dmstats, blkdeactivate and the udev rules of device-mapper (with udev_sync libdevmapper waits
### for the cookie 95-dm-notify.rules releases through dmsetup udevcomplete), :tool LVM, the lvm
### commands, liblvm2cmd, its configuration, rules and units, over :lib. Without a target the whole
### lvm2. The lists are paths of the image, find -path patterns (a * also matches a /)
LVM2_LIB_FILES="${INSTALL_LIBDIR}${INSTALL_LIBSUFFIX}/libdevmapper.so*"
LVM2_LIB_FILES+=" ${INSTALL_LIBDIR}${INSTALL_LIBSUFFIX}/pkgconfig/devmapper.pc ${INSTALL_INCLUDEDIR}/libdevmapper.h"
LVM2_LIB_FILES+=" ${INSTALL_EXECPREFIX}/sbin/dmsetup ${INSTALL_EXECPREFIX}/sbin/dmstats ${INSTALL_EXECPREFIX}/sbin/dmvdostats"
LVM2_LIB_FILES+=" ${INSTALL_EXECPREFIX}/sbin/blkdeactivate ${INSTALL_SHAREDIR}/man/man8/blkdeactivate.8"
LVM2_LIB_FILES+=" ${INSTALL_PREFIX}/lib/udev/rules.d/10-dm.rules ${INSTALL_PREFIX}/lib/udev/rules.d/13-dm-disk.rules"
LVM2_LIB_FILES+=" ${INSTALL_PREFIX}/lib/udev/rules.d/95-dm-notify.rules ${INSTALL_SHAREDIR}/man/man8/dmsetup.8"
LVM2_LIB_FILES+=" ${INSTALL_SHAREDIR}/man/man8/dmstats.8 ${INSTALL_SHAREDIR}/man/man8/dmvdostats.8"
