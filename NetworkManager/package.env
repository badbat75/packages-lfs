# NetworkManager
PKG_VER=1.58.1
### download.gnome.org stopped carrying NetworkManager after 1.52: the release tarballs are on gitlab
PKG_URL="https://gitlab.freedesktop.org/NetworkManager/NetworkManager/-/releases/${PKG_VER}/downloads/NetworkManager-${PKG_VER}.tar.xz"
### The BLFS dependencies: libndp required; curl (connectivity check), gobject-introspection,
### iptables, libpsl, gnutls (the crypto backend, nss is the other), polkit, systemd and
### wpa_supplicant (started over D-Bus, CONFIG_CTRL_IFACE_DBUS_NEW) of the recommended ones.
### Left out: newt and slang (nmtui), nftables (iptables does the shared mode), ModemManager,
### ppp, vala, jansson (ovs, nm-cloud-setup), libbpf (clat), libnvme (nbft)
PKG_DEPS="lfs/libndp lfs/systemd lfs/D-Bus lfs/GLib lfs/gobject-introspection lfs/util-linux"
PKG_DEPS+=" lfs/polkit lfs/curl lfs/libpsl lfs/gnutls lfs/readline lfs/iptables lfs/wpa_supplicant"
CONF_FLAGS="-Dsystemdsystemunitdir=/lib/systemd/system"
CONF_FLAGS+=" -Dudev_dir=/lib/udev"
CONF_FLAGS+=" -Ddbus_conf_dir=${INSTALL_SHAREDIR}/dbus-1/system.d"
CONF_FLAGS+=" -Dsession_tracking=systemd -Dsuspend_resume=systemd -Dsystemd_journal=true"
CONF_FLAGS+=" -Dpolkit=true -Dpolkit_agent_helper_1=${INSTALL_PREFIX}/lib/polkit-1/polkit-agent-helper-1"
CONF_FLAGS+=" -Dselinux=false -Dlibaudit=no"
### A cross build finds the host programs: the paths of the image are given
CONF_FLAGS+=" -Diptables=${INSTALL_PREFIX}/sbin/iptables -Dip6tables=${INSTALL_PREFIX}/sbin/ip6tables"
CONF_FLAGS+=" -Dnft=${INSTALL_PREFIX}/sbin/nft -Ddnsmasq=${INSTALL_PREFIX}/sbin/dnsmasq"
CONF_FLAGS+=" -Dmodprobe=${INSTALL_PREFIX}/sbin/modprobe"
CONF_FLAGS+=" -Dconfig_wifi_backend_default=wpa_supplicant -Dwext=false -Diwd=false"
CONF_FLAGS+=" -Dppp=false -Dmodem_manager=false -Dofono=false -Dbluez5_dun=false"
CONF_FLAGS+=" -Dteamdctl=false -Dovs=false -Dnm_cloud_setup=false -Debpf=false -Dnbft=false -Dclat=false"
CONF_FLAGS+=" -Dnmcli=true -Dreadline=libreadline -Dnmtui=false"
CONF_FLAGS+=" -Dconcheck=true -Dlibpsl=true -Dcrypto=gnutls"
CONF_FLAGS+=" -Difcfg_rh=false -Difupdown=false -Dconfig_dhcp_default=internal -Dfirewalld_zone=false"
CONF_FLAGS+=" -Dintrospection=true -Dvapi=false -Dqt=false"
### The man pages and the documentation run programs of the build (the settings generator)
CONF_FLAGS+=" -Ddocs=false -Dman=false -Dtests=no"
BUILD_PROCESS=mesonninja
PKG_MAKETARGETS=",install"
PKG_LDFLAGS="-s"
