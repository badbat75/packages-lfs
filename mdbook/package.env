# mdbook: builds a book out of Markdown files
### A host tool (lfs/mdbook:native): the wayland documentation is an mdbook book since 1.24
PKG_VER=0.5.4
PKG_URL="https://github.com/rust-lang/mdBook/archive/refs/tags/v${PKG_VER}.tar.gz"
BUILD_PROCESS=cargobuild
PKG_OVERRIDELTO=0
CONF_FLAGS=""
CARGO_BINLIST="mdbook"
PKG_LDFLAGS=-s
