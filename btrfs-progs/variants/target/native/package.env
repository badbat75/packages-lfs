# btrfs-progs, target native: mkfs.btrfs and fsck.btrfs of the build machine, with which create_image
# and mount_tag (images.functions) make and check the btrfs filesystems of an image. The libblkid and
# libuuid of lfs/util-linux:native, the zlib of lfs/zlib:native, the builtin crypto: nothing of the host
### Not the default build: the values of package.env this target keeps or drops
PKG_DEPS="lfs/util-linux:native lfs/zlib:native"
CONF_FLAGS="--disable-documentation --disable-convert --disable-python --disable-libudev --disable-zoned"
CONF_FLAGS+=" --disable-lzo --disable-zstd"
CONF_ENV=
PKG_CFLAGS=
### The programs in sbin, next to the ones of lfs/e2fsprogs:native
PKG_MAKEVARS="bindir=${INSTALL_EXECPREFIX}/sbin"
PKG_CHECK="${INSTALL_EXECPREFIX}/sbin/mkfs.btrfs --version 2>/dev/null | grep -q 'btrfs-progs v${PKG_VER}\$'"
### Built by the gnu toolchain: an image can be made before llvm is there
PKG_TOOLCHAIN=gnu
