# SQLite, option tcl (WITH_TCL=1, the default): the TCL bindings (libsqlite<ver>.so and pkgIndex.tcl)
### The target Tcl gives the headers, the stub library and tclConfig.sh; configure also wants a
### tclsh it can run, the native one. --with-tcl points at the copy of tclConfig.sh prebuild.sh
### makes (expanded when runconfig.sh runs, hence the single quotes), and TCLLIBDIR is given
### because configure would ask the native tclsh for its own auto_path.
PKG_DEPS+=" lfs/Tcl lfs/Tcl:native"
CONF_FLAGS="${SQLITE_COMMON_FLAGS}"
CONF_FLAGS+=' --with-tcl=${PKG_SRCPATH}/tclconfig'
CONF_ENV+=" TCLLIBDIR=${INSTALL_LIBDIR}${INSTALL_LIBSUFFIX}/tcl8.6/sqlite${PKG_VER}"
