# SQLite
PKG_VER=3.53.4
PKG_URL="https://github.com/sqlite/sqlite/archive/refs/tags/version-${PKG_VER}.tar.gz"
PKG_DEPS="lfs/libedit"
BUILD_PROCESS=configmake
### Since 3.49 the configure script is autosetup (auto.def), not autoconf: it ships in the tree and
### must not be regenerated (PKG_AUTOCONF would delete it and fail on the missing configure.ac), it
### rejects --with-sysroot (the sysroot travels in CC, CFLAGS and LDFLAGS) so the standard flags are
### spelled out here, and CCACHE=none stops it from running the toolchain's ccache -> sccache link
### with -vV, a call sccache never returns from.
STD_CONF_FLAGS=0
SQLITE_COMMON_FLAGS="--build=${BARCH} --host=${HARCH} --prefix=${INSTALL_PREFIX} --exec-prefix=${INSTALL_EXECPREFIX} \
	--libdir=${INSTALL_LIBDIR}${INSTALL_LIBSUFFIX} --includedir=${INSTALL_INCLUDEDIR} \
	--sysconfdir=${INSTALL_SYSCONFDIR} --localstatedir=${INSTALL_LOCALSTATEDIR} \
	--enable-shared --disable-static --enable-fts5"
### WITH_TCL=1 (the default) builds the TCL bindings (variants/option/tcl); without them the code
### generation runs on the jimsh of the source tree and configure must not find the host Tcl
WITH_TCL=${WITH_TCL:-1}
CONF_FLAGS="${SQLITE_COMMON_FLAGS} --disable-tcl"
CONF_ENV="CCACHE=none"
PKG_CPPFLAGS="-DSQLITE_ENABLE_FTS3=1"
PKG_CPPFLAGS+=" -DSQLITE_ENABLE_FTS4=1"
PKG_CPPFLAGS+=" -DSQLITE_ENABLE_COLUMN_METADATA=1"
PKG_CPPFLAGS+=" -DSQLITE_ENABLE_UNLOCK_NOTIFY=1"
PKG_CPPFLAGS+=" -DSQLITE_ENABLE_DBSTAT_VTAB=1"
PKG_CPPFLAGS+=" -DSQLITE_SECURE_DELETE=1"
PKG_CPPFLAGS+=" -DSQLITE_ENABLE_FTS3_TOKENIZER=1"
PKG_MAKETARGETS=",install"
