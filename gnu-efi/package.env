# gnu-efi
PKG_VER=4.0.4
### gnu-efi left SourceForge for GitHub with the 4.x series
PKG_URL="https://github.com/ncroxon/gnu-efi/archive/refs/tags/${PKG_VER}.tar.gz"
PKG_OVERRIDELTO=0
BUILD_PROCESS=simplemake
PKG_MAKETARGETS=",install"
PKG_MAKEENV="env -u LDFLAGS -u LD -u LDFLAGS_FOR_BUILD"
PKG_MAKEVARS="-j1 PREFIX=${INSTALL_PREFIX} INSTALLROOT=\${PKG_PKGPATH} LIBDIR=${INSTALL_LIBDIR}${INSTALL_LIBSUFFIX} ARCH=${HM} CROSS_COMPILE=${HARCH}- AR=\${AR}"
