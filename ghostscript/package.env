# ghostscript
PKG_VER=10.08.0
PKG_URL="https://github.com/ArtifexSoftware/ghostpdl-downloads/releases/download/gs${PKG_VER//./}/ghostscript-${PKG_VER}.tar.xz"
#PKG_DEPS="lfs/cups:bootstrap"
PKG_DEPS+=" lfs/fontconfig"
PKG_DEPS+=" lfs/FreeType"
PKG_DEPS+=" lfs/LittleCMS"
PKG_DEPS+=" lfs/libjpeg-turbo"
PKG_DEPS+=" lfs/libpng"
PKG_DEPS+=" lfs/libtiff"
PKG_DEPS+=" lfs/OpenJPEG"
PKG_DEPS+=" lfs/Cairo:bootstrap"
#PKG_DEPS+=" lfs/GTK+"
PKG_DEPS+=" lfs/libidn"
### The brotli of lfs/brotli, not the copy in the sources: its decoder declares a variable after a
### statement on 32 bit ARM (BROTLI_HC_MARK_TABLE_FOR_FAST_LOAD), which ghostscript compiles with
### -Werror=declaration-after-statement. The tools of the build machine keep the local one
PKG_DEPS+=" lfs/brotli"
#PKG_DEPS+=" lfs/libpaper"
BUILD_PROCESS=configmake
PKG_AUTOCONF=1
CONF_FLAGS="--with-system-libtiff --without-local-brotli"
### the build machine tools (echogs, genarch) use CCAUX/CFLAGSAUX, left empty by a cross
### configure: without -std the host GCC 16 compiles them as C23 and rejects "typedef int bool"
CONF_VARS="CCAUX=\"\${CC_FOR_BUILD}\" CFLAGSAUX=\"\${CFLAGS_FOR_BUILD}\""
PKG_MAKETARGETS="so,install,soinstall"

#PKG_CFLAGS="-I\$(\${PKG_CONFIG} --cflags libopenjp2)"

PKG_COPYSRC=1
PKG_FAULTYCFLAGS=1
