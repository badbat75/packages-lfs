# tcpdump
PKG_VER=4.99.6
PKG_URL="https://www.tcpdump.org/release/tcpdump-${PKG_VER}.tar.gz"
PKG_DEPS="lfs/D-Bus lfs/libpcap lfs/openssl"
### WITH_CAP_NG (on by default) links libcap-ng when the sysroot has it, to drop the capabilities
### after opening the device: a dependency, so that it does not depend on the build order
PKG_DEPS+=" lfs/libcap-ng"
BUILD_PROCESS=cmakebuild
CONF_FLAGS=""
PKG_MAKETARGETS="all,install/strip"

PKG_OVERRIDELTO=0