# glycin, target svg
### The SVG loader alone: it links librsvg, which links gdk-pixbuf, which links libglycin. lfs.prj builds it
### after lfs/Cairo
PKG_DEPS="lfs/glycin lfs/librsvg lfs/Cairo:bootstrap"
CONF_FLAGS="${GLYCIN_COMMON_FLAGS} -Dlibglycin=false -Dintrospection=false -Dglycin-loaders=true -Dloaders=glycin-svg"
