# glycin
PKG_VER=2.2.1
PKG_URL="https://download.gnome.org/sources/glycin/$(echo "${PKG_VER}" | cut -d. -f1,2)/glycin-${PKG_VER}.tar.xz"
### The image loaders of gdk-pixbuf: libglycin and the loaders are Rust crates meson builds through cargo
### (the crates are downloaded at build time), every loader runs as a process of its own in a bwrap sandbox
PKG_DEPS="lfs/GLib lfs/fontconfig lfs/libseccomp lfs/gobject-introspection lfs/bubblewrap"
BUILD_PROCESS=mesonninja
### cross-rust: the rust compiler and the cargo target of the cross build, written by prebuild.sh (single
### quotes: expanded when runconfig.sh runs). The boolean options of glycin default to true
GLYCIN_COMMON_FLAGS='--cross-file ${PKG_BLDPATH}/cross-rust'
GLYCIN_COMMON_FLAGS+=" -Dlibglycin-gtk4=false -Dvapi=false -Dglycin-thumbnailer=false -Dtests=false -Dtest_tokio=false"
### glycin-image-rs is pure Rust (png, jpeg, gif, webp, tiff, bmp, ico, tga, exr, qoi, pnm, xpm, xbm...);
### heif and jxl need libheif and libjxl (no recipe); svg links librsvg, which needs gdk-pixbuf and so
### this build: it is the svg target
CONF_FLAGS="${GLYCIN_COMMON_FLAGS} -Dlibglycin=true -Dintrospection=true -Dglycin-loaders=true -Dloaders=glycin-image-rs"
