# autoconf-archive
### The version: AUTOCONFARCHIVE_VER of the project overrides it
AUTOCONFARCHIVE_VER=${AUTOCONFARCHIVE_VER:-2024.10.16}
PKG_SUFFIX=_${AUTOCONFARCHIVE_VER}
PKG_URL="http://mirror.kumi.systems/gnu/autoconf-archive/autoconf-archive-${AUTOCONFARCHIVE_VER}.tar.xz"
PKG_DEPS=
BUILD_PROCESS=configmake
CONF_FLAGS=""
PKG_MAKETARGETS="all,install-strip"
