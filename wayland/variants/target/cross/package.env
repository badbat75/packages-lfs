# wayland, target cross
### Not the default build: the values of package.env this target keeps or drops
CONF_ENV=
### No DTD validation of the protocols: it links the scanner with libxml2, which the pkg-config of a
### cross build finds in the global toolchain, whose directory is not in its RUNPATH once installed
CONF_FLAGS="-Dtests=false -Ddocumentation=false -Ddtd_validation=false"

### libffi of the platform toolchain, not the one of the build host
PKG_DEPS="lfs/expat:cross lfs/libffi:cross"
