# wayland
PKG_VER=1.26.0
PKG_URL="https://gitlab.freedesktop.org/wayland/wayland/-/releases/${PKG_VER}/downloads/wayland-${PKG_VER}.tar.xz"
BUILD_PROCESS=mesonninja
### Since 1.24 the documentation needs mdbook (a Rust tool, no recipe yet) besides doxygen and
### xmlto: off until an mdbook:native build exists
CONF_FLAGS="-Dtests=false -Ddocumentation=false"

PKG_DEPS="lfs/libxml2 lfs/expat lfs/wayland:cross"
CONF_ENV="PKG_CONFIG_SYSROOT_DIR= PKG_CONFIG_LIBDIR+=:${TOOLCHAIN_PATH}/lib/pkgconfig"
