# wayland
PKG_VER=1.26.0
PKG_URL="https://gitlab.freedesktop.org/wayland/wayland/-/releases/${PKG_VER}/downloads/wayland-${PKG_VER}.tar.xz"
BUILD_PROCESS=mesonninja
### Since 1.24 the documentation is an mdbook book (lfs/mdbook:native) besides doxygen and xmlto;
### dot (graphviz), xsltproc and the docbook XSL style sheets come from the host
CONF_FLAGS="-Dtests=false -Ddocumentation=true"
### The wayland-scanner of the build machine is the one of lfs/wayland:cross: its pc file has to
### win over the one a previous build of this package left in the sysroot (/usr/bin/wayland-scanner)
CONF_FLAGS+=" -Dbuild.pkg_config_path=${TOOLCHAIN_PATH}/lib/pkgconfig"

PKG_DEPS="lfs/libxml2 lfs/expat lfs/wayland:cross"
PKG_DEPS+=" lfs/doxygen:native lfs/xmlto:native lfs/mdbook:native"
CONF_ENV="PKG_CONFIG_SYSROOT_DIR= PKG_CONFIG_LIBDIR+=:${TOOLCHAIN_PATH}/lib/pkgconfig"
