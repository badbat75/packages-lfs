# wayland
PKG_VER=1.26.0
PKG_URL="https://gitlab.freedesktop.org/wayland/wayland/-/releases/${PKG_VER}/downloads/wayland-${PKG_VER}.tar.xz"
BUILD_PROCESS=mesonninja
CONF_FLAGS="-Dtests=false"

PKG_DEPS="lfs/libxml2 lfs/expat lfs/wayland:cross"
### The documentation: the man3 pages and the HTML of the API (doxygen, its graphs in PNG with the dot
### of graphviz, then xsltproc and xmlto with the DocBook of the global toolchain) and the book (mdbook)
PKG_DEPS+=" lfs/doxygen:native lfs/graphviz:native lfs/xmlto:native lfs/libxslt:native lfs/docbook-xsl:native lfs/mdbook:native"
CONF_ENV="PKG_CONFIG_SYSROOT_DIR= PKG_CONFIG_LIBDIR+=:${TOOLCHAIN_PATH}/lib/pkgconfig"
