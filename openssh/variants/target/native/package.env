# openssh, target native: ssh-keygen, which generate_ssh_keys runs on the host to make the host keys
# of the target
### The libcrypto of lfs/openssl:native, no PAM, Kerberos, libedit or zlib. The configuration
### directory is the one of the target, /etc/ssh: ssh-keygen -A -f <dir> writes under <dir> there
PKG_DEPS="lfs/openssl:native"
CONF_FLAGS="--sysconfdir=/etc/ssh --with-ssl-dir=${INSTALL_PREFIX} --without-pam --without-zlib --without-libedit"
PKG_MAKETARGETS="ssh-keygen"
### ssh-keygen has no version option (ssh -V is not built): the version is in a file next to it
### (postbuild.sh)
PKG_CHECK="[ x\$( cat ${INSTALL_SHAREDIR}/ssh-keygen.version 2>/dev/null || true ) == x${PKG_VER} ]"
