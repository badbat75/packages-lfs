# libgmp
PKG_VER=6.3.0
PKG_URL="http://ftp.gnu.org/gnu/gmp/gmp-${PKG_VER}.tar.xz"
PKG_DEPS="lfs/bison:native lfs/flex:native"
BUILD_PROCESS=configmake
CONF_FLAGS="--enable-cxx"
PKG_MAKETARGETS="all,install-strip"
PKG_AUTOCONF=1
PKG_OVERRIDELTO=0
### The "long long reliability" compiler test of configure declares g() and calls it with six
### arguments: in C23 (the gcc 15+ default) an empty parameter list means no parameters, and
### configure concludes "could not find a working compiler"
PKG_CFLAGS="-std=gnu17"

PKG_DEPS+=" lfs/ncurses lfs/readline"
