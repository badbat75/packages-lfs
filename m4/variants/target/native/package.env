# m4, target native: the m4 of the build machine, before the autotools (setup_full_toolchain): the
# autoconf of setup_autotools, flex and bison record the path of the m4 they run
PKG_CHECK="[ \"\$( ${INSTALL_EXECPREFIX}/bin/m4 --version 2>/dev/null | head -n1 )\" == \"m4 (GNU M4) ${PKG_VER}\" ]"
### Built by the gnu toolchain: the toolchain steps need it before llvm is there
PKG_TOOLCHAIN=gnu
