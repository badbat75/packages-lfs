# Vulkan-SPIRV-LLVM-Translator
### The major version must be the one of lfs/llvm; the last number is the translator's own
PKG_VER=23.1.1
### The global LLVM (lfs/llvm:native)
SPIRV_LLVM_PATH=${GLOBAL_TOOLCHAIN_PATH}/llvm-$( package_version lfs/llvm:native )
PKG_URL="https://github.com/KhronosGroup/SPIRV-LLVM-Translator/archive/refs/tags/v${PKG_VER}.tar.gz"
BUILD_PROCESS=cmakebuild
CONF_FLAGS="-DLLVM_DIR=${SPIRV_LLVM_PATH} -DCCACHE_ALLOWED:BOOL=OFF"
PKG_MAKETARGETS="all,install/strip"
#### Missing symbols during build with llvm
PKG_TOOLCHAIN=gnu

PKG_DEPS="lfs/Vulkan-SPIRV-Headers lfs/Vulkan-SPIRV-LLVM-Translator:cross"
CONF_FLAGS+=" -DLLVM_SPIRV=${SPIRV_LLVM_PATH}/bin/llvm-spirv"
