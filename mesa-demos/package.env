# mesa-demos
PKG_VER=8.5.0
PKG_URL="https://archive.mesa3d.org/demos/${PKG_VER}/mesa-demos-${PKG_VER}.tar.bz2"
PKG_DEPS="lfs/Mesa lfs/GLU"
BUILD_PROCESS=mesonninja
CONF_FLAGS=
CONF_FLAGS+=" -Dstrip=true"
#PKG_MAKETARGETS="all,install"
### The wayland-scanner is a dependency of the build machine (native: true): the one of
### lfs/wayland:cross, not the one of the sysroot (see lfs/wayland-protocols)
PKG_DEPS+=" lfs/wayland:cross"
CONF_FLAGS+=" -Dbuild.pkg_config_path=${TOOLCHAIN_PATH}/lib/pkgconfig"
