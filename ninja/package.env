# ninja
PKG_VER=1.12.1
PKG_URL="https://github.com/ninja-build/ninja/archive/refs/tags/v${PKG_VER}.tar.gz"
PKG_DEPS=""
BUILD_PROCESS=cmakebuild
### The bundled googletest does not build with GCC 15 and later (uintptr_t undeclared) and the
### tests are not needed
CONF_FLAGS="-DBUILD_TESTING=OFF"
CMAKE_GENERATOR="Unix Makefiles"
PKG_MAKETARGETS="all,install/strip"
