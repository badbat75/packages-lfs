# lmdb
PKG_VER=1.0.1
PKG_URL="https://github.com/LMDB/lmdb/archive/refs/tags/LMDB_${PKG_VER}.tar.gz"
BUILD_PROCESS=simplemake
CONF_PATH=libraries/liblmdb
### The Makefile assigns CC, AR, CFLAGS and LDFLAGS: only the make command line overrides them. OPT
### carries the flags of the build (XCFLAGS would also end in the Cflags of lmdb.pc)
PKG_MAKEVARS="prefix=${INSTALL_PREFIX} libdir=${INSTALL_LIBDIR}${INSTALL_LIBSUFFIX}"
PKG_MAKEVARS+=' CC="${CC}" AR="${AR}" OPT="${CFLAGS}" LDFLAGS="-pthread ${LDFLAGS}"'
PKG_MAKETARGETS="all,install"
