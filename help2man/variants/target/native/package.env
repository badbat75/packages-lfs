# help2man, target native: the manual pages of the programs a build runs on the build machine (the
# libtool of setup_autotools, lfs/GRUB of a platform of the same machine), a perl script run by the
# perl of lfs/perl5:native
PKG_CHECK="[ \"\$( ${INSTALL_EXECPREFIX}/bin/help2man --version 2>/dev/null | head -n1 )\" == \"GNU help2man ${PKG_VER}\" ]"
### Built by the gnu toolchain: the toolchain steps need it before llvm is there
PKG_TOOLCHAIN=gnu
