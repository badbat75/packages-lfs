# openldap
PKG_VER=2.7.1
PKG_URL="https://www.openldap.org/software/download/OpenLDAP/openldap-release/openldap-${PKG_VER}.tgz"
BUILD_PROCESS=configmake
PKG_AUTOCONF=1
### build/mkversion stamps the libraries and the programs with "$USER@$(uname -n):$(pwd)", the name of
### the container and the build directory of the host, which ldapsearch and friends then carry. With
### SOURCE_DATE_EPOCH set the stamp is the constant "openldap" (the reproducible builds path upstream
### offers)
PKG_MAKEENV="SOURCE_DATE_EPOCH=1"
### The targets split what the build installs (postbuild.sh of variants/target/<target>): :lib the
### libraries with their include files, pc files, ldap.conf and manual pages, :client the ldap* tools,
### :server everything else (slapd, its modules and tools, lloadd, the schemas), both over :lib.
### :bootstrap is the libraries without cyrus-sasl, which depends on them. Without a target the whole
### OpenLDAP. The lists are paths of the image, find -path patterns (a * also matches a /)
OPENLDAP_LIBPATH=${INSTALL_LIBDIR}${INSTALL_LIBSUFFIX}
OPENLDAP_LIB_FILES="${OPENLDAP_LIBPATH}/liblber* ${OPENLDAP_LIBPATH}/libldap* ${OPENLDAP_LIBPATH}/pkgconfig/lber.pc"
OPENLDAP_LIB_FILES+=" ${OPENLDAP_LIBPATH}/pkgconfig/ldap.pc ${INSTALL_INCLUDEDIR}/* ${INSTALL_SYSCONFDIR}/openldap/ldap.conf*"
OPENLDAP_LIB_FILES+=" ${INSTALL_SHAREDIR}/man/man3/* ${INSTALL_SHAREDIR}/man/man5/ldap.conf.5 ${INSTALL_SHAREDIR}/man/man5/ldif.5"
OPENLDAP_CLIENT_FILES="${INSTALL_EXECPREFIX}/bin/ldap* ${INSTALL_SHAREDIR}/man/man1/ldap*"
### Configure flags shared with the targets (variants/target/)
OPENLDAP_COMMON_FLAGS="--enable-dynamic --enable-versioning=yes --disable-debug --with-tls=openssl --with-yielding_select=yes"

### The full build, with slapd and its modules
PKG_DEPS="lfs/openssl lfs/cyrus-sasl"
CONF_FLAGS="${OPENLDAP_COMMON_FLAGS}"
CONF_FLAGS+=" --with-cyrus-sasl"
CONF_FLAGS+=" --enable-crypt"
CONF_FLAGS+=" --enable-spasswd"
CONF_FLAGS+=" --enable-slapd"
CONF_FLAGS+=" --enable-modules"
CONF_FLAGS+=" --enable-rlookups"
CONF_FLAGS+=" --enable-backends=mod"
CONF_FLAGS+=" --disable-sql"
CONF_FLAGS+=" --disable-wt"
CONF_FLAGS+=" --enable-overlays=mod"
#PKG_MAKETARGETS="all,install"
