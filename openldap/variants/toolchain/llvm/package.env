# openldap, toolchain llvm
PKG_CFLAGS="-Wno-int-conversion -Wno-deprecated-non-prototype"
### --undefined-version: libldap.map names the ldap_dump_* of a build with --enable-debug and the
### ldap_int_sasl_* of one with cyrus-sasl, and neither target builds both. GNU ld passes over an
### assignment to a symbol it does not have, lld makes it an error since 17
PKG_LDFLAGS="-Wl,--undefined-version"
