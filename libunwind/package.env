# libunwind
PKG_VER=1.8.3
### Savannah stops at 1.6.2; the releases moved to GitHub
PKG_URL="https://github.com/libunwind/libunwind/releases/download/v${PKG_VER}/libunwind-${PKG_VER}.tar.gz"
PKG_DEPS="lfs/libXt lfs/libXext lfs/libX11"
BUILD_PROCESS=configmake
PKG_AUTOCONF=1
### "make all" builds the test programs too and tests/Gtest-nomalloc.c does not compile as C23
### (gcc 16 default: "too many arguments to function 'func'"); they never run in a cross build
CONF_FLAGS="--disable-tests --disable-documentation"
PKG_MAKETARGETS="all,install-strip"
