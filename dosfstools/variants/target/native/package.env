# dosfstools, target native: mkfs.vfat and fsck.vfat of the build machine, with which create_image and
# mount_tag (images.functions) make and check the FAT boot partition of an image
### mkfs.fat has no --version and prints it only on a device: the version string of the program
PKG_CHECK="[ -x ${INSTALL_EXECPREFIX}/sbin/mkfs.vfat ] && grep -qaF '${PKG_VER}' ${INSTALL_EXECPREFIX}/sbin/mkfs.fat"
### Built by the gnu toolchain: an image can be made before llvm is there
PKG_TOOLCHAIN=gnu
