# pkgconf
PKG_VER=3.0.7
PKG_URL="https://github.com/pkgconf/pkgconf/archive/refs/tags/pkgconf-${PKG_VER}.tar.gz"
PKG_AUTOCONF=1
BUILD_PROCESS=configmake
PKG_MAKETARGETS="all,install-strip"

### The system directories, whose -I and -L flags pkgconf leaves out of --cflags and --libs: pkgconf
### calls the options --with-system-includedir and --with-system-libdir (the -path spellings are the
### pkg-config ones, which configure ignores and replaces with includedir and libdir)
CONF_FLAGS="--with-pkg-config-dir=${INSTALL_LIBDIR}${INSTALL_LIBSUFFIX}/pkgconfig:${INSTALL_PREFIX}/share/pkgconfig \
	--with-system-includedir=${INSTALL_INCLUDEDIR} \
	--with-system-libdir=${INSTALL_LIBDIR}${INSTALL_LIBSUFFIX}"
