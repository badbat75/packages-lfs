# pkgconf, target cross
### The system directories are the ones of the sysroot, as pkgconf sees them after prepending
### PKG_CONFIG_SYSROOT_DIR: the compiler finds them through --sysroot, and a -L or -I of the sysroot
### that a build copies from pkg-config into its own files (libkmod.pc, krb5-config, xsltConf.sh...)
### or turns into a run time path (sudo) carries a host path into the image
CONF_FLAGS="--program-prefix=${HARCH}- \
	--with-pkg-config-dir=${BIN_PATH}${TARGET_LIBDIR}${TARGET_LIBSUFFIX}/pkgconfig:${BIN_PATH}${TARGET_PREFIX}/share/pkgconfig \
	--with-system-includedir=${BIN_PATH}${TARGET_INCLUDEDIR} \
	--with-system-libdir=${BIN_PATH}${TARGET_LIBDIR}${TARGET_LIBSUFFIX}"
### The system library directory is part of the check: a toolchain built with the ignored -path
### spellings of the options rebuilds
PKG_CHECK="[ x\$( ${INSTALL_EXECPREFIX}/bin/${HARCH}-pkgconf --version ) == x${PKG_VER} ] && \
	[ x\$( ${INSTALL_EXECPREFIX}/bin/${HARCH}-pkgconf --variable=pc_system_libdirs pkg-config ) == x${BIN_PATH}${TARGET_LIBDIR}${TARGET_LIBSUFFIX} ]"
