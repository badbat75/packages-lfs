# pkgconf, target native
### The system directories are the ones of the host compiler (the -path spellings of the options,
### which configure ignored, left the directories of the global toolchain in their place)
CONF_FLAGS="--with-pkg-config-dir=${LIBRARY_PATH_FOR_BUILD}/pkgconfig:${INSTALL_PREFIX}/share/pkgconfig \
	--with-system-includedir=${INCLUDE_PATH_FOR_BUILD} \
	--with-system-libdir=${LIBRARY_PATH_FOR_BUILD}"
PKG_CHECK="[ x\$( ${INSTALL_EXECPREFIX}/bin/pkgconf --version ) == x${PKG_VER} ]"
