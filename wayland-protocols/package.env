# wayland-protocols
PKG_VER=1.49
PKG_URL="https://gitlab.freedesktop.org/wayland/wayland-protocols/-/releases/${PKG_VER}/downloads/wayland-protocols-${PKG_VER}.tar.xz"
### The wayland-scanner is a dependency of the build machine (native: true): the one of
### lfs/wayland:cross, whose pc file has to win over the one of the sysroot, a program of the target
### (on a host of the same architecture it runs natively, without the libraries of the sysroot)
PKG_DEPS="lfs/wayland lfs/wayland:cross"
BUILD_PROCESS=mesonninja
CONF_FLAGS="-Dtests=false"
CONF_FLAGS+=" -Dbuild.pkg_config_path=${TOOLCHAIN_PATH}/lib/pkgconfig"
#PKG_MAKETARGETS="all,install"
