# flex, target native
### flex runs m4 and records its path: the one of lfs/m4:native, not of the build host. A flex built
### with another one fails the check and is built again
PKG_DEPS+=" lfs/m4:native"
CONF_VARS+=" M4=${GLOBAL_TOOLCHAIN_PATH}/bin/m4"
PKG_CHECK="[ x$(${GLOBAL_TOOLCHAIN_PATH}/bin/flex --version 2>/dev/null | awk '{print $2}' || : ) == x${PKG_VER} ] && grep -qa '${GLOBAL_TOOLCHAIN_PATH}/bin/m4' ${GLOBAL_TOOLCHAIN_PATH}/bin/flex"
### Built by the gnu toolchain: the toolchain steps need it before llvm is there
PKG_TOOLCHAIN=gnu
