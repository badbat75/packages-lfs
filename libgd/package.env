# libgd: the GD graphics library
### A library of the build machine (lfs/libgd:native): the gd plugin of the dot of lfs/graphviz:native,
### its PNG renderer. PNG only, without FreeType and fontconfig: the text is drawn with the built-in
### fonts of gd, so the build machine needs no font files
PKG_VER=2.3.3
PKG_URL="https://github.com/libgd/libgd/releases/download/gd-${PKG_VER}/libgd-${PKG_VER}.tar.xz"
PKG_DEPS="lfs/libpng lfs/zlib"
BUILD_PROCESS=configmake
CONF_FLAGS="--with-png --with-zlib --without-freetype --without-fontconfig --without-jpeg --without-tiff \
	--without-webp --without-xpm --without-x --without-avif --without-heif --without-liq --without-raqm"
PKG_MAKETARGETS="all,install-strip"
