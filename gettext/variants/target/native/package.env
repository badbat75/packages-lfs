# gettext, target native: the gettext tools of the build machine (autopoint, which smart_autoreconf runs,
# msgfmt, xgettext)
### Not the default build: the values of package.env this target keeps or drops
PKG_DEPS="lfs/expat lfs/autoconf lfs/automake lfs/libtool"
### "autopoint --version" prints "<path of autopoint> (GNU gettext-tools) <version>"
PKG_CHECK="${INSTALL_EXECPREFIX}/bin/autopoint --version 2>/dev/null | head -n1 | grep -q ' (GNU gettext-tools) ${PKG_VER}\$'"
