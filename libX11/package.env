# libX11
PKG_VER=1.8.13
PKG_URL="https://www.x.org/archive/individual/lib/libX11-${PKG_VER}.tar.xz"
BUILD_PROCESS=configmake
PKG_AUTOCONF=1
CONF_FLAGS="--disable-malloc0returnsnull"
### makekeys reads the keysym headers of xorgproto at build time: configure takes their directory from
### includedir of xproto.pc, the image path under the FDO sysroot rules (single quotes: expanded when
### runconfig.sh runs)
CONF_FLAGS+=' --with-keysymdefdir=${PKG_CONFIG_SYSROOT_DIR}${INSTALL_INCLUDEDIR}/X11'
PKG_MAKETARGETS="all,install-strip"

PKG_DEPS="lfs/xmlto:native"
PKG_DEPS+=" lfs/libxcb"
PKG_DEPS+=" lfs/xtrans lfs/fontconfig"
