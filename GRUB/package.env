# GRUB
PKG_VER=2.14
PKG_URL="https://ftp.gnu.org/gnu/grub/grub-${PKG_VER}.tar.xz"
PKG_DEPS="lfs/FreeType fonts/unifont lfs/FreeType:cross"
### The manual pages of the tools, made by help2man when configure can run a program it builds (a
### platform of the same machine): help2man runs the tools of the target, through <HARCH>-run
### (files/help2man_target), not with the libraries of the build host
PKG_DEPS+=" lfs/help2man:native"
PKG_MAKEVARS="HELP2MAN=\"sh ${PKG_RECIPEPATH}/files/help2man_target ${GLOBAL_TOOLCHAIN_PATH}/bin/help2man ${HARCH}-run\""
BUILD_PROCESS=configmake
STD_CONF_FLAGS=0
CONF_ENV='env -u CFLAGS TARGET_CC="${CC}" TARGET_OBJCOPY="${OBJCOPY}" TARGET_STRIP="${STRIP}"'
CONF_FLAGS="--prefix=${INSTALL_PREFIX}"
CONF_FLAGS+=" --sysconfdir=${INSTALL_SYSCONFDIR}"
CONF_FLAGS+=" --disable-efiemu"
CONF_FLAGS+=" --enable-grub-mkfont"
CONF_FLAGS+=" --target=${HM}"
CONF_FLAGS+=" --disable-werror"
PKG_MAKETARGETS=",install"
PKG_TOOLCHAIN=gnu
PKG_OVERRIDELD=bfd
PKG_LDFLAGS="-Wl,-rpath-link=${BIN_PATH}${INSTALL_LIBDIR}${INSTALL_LIBSUFFIX}"
### The font of the menu, unicode.pf2, made at build time by a grub-mkfont of the build machine from the
### unifont of the sysroot (configure looks for it among the fonts of the host). That grub-mkfont links
### the FreeType of the build machine, lfs/FreeType:cross, which configure asks BUILD_PKG_CONFIG for:
### the pkg-config of the target would give it the FreeType of the sysroot. Expanded when runconfig.sh
### runs (single quotes)
CONF_ENV+=' BUILD_PKG_CONFIG="env PKG_CONFIG_LIBDIR=${TOOLCHAIN_PATH}/lib/pkgconfig PKG_CONFIG_SYSROOT_DIR= PKG_CONFIG_FDO_SYSROOT_RULES= pkg-config"'
CONF_FLAGS+=' --with-unifont=${SYSROOT}${INSTALL_SHAREDIR}/fonts/unifont/unifont.pcf'
### The tools of the build machine that make the fonts (grub-gen-asciih, grub-gen-widthspec) link with a
### -Wall -Werror of Makefile.am, and at the LTO link gcc compiles again the bytecode of the static
### lfs/FreeType:cross, whose afglobal.c it warns about (a memset of af_face_globals_new): only a warning
CONF_ENV+=' BUILD_CFLAGS="-Wno-error=stringop-overflow"'
