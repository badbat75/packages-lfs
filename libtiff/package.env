# libtiff
PKG_VER=4.7.2
PKG_URL="https://download.osgeo.org/libtiff/tiff-${PKG_VER}.tar.gz"
BUILD_PROCESS=configmake
### The shipped configure is used: regenerating it takes AX_CHECK_GL from the autoconf-archive of the
### toolchain (the tarball has no m4/ax_check_gl.m4), which autoconf 2.73 rejects
### ("_AX_CHECK_GL_MANUAL_LIBS_GENERIC: argument must not be empty")
CONF_FLAGS="--with-docdir=${INSTALL_SHAREDIR}/doc/libtiff-${PKG_VER}"
#PKG_MAKETARGETS="all,install-strip"

PKG_DEPS="lfs/Freeglut"
PKG_DEPS+=" lfs/libjpeg-turbo"
PKG_DEPS+=" lfs/libwebp"
#PKG_DEPS+=" lfs/JBIG-KIT"
#PKG_DEPS+=" lfs/LERC"
