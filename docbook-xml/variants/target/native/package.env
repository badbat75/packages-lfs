# docbook-xml, target native: installed once into the global toolchain
PKG_CHECK="[ \"\$( ${GLOBAL_TOOLCHAIN_PATH}/bin/xmlcatalog ${INSTALL_SYSCONFDIR}/xml/catalog http://www.oasis-open.org/docbook/xml/4.1.2/docbookx.dtd 2>/dev/null )\" == \"file://${INSTALL_SHAREDIR}/xml/docbook/xml-dtd-${PKG_VER}/docbookx.dtd\" ] && [ -f ${INSTALL_SHAREDIR}/xml/docbook/xml-dtd-${PKG_VER}/docbookx.dtd ]"
