# bison, target native or cross
### bison runs m4 and records its path: the one of lfs/m4:native, not of the build host. A bison built
### with another one fails the check and is built again
PKG_DEPS+=" lfs/m4:native"
CONF_VARS+=" M4=${GLOBAL_TOOLCHAIN_PATH}/bin/m4"
PKG_CHECK="[ x\$( ${INSTALL_EXECPREFIX}/bin/bison -V | awk 'NR==1{print \$4}' || true ) == x${PKG_VER} ] && grep -qa '${GLOBAL_TOOLCHAIN_PATH}/bin/m4' ${INSTALL_EXECPREFIX}/bin/bison"
### Built by the gnu toolchain: the toolchain steps need it before llvm is there
PKG_TOOLCHAIN=gnu
