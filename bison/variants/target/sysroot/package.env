# bison, target sysroot
### The m4 bison runs in the image, /usr/bin/m4 of lfs/m4, goes into config.h without configure looking
### for it (ac_cv_path_M4). The build runs the m4 of lfs/m4:native through the M4 the program reads
### first; the command line of make too, whose Makefile has M4 = the path of the image and would
### export that one
PKG_DEPS+=" lfs/m4 lfs/m4:native"
CONF_VARS+=" ac_cv_path_M4=${INSTALL_EXECPREFIX}/bin/m4"
PKG_MAKEENV+=" M4=${GLOBAL_TOOLCHAIN_PATH}/bin/m4"
PKG_MAKEVARS+=" M4=${GLOBAL_TOOLCHAIN_PATH}/bin/m4"
