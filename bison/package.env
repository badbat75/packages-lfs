# bison
PKG_VER=3.8.2
PKG_URL="https://ftp.gnu.org/gnu/bison/bison-${PKG_VER}.tar.xz"
BUILD_PROCESS=configmake
PKG_AUTOCONF=1
CONF_FLAGS="--docdir=${INSTALL_SHAREDIR}/doc/bison-${PKG_VER}"
PKG_MAKETARGETS="all,install-strip"
### liby.a is a static-only library of the package: with LTO it must be built as fat objects, or the
### bytecode-only archive stops the build
PKG_OVERRIDESTATIC=1
