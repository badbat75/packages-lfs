# pcsc-lite
PKG_VER=2.5.1
PKG_URL="https://pcsclite.apdu.fr/files/pcsc-lite-${PKG_VER}.tar.xz"
### Since 2.0 pcsc-lite builds with meson only (no configure): the old --disable-usb,
### --enable-usbdropdir and --with-systemdsystemunitdir flags are meson options, the systemd unit
### directory comes from systemd.pc (-Dlibsystemd=true, -Dsystemdunit=system)
PKG_DEPS="lfs/flex:native lfs/systemd"
BUILD_PROCESS=mesonninja
CONF_FLAGS="-Dusb=false -Dlibudev=false -Dlibusb=false -Dserial=true"
CONF_FLAGS+=" -Dlibsystemd=true -Dsystemdunit=system -Dpolkit=false"
CONF_FLAGS+=" -Dusbdropdir=${INSTALL_LIBDIR}/pcsc/drivers -Dipcdir=/run/pcscd"
