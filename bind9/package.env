# bind9
### 9.21 is the development branch that becomes the 9.22 stable series: it builds with meson only
### (since 9.21.4), LMDB is mandatory, libedit replaced readline and sd_notify needs no libsystemd
PKG_VER=9.21.26
PKG_URL="https://downloads.isc.org/isc/bind9/${PKG_VER}/bind-${PKG_VER}.tar.xz"
PKG_DEPS="lfs/libuv lfs/openssl lfs/liburcu lfs/lmdb lfs/libcap2:bootstrap"
PKG_DEPS+=" lfs/zlib lfs/libedit lfs/libxml2:bootstrap lfs/json-c lfs/libnghttp2 lfs/libidn2"
PKG_DEPS+=" lfs/krb5:bootstrap"
BUILD_PROCESS=mesonninja
### meson.build refuses -Db_lto: the LTO of bind is its own named-lto option (named linked statically
### from fat LTO objects, the libraries left alone). Left to auto it is on whatever the project
### says, so LTOENABLE drives it and the LTO of the framework (b_lto, -flto in CFLAGS) stays out
PKG_OVERRIDELTO=0
case ${LTOENABLE:-0} in
	1|fat)	CONF_FLAGS="-Dnamed-lto=full" ;;
	2|thin)	CONF_FLAGS="-Dnamed-lto=thin" ;;
	*)		CONF_FLAGS="-Dnamed-lto=disabled" ;;
esac
### Every feature is decided here, none by what the sysroot happens to hold. The manual pages come
### ready made with the archive (doc=auto rebuilds them only when the host has sphinx-build)
CONF_FLAGS+=" -Ddoh=enabled -Dgssapi=enabled -Didn=enabled -Dline=enabled"
CONF_FLAGS+=" -Dstats-json=enabled -Dstats-xml=enabled -Dzlib=enabled"
CONF_FLAGS+=" -Ddnstap=disabled -Dgeoip=disabled -Djemalloc=disabled -Dtracing=disabled"
CONF_FLAGS+=" -Dcmocka=disabled -Dfuzzing=disabled"
### The -Db_ndebug=true of the framework is a build upstream never does: <assert.h> comes in
### through urcu/assert.h, not with NDEBUG, and static_assert is undeclared (lib/isccfg/parser.c)
CONF_FLAGS+=" -Db_ndebug=false"
### GSSAPI is found through krb5-config only: the one of the sysroot, named in a second cross file
### (prebuild.sh) that meson merges with the one of the framework. Like that one it is in the build
### directory, where meson runs, and goes by its name: named -V shows the options of meson
CONF_FLAGS+=" --cross-file bbxb-krb5.ini"
