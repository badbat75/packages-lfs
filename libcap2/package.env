# libcap2
PKG_VER=2.78
PKG_URL="https://www.kernel.org/pub/linux/libs/security/linux-privs/libcap2/libcap-${PKG_VER}.tar.xz"
BUILD_PROCESS=simplemake
### Make.Rules composes LIBDIR as exec_prefix/lib: with prefix set, exec_prefix is the prefix and
### lib is the directory below it (an absolute lib wrote libdir=//usr/lib/... into libcap.pc)
PKG_MAKEVARS="prefix=${INSTALL_PREFIX} lib=${INSTALL_LIBDIR#${INSTALL_EXECPREFIX}/}${INSTALL_LIBSUFFIX}"
PKG_MAKEVARS+=" BUILD_CC=\"\${CC_FOR_BUILD}\" COPTS=\"\${CFLAGS_FOR_BUILD}\" BUILD_LDFLAGS=\"\${LDFLAGS_FOR_BUILD}\""
PKG_MAKETARGETS="all,install"

PKG_DEPS="lfs/libcap2:bootstrap lfs/Linux-PAM"
PKG_MAKETARGETS+=",-C pam_cap"
