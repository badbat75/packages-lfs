# dracut
PKG_VER=112
### dracut-ng is the maintained continuation of dracut (dracutdevs stopped at 059)
PKG_URL="https://github.com/dracut-ng/dracut-ng/archive/refs/tags/${PKG_VER}.tar.gz"
PKG_DEPS="lfs/systemd lfs/kmod lfs/cpio lfs/bash lfs/gzip lfs/bzip2 lfs/xz lfs/lz4 lfs/zstd lfs/coreutils lfs/util-linux lfs/sed"
### grep in the initramfs: the devexists hook of the root (parse-root.sh of dracut-systemd) runs it, and
### dracut takes it from the sysroot, where it has to be before the kernel makes the initramfs
PKG_DEPS+=" lfs/grep"
### The tools of the manual pages
PKG_DEPS+=" python/asciidoc:native lfs/libxslt:native lfs/docbook-xsl:native"
PKG_COPYSRC=1
BUILD_PROCESS=custom
PKG_LDFLAGS="-s"
