[Unit]
Description=Make the initramfs of this machine (dracut --hostonly), the generic one kept for rescue
Documentation=man:dracut(8)
### At every boot, after the root and /boot are mounted: a check of the stamps when nothing changed,
### a new initramfs after the first boot and after every kernel package installed
After=local-fs.target systemd-udev-trigger.service
RequiresMountsFor=/boot /var/lib

[Service]
Type=oneshot
ExecStart=/usr/libexec/dracut/dracut-hostonly.sh
Nice=19
IOSchedulingClass=idle

[Install]
WantedBy=multi-user.target
