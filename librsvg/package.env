# librsvg
PKG_VER=2.63.0
PKG_URL="https://download.gnome.org/sources/librsvg/$(echo "${PKG_VER}" | cut -d. -f1,2)/librsvg-${PKG_VER}.tar.xz"
PKG_DEPS="lfs/Cairo:bootstrap"
PKG_DEPS+=" lfs/gdk-pixbuf"
PKG_DEPS+=" lfs/Pango"
PKG_DEPS+=" lfs/gobject-introspection"
#PKG_DEPS+=" lfs/Vala"
PKG_DEPS+=" lfs/HarfBuzz"
PKG_DEPS+=" lfs/libxml2"
PKG_DEPS+=" lfs/GLib"
### Since 2.59 librsvg builds with meson only, driving cargo through cargo-cbuild (lfs/cargo-c:native);
### the Rust target of the cross build is CARGO_TARGET of environment.source (single quotes: expanded
### when runconfig.sh runs)
PKG_DEPS+=" lfs/cargo-c:native"
BUILD_PROCESS=mesonninja
CONF_FLAGS='-Dtriplet=${CARGO_TARGET}'
CONF_FLAGS+=" -Dintrospection=enabled -Dpixbuf=enabled"
### The gdk-pixbuf SVG loader. Its crate looks librsvg up through the uninstalled pc file of the build
### dir, whose -L path pkgconf prepends with the sysroot: system-deps is told where the library is
### instead (single quotes: expanded when runmake.sh runs). meson installs the loader into the sysroot
### path of gdk_pixbuf_moduledir, moved back by postbuild.sh; loaders.cache is written in the image
### by the post-install script of lfs/gdk-pixbuf
CONF_FLAGS+=" -Dpixbuf-loader=enabled"
PKG_MAKEENV='SYSTEM_DEPS_LIBRSVG_NO_PKG_CONFIG=1 SYSTEM_DEPS_LIBRSVG_SEARCH_NATIVE=${PKG_BLDPATH}/rsvg SYSTEM_DEPS_LIBRSVG_LIB=rsvg-2'
CONF_FLAGS+=" -Dvala=disabled -Ddocs=disabled -Dtests=false -Davif=disabled"
