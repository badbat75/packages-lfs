# elfutils, target cross or native
### Not the default build: the values of package.env this target keeps or drops
### zlib (required) of the toolchain of the build (lfs/zlib:cross or :native), not of the build host,
### and no other compression: libelf of the kernel builds reads uncompressed objects
PKG_DEPS="lfs/bison:native lfs/flex:native lfs/zlib"
CONF_FLAGS+=" --without-bzlib --without-lzma --without-zstd"
PKG_MAKEVARS=
