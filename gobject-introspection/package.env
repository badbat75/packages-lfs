# gobject-introspection
PKG_VER=1.86.0
PKG_URL="https://download.gnome.org/sources/gobject-introspection/$(echo ${PKG_VER} | cut -d. -f1,2)/gobject-introspection-${PKG_VER}.tar.xz"
BUILD_PROCESS=mesonninja
PKG_DEPS="lfs/bison:native lfs/flex:native"

PKG_DEPS=" lfs/GLib:bootstrap lfs/gobject-introspection:cross lfs/pcre2"
CONF_FLAGS="-Dpython=cross-python3 -Dgi_cross_use_prebuilt_gi=true"
### The programs of the target the build runs, the introspection dumpers of the GIRs of GLib and the
### g-ir-compiler just built (the typelibs): through <HARCH>-run
CONF_FLAGS+=" -Dgi_cross_binary_wrapper=${HARCH}-run"
### libdir and includedir of GLib, which pkgconf leaves unprefixed under the FDO sysroot rules, are
### files gir/meson.build reads: it prepends this option (single quotes: expanded when runconfig.sh runs)
CONF_FLAGS+=' -Dgi_cross_pkgconfig_sysroot_path=${PKG_CONFIG_SYSROOT_DIR}'
