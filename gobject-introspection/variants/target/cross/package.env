# gobject-introspection, target cross
### Not the default build: the values of package.env this target keeps or drops
### patchelf: postbuild.sh sets the RUNPATH of the programs and of the scanner module
PKG_DEPS="lfs/bison:native lfs/flex:native lfs/patchelf:native"

### libffi of the platform toolchain, not the one of the build host
PKG_DEPS+=" lfs/GLib:cross lfs/libffi:cross"
CONF_FLAGS="-Dpython=python3"
