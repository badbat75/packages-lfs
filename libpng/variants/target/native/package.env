# libpng, target native: the PNG of the programs of the build machine (the libgd of lfs/libgd:native,
# which the dot of lfs/graphviz:native writes PNG with)
### pnglibconf.out runs the preprocessor with CPPFLAGS alone: the zlib.h of the global toolchain
PKG_CPPFLAGS="-isystem ${INSTALL_INCLUDEDIR}"
PKG_CHECK="grep -qx 'Version: ${PKG_VER}' ${INSTALL_LIBDIR}/pkgconfig/libpng.pc"
