# zlib
PKG_VER=1.3.2
PKG_URL="https://github.com/madler/zlib/releases/download/v${PKG_VER}/zlib-${PKG_VER}.tar.xz"
BUILD_PROCESS=cmakebuild
### Since 1.3.2 the install directories are the GNUInstallDirs ones and zlib.pc.cmakein prefixes
### them with ${exec_prefix}/: they must be relative to the prefix (/usr//usr/include otherwise)
### The tests are the examples and infcover, which a cross build never runs; infcover also compiles
### and links with -coverage, so it asks the compiler for its profile runtime
CONF_FLAGS="-DZLIB_BUILD_TESTING:BOOL=OFF"
CONF_FLAGS+=" -DCMAKE_INSTALL_INCLUDEDIR=${INSTALL_INCLUDEDIR#"${INSTALL_PREFIX}"/}"
CONF_FLAGS+=" -DCMAKE_INSTALL_LIBDIR=${INSTALL_LIBDIR#"${INSTALL_EXECPREFIX}"/}${INSTALL_LIBSUFFIX}"
PKG_CXXFLAGS="-D_FILE_OFFSET_BITS=64"
PKG_MAKETARGETS="all,install/strip"
