# zlib, target native: the zlib of the programs of the build machine (the native Python and LLVM of
# setup_full_toolchain, lfs/btrfs-progs:native), instead of the one of the build host
PKG_CHECK="grep -qx 'Version: ${PKG_VER}' ${INSTALL_LIBDIR}/pkgconfig/zlib.pc"
### Built by the gnu toolchain: an image can be made before llvm is there
PKG_TOOLCHAIN=gnu
