# python3, target crossenv: the cross environment of the platform, ${TOOLCHAIN_PATH}/venv-${HARCH}: crossenv
# of the native Python over the python of the image (PYTHON_FOR_TARGET, which setup_python sets: the one
# of lfs/python3, or of the image of a distribution), activated by every target build (cross-python,
# cross-pip, build-python, the python3-config of the image). Made in postbuild.sh; nothing goes into the
# sysroot
### Not the default build: the values of package.env this target keeps or drops
### No sources: crossenv works on the installed pythons
PKG_URL=
PKG_DEPS="lfs/python3:native"
BUILD_PROCESS=none
### The last step of postbuild.sh: the PYTHONPATH of the site-packages of the sysroot in cross-python3
PKG_CHECK="grep -q '^PYTHONPATH=' ${TOOLCHAIN_PATH}/venv-${HARCH}/bin/cross-python3"
