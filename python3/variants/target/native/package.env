# python3, target native: the Python of the global toolchain, in its own directory
# ${GLOBAL_TOOLCHAIN_PATH}/python-<version> (setup_python puts its bin in the PATH): the python of the
# builds (PYTHON_FOR_BUILD, meson, pythonbuild), the build python of the cross build and of crossenv
### Not the default build: the values of package.env this target keeps or drops
INSTALL_PREFIX=${GLOBAL_TOOLCHAIN_PATH}/python-${PKG_VER}
INSTALL_EXECPREFIX=${INSTALL_PREFIX}
INSTALL_LIBDIR=${INSTALL_PREFIX}/lib
INSTALL_INCLUDEDIR=${INSTALL_PREFIX}/include
INSTALL_SYSCONFDIR=${INSTALL_PREFIX}/etc
INSTALL_SHAREDIR=${INSTALL_PREFIX}/share
### The libraries of its extension modules are the ones of the global toolchain, not the ones of the
### build host, through the RUNPATH of the native builds: openssl (with the CA certificates of
### lfs/ca-bundle:native in its OPENSSLDIR), libffi, libuuid, zlib, libbz2, liblzma, libzstd. No Tk:
### no _tkinter, which no build uses
PKG_DEPS="lfs/openssl lfs/ca-bundle lfs/libffi lfs/util-linux lfs/zlib lfs/bzip2 lfs/xz lfs/zstd"
CONF_VARS=
CONF_FLAGS="--enable-shared --with-system-ffi --with-ensurepip=yes --disable-test-modules --with-lto --enable-ipv6"
CONF_FLAGS+=" --with-openssl=${GLOBAL_TOOLCHAIN_PATH} --with-openssl-rpath=${GLOBAL_TOOLCHAIN_PATH}/lib"
### libpython of its own lib
PKG_LDFLAGS="-Wl,-rpath,${INSTALL_LIBDIR}"
### The version, the modules whose library is in the global toolchain (_ssl through its RUNPATH), and
### the modules postbuild.sh installs: one that is not all of this is built again
PKG_CHECK="${INSTALL_EXECPREFIX}/bin/python3 -c \"import sys, _ssl, zlib, bz2, lzma, ctypes, uuid, compression.zstd, jinja2, docutils, crossenv; sys.exit(sys.version.split()[0] != '${PKG_VER}' or b'${GLOBAL_TOOLCHAIN_PATH}/lib' not in open(_ssl.__file__, 'rb').read())\" > /dev/null 2>&1"
