# python3
PKG_VER=${PYTHON_VER}
PKG_URL="https://www.python.org/ftp/python/${PKG_VER}/Python-${PKG_VER}.tar.xz"
PKG_AUTOCONF=1
BUILD_PROCESS=configmake
### configure must not see the PYTHON_FOR_BUILD of the framework (its Makefile defines its own); since
### 3.11 a cross build names the build interpreter explicitly: the native python of setup_python
CONF_ENV="env -u PYTHON_FOR_BUILD"
CONF_FLAGS="--with-build-python=${GLOBAL_TOOLCHAIN_PATH}/python-${PYTHON_VER}/bin/python3"
CONF_FLAGS+=" --with-platlibdir=lib --with-system-expat --with-system-libmpdec --enable-ipv6 --with-ensurepip=yes --disable-test-modules"
if [ "${LTOENABLE:-0}" != "0" ]
then
	CONF_FLAGS+=" --with-lto"
fi
PKG_LDFLAGS="-s"
PKG_MAKETARGETS=",install"
### OpenSSL 4 removed the TLSv1.x methods that the deprecated PROTOCOL_TLSv1x paths of _ssl call, and its
### headers no longer define the macros of the CPython guards: define them here, the contexts fall back
### to TLS_method
PKG_CFLAGS+=" -DOPENSSL_NO_SSL3 -DOPENSSL_NO_SSL3_METHOD"
PKG_CFLAGS+=" -DOPENSSL_NO_TLS1 -DOPENSSL_NO_TLS1_METHOD"
PKG_CFLAGS+=" -DOPENSSL_NO_TLS1_1 -DOPENSSL_NO_TLS1_1_METHOD"
PKG_CFLAGS+=" -DOPENSSL_NO_TLS1_2 -DOPENSSL_NO_TLS1_2_METHOD"
### LIBDEST keeps the default: the standard library must sit where getpath looks for it
### (${INSTALL_EXECPREFIX}/lib/python${VERSION}); only third-party modules go to site-packages
PKG_OVERRIDELTO=0
PKG_FAULTYCFLAGS=1

PKG_DISABLECROSSPYTHON=1
### Module directory inside the package, used by postbuild.sh as ${PKG_PKGPATH}${PYTHON_MODPATH}
PYTHON_MODPATH=${INSTALL_EXECPREFIX}/lib/python$(echo "${PKG_VER}" | cut -d. -f1,2)/site-packages

PKG_DEPS="lfs/ncurses"
PKG_DEPS+=" lfs/zlib"
PKG_DEPS+=" lfs/bzip2"
PKG_DEPS+=" lfs/expat"
PKG_DEPS+=" lfs/libffi"
PKG_DEPS+=" lfs/libmpdec"
PKG_DEPS+=" lfs/gdbm"
PKG_DEPS+=" lfs/readline"
PKG_DEPS+=" lfs/openssl"
PKG_DEPS+=" lfs/SQLite"
PKG_DEPS+=" lfs/BerkeleyDB"
PKG_DEPS+=" lfs/libnsl"
PKG_DEPS+=" lfs/Tk:bootstrap"
CONF_VARS="CROSS_COMPILE=${HARCH}- CROSS_COMPILE_TARGET=yes \
	ax_cv_c_float_words_bigendian=$([ ${HMENDIAN} != little ] && echo yes || echo no) \
	ac_cv_file__dev_ptmx=yes ac_cv_file__dev_ptc=no"
