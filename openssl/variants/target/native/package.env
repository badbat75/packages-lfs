# openssl, target native: only checks the installed version, no target dependencies (the native perl only), host Configure target
### The CA certificates in its OPENSSLDIR (cert.pem)
PKG_DEPS="lfs/perl5 lfs/ca-bundle"
OPENSSL_TARGET=
### No zlib: the zlib of the global toolchain is a cmake build, and cmake links this openssl (TLS
### compression, which no native program uses)
CONF_FLAGS="${CONF_FLAGS/zlib-dynamic/no-zlib}"
### The libraries in lib, where the RUNPATH of the native builds looks, not in lib64 on a 64 bit platform
PKG_MAKEVARS="MANSUFFIX=ssl LIBDIR=lib"
PKG_CHECK="[ x$(${GLOBAL_TOOLCHAIN_PATH}/bin/openssl -v 2>/dev/null | awk '{print $2}' || : ) == x${PKG_VER} ]"
