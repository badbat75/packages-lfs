# openssl
PKG_VER=4.0.2
PKG_URL="https://www.openssl.org/source/openssl-${PKG_VER}.tar.gz"
### The Makefile of openssl 4 runs perl with Time::Piece, a core module the perl of the host may
### lack (Fedora packages it apart): Configure and make run the native perl, the first of the PATH
### of the builds, which has every core module. PERL is left unset on purpose: it would also become
### the hashbang of the installed scripts
PKG_DEPS="lfs/zlib lfs/perl5:native"
CONF_CMD="Configure"
STD_CONF_FLAGS=0
### The Configure target of the platform: overridden by variants/target/sysroot/arch/ (arm) and
### emptied by the native build; expanded when runconfig.sh runs (single quotes)
OPENSSL_TARGET=${HOS}-${HM}
CONF_FLAGS="--prefix=${INSTALL_PREFIX} --openssldir=${INSTALL_SYSCONFDIR}/ssl shared zlib-dynamic no-tests"
CONF_FLAGS+=' ${OPENSSL_TARGET}'
CONF_VARS="-DDEVRANDOM="'\"\\\"/dev/urandom\\\"\"'
BUILD_PROCESS=configmake
#PKG_MAKETARGETS="all,install"
PKG_MAKEVARS="MANSUFFIX=ssl LIBDIR=lib${HARCH_LIB}${INSTALL_LIBSUFFIX}"
