# bindgen-cli: bindgen, the Rust bindings of C headers
### A host tool (lfs/bindgen-cli:native): rusticl of Mesa generates its bindings with it, through the
### libclang of the global LLVM (LIBCLANG_PATH, setup_full_toolchain)
PKG_VER=0.73.2
PKG_URL="https://github.com/rust-lang/rust-bindgen/archive/refs/tags/v${PKG_VER}.tar.gz"
PKG_DEPS="lfs/rust:native"
BUILD_PROCESS=cargobuild
### The crate of the command line in the workspace of bindgen
CONF_FLAGS="-p bindgen-cli"
CARGO_BINLIST="bindgen"
PKG_OVERRIDELTO=thin
PKG_LDFLAGS=-s
