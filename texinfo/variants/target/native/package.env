# texinfo, target native: the makeinfo of the build machine (setup_full_toolchain), before binutils:
# the release branch patches of binutils and gcc touch .texi files, whose info pages make builds again,
# and every GNU package that finds it rebuilds its manual with it
PKG_CHECK="[ \"\$( ${INSTALL_EXECPREFIX}/bin/makeinfo --version 2>/dev/null | head -n1 )\" == \"texi2any (GNU texinfo) ${PKG_VER}\" ]"
### Built by the gnu toolchain: the toolchain steps need it before llvm is there
PKG_TOOLCHAIN=gnu
