# cpio
PKG_VER=2.15
PKG_URL="https://ftp.gnu.org/gnu/cpio/cpio-${PKG_VER}.tar.bz2"
PKG_DEPS="lfs/flex:native"
BUILD_PROCESS=configmake
PKG_AUTOCONF=1
CONF_FLAGS="--enable-mt --with-rmt=${INSTALL_EXECPREFIX}/libexec/rmt"
### xstat is declared "int (*xstat) ()": in C23 (the gcc 15+ default) the empty list means no
### parameters and the stat/lstat assignments and calls stop the build. Build as C17.
PKG_CFLAGS="-std=gnu17"
PKG_MAKETARGETS="all,install-strip"

if texi2dvi >/dev/null 2>&1
then
    PKG_MAKETARGETS+=",-C doc pdf,-C doc ps"
fi
