# perl5
PKG_VER=${PERL_VER}
PKG_PERL_LIBVER=$(echo ${PKG_VER} | cut -d. -f1,2)
### perl-cross release with a cnf/diffs patchset for this perl (1.6.5 covers 5.40.2 to 5.44.0)
PKG_PERLCROSS_VER=refs/tags/1.6.5
PKG_URL="https://www.cpan.org/src/5.0/perl-${PKG_VER}.tar.xz"
PKG_DEPS="lfs/gdbm lfs/expat"
BUILD_PROCESS=custom
PKG_FAULTYCFLAGS=1

PKG_TOOLCHAIN=gnu
