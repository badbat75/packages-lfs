# iptables
PKG_VER=1.8.9
PKG_URL="https://www.netfilter.org/projects/iptables/files/iptables-${PKG_VER}.tar.xz"
PKG_DEPS="lfs/libpcap"
#PKG_DEPS+=" lfs/bpf-utils"
#PKG_DEPS+=" lfs/libnfnetlink"
#PKG_DEPS+=" lfs/libnetfilter-conntrack"
#PKG_DEPS+=" lfs/nftables"
BUILD_PROCESS=configmake
CONF_FLAGS="--disable-nftables --enable-libipq"
PKG_MAKETARGETS="all,install-strip"

