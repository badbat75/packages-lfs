# libtool, target native: the libtool and libtoolize of the build machine, which smart_autoreconf runs for
# every PKG_AUTOCONF build (configmake)
### The version, and the flags of the compiler its ltmain.sh passes to the link (prebuild.sh)
PKG_CHECK="[ \"\$( ${INSTALL_EXECPREFIX}/bin/libtoolize --version 2>/dev/null | head -n1 )\" == \"libtoolize (GNU libtool) ${PKG_VER}\" ] && grep -q '^## BBXB change ##' ${INSTALL_SHAREDIR}/libtool/build-aux/ltmain.sh"
