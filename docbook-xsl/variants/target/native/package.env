# docbook-xsl, target native: installed once into the global toolchain
PKG_CHECK="[ \"\$( ${GLOBAL_TOOLCHAIN_PATH}/bin/xmlcatalog ${INSTALL_SYSCONFDIR}/xml/catalog http://docbook.sourceforge.net/release/xsl/current/manpages/docbook.xsl 2>/dev/null )\" == \"file://${INSTALL_SHAREDIR}/xml/docbook/xsl-stylesheets-nons-${PKG_VER}/manpages/docbook.xsl\" ] && [ -f ${INSTALL_SHAREDIR}/xml/docbook/xsl-stylesheets-nons-${PKG_VER}/manpages/docbook.xsl ]"
