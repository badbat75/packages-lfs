# binutils
PKG_VER=${BINUTILS_VER}
PKG_URL="https://ftp.gnu.org/gnu/binutils/binutils-${BINUTILS_VER}.tar.bz2"
PKG_DEPS="lfs/bison:native lfs/flex:native lfs/zlib lfs/libgmp lfs/libmpfr lfs/libmpc lfs/libisl"
### The release branch patch of every supported version lives in variants/version/<BINUTILS_VER>/patches/
### (utilities/update_patches writes them), for every target of this recipe. An unknown version builds
### unpatched.
BUILD_PROCESS=configmake
STD_CONF_FLAGS=0
### The features of every build
# Gprof broken with with glibc 2.40
### gprofng does not build against the _Generic string macros of recent glibc headers before 2.44;
### gold was removed in 2.45, ld.bfd is the default linker
BINUTILS_FEATURE_FLAGS="--disable-werror \
	--enable-shared --enable-static \
	--enable-ld=default --enable-gprofng=no --enable-lto \
	--enable-new-dtags --disable-rpath --enable-threads=yes --enable-plugins --enable-64-bit-bfd \
	--enable-compressed-debug-sections=all --enable-separate-code=yes"
### --with-system-zlib: the zlib of the sysroot, or of lfs/zlib:native for the native and cross builds
BINUTILS_FEATURE_FLAGS+=" --with-system-zlib"
### Configure flags shared by the sysroot build below and by the native build (variants/target/),
### which add their own --build/--host/--target
BINUTILS_COMMON_FLAGS="--prefix=${INSTALL_PREFIX} --libdir=${INSTALL_LIBDIR}${INSTALL_LIBSUFFIX} --with-sysroot=/ --with-build-sysroot=\${SYSROOT} \
	${BINUTILS_FEATURE_FLAGS}"
BINUTILS_COMMON_FLAGS+=" --with-mpc-include=\${SYSROOT}${INSTALL_INCLUDEDIR} --with-mpc-lib=\${SYSROOT}${INSTALL_LIBDIR}${INSTALL_LIBSUFFIX}"
BINUTILS_COMMON_FLAGS+=" --with-mpfr-include=\${SYSROOT}${INSTALL_INCLUDEDIR} --with-mpfr-lib=\${SYSROOT}${INSTALL_LIBDIR}${INSTALL_LIBSUFFIX}"
BINUTILS_COMMON_FLAGS+=" --with-gmp-include=\${SYSROOT}${INSTALL_INCLUDEDIR} --with-gmp-lib=\${SYSROOT}${INSTALL_LIBDIR}${INSTALL_LIBSUFFIX}"
BINUTILS_COMMON_FLAGS+=" --with-isl-include=\${SYSROOT}${INSTALL_INCLUDEDIR} --with-isl-lib=\${SYSROOT}${INSTALL_LIBDIR}${INSTALL_LIBSUFFIX}"
PKG_MAKEVARS="STAGE_CC_WRAPPER=\"${CCWRAPPER}\""
PKG_MAKEVARS+=" AR_FOR_TARGET=\"\${AR}\""
PKG_MAKEVARS+=" NM_FOR_TARGET=\"\${NM}\""
PKG_MAKEVARS+=" RANLIB_FOR_TARGET=\"\${RANLIB}\""
PKG_TOOLCHAIN=gnu
PKG_OVERRIDELD=bfd

### The sysroot binutils
CONF_FLAGS="${BINUTILS_COMMON_FLAGS} --build=${BARCH} --host=${HARCH} --target=${HARCH} --enable-targets=${HARCH}"
PKG_LDFLAGS="-s"
PKG_MAKETARGETS="all,install"
