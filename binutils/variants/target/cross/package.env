# binutils, target cross: the cross binutils of the platform toolchain
PKG_CHECK="[ \"\$( \"${INSTALL_EXECPREFIX}/bin/${HARCH}-ld.bfd\" --version | head -n1 | awk '{print \$5}' | cut -d. -f1,2 )\" == \"${PKG_VER/\+*/}\" ]"
CONF_FLAGS="${BINUTILS_COMMON_FLAGS} --build=${BARCH} --host=${BARCH} --target=${HARCH} --enable-targets=${HARCH}"
PKG_LDFLAGS=
PKG_MAKETARGETS="all,install-strip"
