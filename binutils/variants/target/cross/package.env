# binutils, target cross: the cross binutils of the platform toolchain (setup_full_toolchain), the
# assembler and linker of the cross gcc
PKG_CHECK="[ \"\$( \"${INSTALL_EXECPREFIX}/bin/${HARCH}-ld.bfd\" --version | head -n1 | awk '{print \$5}' | cut -d. -f1,2 )\" == \"${PKG_VER/\+*/}\" ]"
### The libraries of the build machine, in the global toolchain
PKG_DEPS="lfs/bison:native lfs/flex:native lfs/zlib:native lfs/libgmp:native lfs/libmpfr:native lfs/libmpc:native lfs/libisl:native"
### The sysroot of the cross gcc (gcc_sysroot, toolchain.functions): the image of a distribution when
### it has the C library, the sysroot of the project otherwise
CONF_FLAGS="--prefix=${INSTALL_PREFIX} --with-sysroot=$( gcc_sysroot 2>/dev/null || echo "${BIN_PATH}" ) ${BINUTILS_FEATURE_FLAGS}"
CONF_FLAGS+=" --with-mpc-include=${GLOBAL_TOOLCHAIN_PATH}/include --with-mpc-lib=${GLOBAL_TOOLCHAIN_PATH}/lib"
CONF_FLAGS+=" --with-mpfr-include=${GLOBAL_TOOLCHAIN_PATH}/include --with-mpfr-lib=${GLOBAL_TOOLCHAIN_PATH}/lib"
CONF_FLAGS+=" --with-gmp-include=${GLOBAL_TOOLCHAIN_PATH}/include --with-gmp-lib=${GLOBAL_TOOLCHAIN_PATH}/lib"
CONF_FLAGS+=" --with-isl-include=${GLOBAL_TOOLCHAIN_PATH}/include --with-isl-lib=${GLOBAL_TOOLCHAIN_PATH}/lib"
CONF_FLAGS+=" --build=${BARCH} --host=${BARCH} --target=${HARCH} --enable-targets=${HARCH}"
### The architecture of the platform, as the cross gcc has it
CONF_FLAGS+=" --with-arch-directory=${HM}${HMARCH:+ --with-arch=${HMARCH}}${HMFPU:+ --with-fpu=${HMFPU}}${HMFLOATABI:+ --with-float=${HMFLOATABI}}"
PKG_LDFLAGS=
### No *_FOR_TARGET: binutils builds no library of the target
PKG_MAKEVARS="STAGE_CC_WRAPPER=\"${CCWRAPPER}\""
PKG_MAKETARGETS="all,install-strip"
### LTO as the cross gcc (GCC_LTOENABLE)
PKG_OVERRIDELTO=${GCC_LTOENABLE:-0}
