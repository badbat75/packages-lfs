# binutils, target native: only configures the host tree (plugin-api.h for the global toolchain)
CONF_FLAGS="${BINUTILS_COMMON_FLAGS} --build=${BARCH} --host=${BARCH} --target=${BARCH}"
PKG_LDFLAGS=
PKG_MAKETARGETS="configure-host"
PKG_CHECK="[ -f ${INSTALL_INCLUDEDIR}/plugin-api.h ]"
