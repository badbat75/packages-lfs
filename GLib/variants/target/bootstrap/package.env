# GLib, target bootstrap
### Not the default build: the values of package.env this target keeps or drops
PKG_LD_LIBRARY_PATH=

PKG_DEPS="lfs/GLib:cross"
PKG_DEPS+=" lfs/libxslt lfs/pcre2"
### lfs/gobject-introspection needs this build: no introspection data, also when a sysroot built earlier
### already holds gobject-introspection (meson would pick it up)
CONF_FLAGS+=" -Dintrospection=disabled"
