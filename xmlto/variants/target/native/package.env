# xmlto, target native
### xmlto runs xmllint and xsltproc and records their paths: the ones of lfs/libxml2:native and
### lfs/libxslt:native, whose XML catalog has the DocBook of lfs/docbook-xml and lfs/docbook-xsl, not
### the ones of the build host. An xmlto built with other ones fails the check and is built again
PKG_DEPS+=" lfs/libxml2:native lfs/libxslt:native lfs/docbook-xml:native lfs/docbook-xsl:native"
CONF_VARS+=" XMLLINT=${GLOBAL_TOOLCHAIN_PATH}/bin/xmllint XSLTPROC=${GLOBAL_TOOLCHAIN_PATH}/bin/xsltproc"
PKG_CHECK="[ x$(${GLOBAL_TOOLCHAIN_PATH}/bin/xmlto --version 2>/dev/null | awk '{print $3}' || : ) == x${PKG_VER} ] && grep -qx 'XSLTPROC_PATH=${GLOBAL_TOOLCHAIN_PATH}/bin/xsltproc' ${GLOBAL_TOOLCHAIN_PATH}/bin/xmlto"
