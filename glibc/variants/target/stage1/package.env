# glibc, target stage1: headers and start files for the gcc bootstrap (built with --temporary)
### Not the default build: the values of package.env this target keeps or drops
PKG_DEPS="lfs/bison:native"
CONF_VARS="libc_cv_forced_unwind=yes libc_cv_c_cleanup=yes"

PKG_DEPS+=" lfs/kernel:headers"
STD_CONF_FLAGS=0
CONF_FLAGS="--build=${BARCH} --host=${HARCH} --target=${HARCH} \
	--prefix=${INSTALL_PREFIX} --includedir=${INSTALL_INCLUDEDIR} \
	--with-headers=${BIN_PATH}${INSTALL_INCLUDEDIR} --disable-multilib --disable-werror"
PKG_MAKETARGETS="install-bootstrap-headers=yes install-headers,csu/subdir_lib"
