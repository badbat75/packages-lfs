# glibc
PKG_VER=${GLIBC_VER}
PKG_URL="https://ftp.gnu.org/gnu/libc/glibc-${GLIBC_VER}.tar.xz"
PKG_DEPS="lfs/bison:native"
### The release branch patch and the LFS FHS patch of every supported version live in
### variants/version/<GLIBC_VER>/ (utilities/update_patches writes them); an unknown version
### builds unpatched.
### The per target configuration (cross, stage1, the sysroot glibc) and the options WITH_NSCD,
### WITH_SYSTEMTAP and WITH_ANNOBIN live in variants/target/.

if [ -z "${OPTLEVEL}" ] || [ "${OPTLEVEL}" -lt 2 ]
then
	PKG_CFLAGS="-O2"
fi

PKG_OVERRIDELTO=0
BUILD_PROCESS=configmake
CONF_VARS="libc_cv_forced_unwind=yes libc_cv_c_cleanup=yes"
PKG_MAKEVARS="cross-compiling=yes -j${NPROCS}"
PKG_MAKEENV="PARALLELMFLAGS=-j${NPROCS}"
PKG_TOOLCHAIN=gnu
PKG_OVERRIDELD=bfd
### Got issues with sccache because overwrite /dev/null during glibc build. Issues with gcc -o /dev/null.
PKG_DISABLECCWRAPPER=1
### configparms is written by prebuild.sh, the per target install steps are in postbuild.sh
if [ ${MAKEVERBOSE:-0} -eq 0 ]
then
	PKG_MAKEVARS+=" -s"
fi
