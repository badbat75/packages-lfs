# libaudit
PKG_VER=4.2.1
PKG_URL="https://github.com/linux-audit/audit-userspace/archive/refs/tags/v${PKG_VER}.tar.gz"
PKG_AUTOCONF=1
BUILD_PROCESS=configmake
### The python3 modules: audit and auparse, the first generated by the swig of lfs/swig:native,
### for the python of the image (cross-python3 and the python3-config of its environment)
CONF_FLAGS="--disable-zos-remote --without-python --with-python3"
CONF_VARS="PYTHON=cross-python3"
### libcap-ng (auditd drops the capabilities of its plugins with it) is detected by default: named,
### so that the build does not depend on whether lfs/libcap-ng (a D-Bus dependency) came first
CONF_FLAGS+=" --with-libcap-ng=yes"
PKG_FAULTYCFLAGS=1
PKG_MAKETARGETS="all,install-strip"
PKG_TARGET=${PKG_TARGET:-${LIBAUDIT_TARGET}}

PKG_DEPS="lfs/krb5:lib lfs/systemd:bootstrap lfs/libcap-ng lfs/python3 lfs/swig:native"
