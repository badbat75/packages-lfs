# fontconfig
PKG_VER=2.14.2
PKG_URL="https://www.freedesktop.org/software/fontconfig/release/fontconfig-${PKG_VER}.tar.xz"
PKG_DEPS="lfs/FreeType lfs/json-c"
BUILD_PROCESS=mesonninja
### doc-pdf: auto-enabled when the host has docbook2pdf, which then fails without jadetex
CONF_FLAGS="-Dtests=disabled -Ddoc-pdf=disabled"
#PKG_MAKETARGETS="all,install"
