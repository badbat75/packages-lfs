# fontconfig
PKG_VER=2.18.3
### Since 2.17 the release tarballs are GitLab generic packages (freedesktop.org/software stops at 2.16)
PKG_URL="https://gitlab.freedesktop.org/api/v4/projects/fontconfig%2Ffontconfig/packages/generic/fontconfig/${PKG_VER}/fontconfig-${PKG_VER}.tar.xz"
PKG_DEPS="lfs/FreeType lfs/json-c"
BUILD_PROCESS=mesonninja
### doc-pdf: auto-enabled when the host has docbook2pdf, which then fails without jadetex
CONF_FLAGS="-Dtests=disabled -Ddoc-pdf=disabled"
#PKG_MAKETARGETS="all,install"
