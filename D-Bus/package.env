# D-Bus
PKG_VER=1.16.2
PKG_URL="https://dbus.freedesktop.org/releases/dbus/dbus-${PKG_VER}.tar.xz"
### Since 1.16 dbus ships meson only (no configure): the old --enable/--with flags are meson options
PKG_DEPS="lfs/expat lfs/libX11"
PKG_DEPS+=" lfs/systemd:bootstrap"
PKG_DEPS+=" lfs/libcap2:bootstrap"
PKG_DEPS+=" lfs/libaudit lfs/libcap-ng"
BUILD_PROCESS=mesonninja
CONF_FLAGS="-Duser_session=true"
CONF_FLAGS+=" -Dinotify=enabled -Depoll=enabled"
### libaudit (with libcap-ng, which meson wants next to it) logs the SELinux and AppArmor denials,
### neither of them in the project, and changes the user of the bus in bus/audit.c, which only
### drops privileges when it runs as root. Without it the fallback of dbus-sysdeps-util-unix.c
### calls setgroups() in the bus dbus.service already starts as messagebus: "Failed to drop
### supplementary groups: Operation not permitted" at every boot
CONF_FLAGS+=" -Dlibaudit=enabled"
CONF_FLAGS+=" -Dsystemd=enabled"
CONF_FLAGS+=" -Dx11_autolaunch=enabled"
CONF_FLAGS+=" -Dasserts=false"
CONF_FLAGS+=" -Ddoxygen_docs=disabled -Dxml_docs=disabled -Dducktype_docs=disabled -Dqt_help=disabled"
CONF_FLAGS+=" -Dmodular_tests=disabled -Dintrusive_tests=false -Dinstalled_tests=false"
CONF_FLAGS+=" -Drelocation=disabled"
CONF_FLAGS+=" -Druntime_dir=/run"
CONF_FLAGS+=" -Dsystem_socket=/run/dbus/system_bus_socket"
CONF_FLAGS+=" -Dsystemd_system_unitdir=/lib/systemd/system"
CONF_FLAGS+=" -Dsystemd_user_unitdir=${INSTALL_PREFIX}/lib/systemd/user"

PKG_POSTINSTALL_PRIO=11
