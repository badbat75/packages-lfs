# ca-bundle
### The CA certificates of Mozilla in one PEM file, as curl extracts them from certdata.txt: the
### cert.pem of the OPENSSLDIR of lfs/openssl:native (${INSTALL_SYSCONFDIR}/ssl), which the native
### Python, cmake and every other native program linked with it read to verify a server. The image has
### its own, made by lfs/make-ca
PKG_VER=2026-09-25
PKG_URL="https://curl.se/ca/cacert-${PKG_VER}.pem"
CA_BUNDLE_SHA256=a41b5d356aea97a529fe27e0f7316d2f9d946d75927476cf9cf1b90637d00505
PKG_DEPS=
BUILD_PROCESS=custom
PKG_CHECK="echo '${CA_BUNDLE_SHA256}  ${INSTALL_SYSCONFDIR}/ssl/cert.pem' | sha256sum -c --status"
