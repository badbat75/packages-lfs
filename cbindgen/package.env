# cbindgen: C bindings of a Rust library
### A host tool (lfs/cbindgen:native): nouveau (NVK) of Mesa generates the headers of nil with it
PKG_VER=0.29.4
PKG_URL="https://github.com/mozilla/cbindgen/archive/refs/tags/v${PKG_VER}.tar.gz"
BUILD_PROCESS=cargobuild
PKG_OVERRIDELTO=0
CONF_FLAGS=""
CARGO_BINLIST="cbindgen"
PKG_LDFLAGS=-s
