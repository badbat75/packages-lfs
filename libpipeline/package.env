# libpipeline
PKG_VER=1.5.8
### The release archive: configure and gnulib (gl/) are in it. The archive of the git tag needs ./bootstrap,
### which clones the whole of gnulib from savannah at build time
PKG_URL="https://download.savannah.nongnu.org/releases/libpipeline/libpipeline-${PKG_VER}.tar.gz"
BUILD_PROCESS=configmake
PKG_AUTOCONF=1
CONF_FLAGS=""
PKG_MAKETARGETS="all,install-strip"
