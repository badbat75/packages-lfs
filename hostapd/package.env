# hostapd
PKG_VER=2.11
### git.w1.fi no longer serves cgit snapshots of the whole hostap tree: the release tarball of
### hostapd carries src/ and its own directory (wpa_supplicant is lfs/wpa_supplicant, same version)
PKG_URL="https://w1.fi/releases/hostapd-${PKG_VER}.tar.gz"
BUILD_PROCESS=simplemake
PKG_MAKETARGETS="all"
PKG_DEPS="lfs/libnl"
PKG_MAKEVARS="PREFIX=${INSTALL_PREFIX} INCDIR=${INSTALL_INCLUDEDIR} BINDIR=${INSTALL_PREFIX}/sbin -C hostapd"
