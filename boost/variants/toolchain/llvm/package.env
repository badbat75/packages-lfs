# boost, toolchain llvm
BBTC=clang
### The target of the platform, in case b2 still writes one of its own (prebuild.sh takes the option out
### of clang.jam, where its shape changes from release to release): these flags follow the ones of b2 on
### the command line, so the configuration file clang reads is the one of the platform either way
PKG_CFLAGS="--target=${HARCH}"
PKG_CXXFLAGS="--target=${HARCH}"
### -lstdc++: b2 links the libraries with the command of "using clang", which is the C driver here, and
### only the gcc toolset of b2 names the C++ runtime by itself. The C++ symbols of libboost_filesystem
### (std::__throw_length_error, the exception classes) have nowhere to come from otherwise
PKG_LDFLAGS="--target=${HARCH} -lstdc++"
