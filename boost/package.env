# boost
PKG_VER=1.82.0
PKG_URL="https://boostorg.jfrog.io/artifactory/main/release/${PKG_VER}/source/boost_${PKG_VER//./_}.tar.bz2"
PKG_DEPS="lfs/zstd lfs/xz lfs/bzip2 lfs/zlib"
BUILD_PROCESS=custom

PKG_LDFLAGS="-lstdc++"

case ${TOOLCHAIN} in
	llvm) BBTC=clang ;;
	gnu)
		BBTC=gcc
		PKG_CFLAGS="-Wno-deprecated-declarations"
	;;
esac

