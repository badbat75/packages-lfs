# Tk, target bootstrap
### Not the default build: the values of package.env this target keeps or drops
PKG_DEPS="lfs/Tcl"

PKG_DEPS+=" lfs/libX11:bootstrap"
### No bidirectional text and no Xft: HarfBuzz, which the first needs since 9.1, and libXft come far
### after the cross Python (9.1 compiles tkUnixRFont.c even when configure falls back to the classic fonts).
### The image gets the full lfs/Tk, built over this one once they are there (lfs.prj)
CONF_FLAGS+=" --disable-bidi --disable-xft"
