# Tk
PKG_VER=9.1.0
PKG_URL="https://downloads.sourceforge.net/tcl/tk${PKG_VER}-src.tar.gz"
PKG_DEPS="lfs/Tcl"
BUILD_PROCESS=configmake
CONF_PATH="unix"
CONF_FLAGS="--mandir=${INSTALL_SHAREDIR}/man"
CONF_FLAGS+=" --with-tcl=${BIN_PATH}${INSTALL_LIBDIR}${INSTALL_LIBSUFFIX}"
CONF_FLAGS+=" --disable-rpath"
PKG_MAKETARGETS=",install,install-private-headers"
### tkUnixFont.c writes through strchr(), which returns const char * in C23 (the gcc 15+ default)
### with glibc 2.44: build as C17
PKG_CFLAGS="-std=gnu17"
PKG_LDFLAGS="-lm -s"
### wish links libtcl with the TCL_LIB_SPEC of the tclConfig.sh of the sysroot, which is the one of the
### image (-L/usr/lib64 -ltcl9.0): for the cross linker that -L is the build host, whose libm (or libtcl,
### when it had one) it took. The library of the sysroot is in a system directory of the compiler
PKG_MAKEVARS="TCL_LIB_SPEC=-ltcl${PKG_VER%.*}"

PKG_DEPS+=" lfs/libX11"
### The antialiased fonts (--enable-xft, the default when configure finds it)
PKG_DEPS+=" lfs/libXft"
### Since 9.1 the bidirectional text (--enable-bidi, the default) shapes it with HarfBuzz
PKG_DEPS+=" lfs/HarfBuzz"
