# e2fsprogs, target native: mke2fs, e2fsck and resize2fs of the build machine, with which create_image
# and mount_tag (images.functions) make, check and grow the ext filesystems of an image. Static, with
# the blkid and uuid libraries of e2fsprogs: nothing of the host but the C library
PKG_DEPS=
CONF_FLAGS="--disable-option-checking"
CONF_FLAGS+=" --enable-libblkid"
CONF_FLAGS+=" --enable-libuuid"
CONF_FLAGS+=" --disable-uuidd"
CONF_FLAGS+=" --disable-fsck"
CONF_FLAGS+=" --disable-nls"
CONF_FLAGS+=" --disable-e2initrd-helper"
CONF_FLAGS+=" --without-systemd-unit-dir"
CONF_FLAGS+=" --without-udev-rules-dir"
CONF_FLAGS+=" --without-crond-dir"
PKG_MAKETARGETS="all,-j1 install"
PKG_CHECK="[ \"\$( ${INSTALL_EXECPREFIX}/sbin/mke2fs -V 2>&1 | head -n1 | awk '{print \$2}' )\" == \"${PKG_VER}\" ]"
### Built by the gnu toolchain: an image can be made before llvm is there
PKG_TOOLCHAIN=gnu
