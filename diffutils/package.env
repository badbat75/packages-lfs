# diffutils
PKG_VER=3.12
PKG_URL="http://ftp.gnu.org/gnu/diffutils/diffutils-${PKG_VER}.tar.xz"
PKG_DEPS="lfs/flex:native"
BUILD_PROCESS=configmake
CONF_FLAGS=""
### gnulib "checking whether strcasecmp works" is a run test with no cross-compiling guess:
### preset its cache variable (glibc strcasecmp is fine)
CONF_VARS="gl_cv_func_strcasecmp_works=yes"
PKG_MAKETARGETS="all,install-strip"
