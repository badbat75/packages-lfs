# libtirpc
PKG_VER=1.3.8
PKG_URL="https://downloads.sourceforge.net/libtirpc/libtirpc-${PKG_VER}.tar.bz2"
PKG_DEPS="lfs/krb5:bootstrap"
BUILD_PROCESS=configmake
PKG_AUTOCONF=1
CONF_FLAGS=""
# ac_cv_prog_cc_c23: autoconf 2.73 adds the option of the newest standard the compiler knows to CC, and
# the sources are older: 14 files of src/ define their functions with an identifier list, which C23 removed.
# gcc still takes them with a warning, clang does not; the next probe of configure answers C11
CONF_VARS="ac_cv_prog_ac_ct_KRB5_CONFIG=\${SYSROOT}${INSTALL_EXECDIR}/bin/krb5-config ac_cv_prog_cc_c23=no"
PKG_MAKETARGETS="all,install-strip"
# --undefined-version: the version script names authdes_getucred, which only a build with --enable-authdes
# defines, and the option defaults to no. GNU ld passes over an assignment to a symbol it does not have,
# lld makes it an error since 17, and this is the behaviour libtirpc is written for
PKG_LDFLAGS="-Wl,--undefined-version"
