# groff, target cross or native
### Not the default build: the values of package.env this target keeps or drops
PKG_DEPS=
PKG_MAKEVARS=

### -v prints "GNU groff version <ver>"; -V prints the pipeline groff would run
PKG_CHECK="[ x\$( ${INSTALL_EXECPREFIX}/bin/groff -v < /dev/null | awk 'NR==1{print \$4}' || true ) == x${PKG_VER} ]"
