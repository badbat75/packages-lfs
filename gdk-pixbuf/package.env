# gdk-pixbuf
PKG_VER=2.44.8
PKG_URL="https://download.gnome.org/sources/gdk-pixbuf/$(echo "${PKG_VER}" | cut -d. -f1,2)/gdk-pixbuf-${PKG_VER}.tar.xz"
PKG_DEPS="lfs/GLib"
PKG_DEPS+=" lfs/shared-mime-info"
### The loaders are the glycin one, built into the library, for every format glycin reads: the classic png,
### jpeg, tiff and gif loaders and the thumbnailer turn off with it. The SVG loader of glycin is
### lfs/glycin:svg, built after librsvg
PKG_DEPS+=" lfs/glycin"
PKG_DEPS+=" lfs/gobject-introspection"
BUILD_PROCESS=mesonninja
CONF_FLAGS="--wrap-mode=nofallback -Dintrospection=enabled -Dglycin=enabled"
CONF_FLAGS+=" -Dtests=false -Dinstalled_tests=false"
#PKG_MAKETARGETS="all,install"
