# libarchive
PKG_VER=3.8.9
PKG_URL="https://github.com/libarchive/libarchive/releases/download/v${PKG_VER}/libarchive-${PKG_VER}.tar.xz"
### The libarchive the freedreno tools of lfs/Mesa look for: without it in the sysroot meson fetched
### the one of its wrap from the network
PKG_DEPS="lfs/zlib lfs/bzip2 lfs/xz lfs/zstd lfs/lz4 lfs/openssl lfs/libxml2 lfs/acl lfs/attr"
BUILD_PROCESS=configmake
### The libraries named, not whatever the sysroot holds when configure runs; iconv is the one of glibc
### (AC_LIB_LINKFLAGS would search the libdir of the build host for a libiconv)
CONF_FLAGS="--with-zlib --with-bz2lib --with-lzma --with-zstd --with-lz4 --with-openssl --with-xml2"
CONF_FLAGS+=" --without-expat --without-nettle --without-mbedtls --without-lzo2 --without-libb2 --without-cng"
CONF_FLAGS+=" --without-libiconv-prefix"
PKG_MAKETARGETS="all,install-strip"
