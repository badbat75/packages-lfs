# check
PKG_VER=0.15.2
PKG_URL="https://github.com/libcheck/check/archive/refs/tags/${PKG_VER}.tar.gz"
BUILD_PROCESS=cmakebuild
### checkmk is an awk script: find_program(AWK_PATH awk) looks in the sysroot first, and its shebang
### named the host path of the sysroot awk
CONF_FLAGS="-DAWK_PATH=/usr/bin/awk"
