# dwarves
### pahole, a tool of the build machine (lfs/dwarves:native): the kernel builds with DEBUG_INFO_BTF
### (microsoft/wsl-kernel_6.18) encode the BTF of vmlinux and of the modules with it. It reads the
### DWARF with the libdw of lfs/elfutils:native; libbpf is the copy of its sources (LIBBPF_EMBEDDED)
PKG_VER=1.32
PKG_URL="https://fedorapeople.org/~acme/dwarves/dwarves-${PKG_VER}.tar.xz"
PKG_DEPS="lfs/elfutils lfs/zlib"
BUILD_PROCESS=cmakebuild
### __LIB: the library directory under the prefix (lib64 by default on a 64 bit build machine)
CONF_FLAGS="-D__LIB=lib -DCMAKE_BUILD_TYPE=Release"
PKG_MAKETARGETS="all,install/strip"
