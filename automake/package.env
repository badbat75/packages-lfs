# automake
PKG_VER=1.19
PKG_URL="https://ftp.gnu.org/gnu/automake/automake-${PKG_VER}.tar.xz"
### configure checks the autoconf in the PATH: the one of lfs/autoconf:cross
PKG_DEPS="lfs/autoconf:cross"
BUILD_PROCESS=configmake
CONF_FLAGS="--docdir=${INSTALL_SHAREDIR}/doc/automake-${PKG_VER}"
PKG_MAKETARGETS="all,install-strip"
