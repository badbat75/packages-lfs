# automake, target native: the automake and aclocal of the build machine, which smart_autoreconf runs for
# every PKG_AUTOCONF build (configmake)
### Not the default build: the values of package.env this target keeps or drops
### The autoconf of lfs/autoconf:native, which ./bootstrap of prebuild.sh and configure run, and the perl
### of lfs/perl5:native in the hashbang of the programs
PKG_DEPS="lfs/autoconf lfs/perl5"
PKG_CHECK="[ \"\$( ${INSTALL_EXECPREFIX}/bin/automake --version 2>/dev/null | head -n1 )\" == \"automake (GNU automake) ${PKG_VER}\" ] && head -n1 ${INSTALL_EXECPREFIX}/bin/automake | grep -q '^#! *${GLOBAL_TOOLCHAIN_PATH}/perl5/bin/perl'"
