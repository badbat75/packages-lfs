# BerkeleyDB
PKG_VER=18.1.25
PKG_URL="https://anduin.linuxfromscratch.org/BLFS/bdb/db-${PKG_VER}.tar.gz"
PKG_DEPS="lfs/sharutils"
BUILD_PROCESS=configmake
PKG_AUTOCONF=1
AUTOCONF_PATH=dist
CONF_PATH=dist
CONF_FLAGS="--enable-dbm --enable-cxx"
### 2013 code: K&R definitions and function pointer tables of mismatched types, an error since gcc 14
PKG_CFLAGS="-std=gnu17 -Wno-error=incompatible-pointer-types"
#PKG_MAKETARGETS="all,install"
