# Linux-PAM
PKG_VER=1.7.2
PKG_URL="https://github.com/linux-pam/linux-pam/releases/download/v${PKG_VER}/Linux-PAM-${PKG_VER}.tar.xz"
### Since 1.7.0 the build system is meson (no configure): meson.build installs the headers in
### includedir/security and the modules in libdir/security by itself. The documentation wants the
### docbook stylesheets from the network and stays off.
PKG_DEPS="lfs/bison:native lfs/flex:native lfs/libnsl lfs/libtirpc"
PKG_DEPS+=" lfs/libxml2"
BUILD_PROCESS=mesonninja
CONF_FLAGS="-Dsystemdunitdir=/lib/systemd/system"
CONF_FLAGS+=" -Ddocdir=${INSTALL_SHAREDIR}/doc/Linux-PAM-${PKG_VER}"
CONF_FLAGS+=" -Ddocs=disabled -Dexamples=false -Dnis=enabled"
CONF_FLAGS+=" -Dlogind=enabled -Daudit=enabled -Dpam_userdb=enabled -Ddb=db"

PKG_DEPS+=" lfs/systemd:bootstrap lfs/BerkeleyDB lfs/libaudit"
PKG_DEPS+=" lfs/libpwquality"
