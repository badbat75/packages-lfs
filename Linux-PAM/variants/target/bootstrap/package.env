# Linux-PAM, target bootstrap: libpam and the modules without the optional dependencies (systemd,
# libaudit, BerkeleyDB depend on it), so every feature they would pull in is off
### Not the default build: the values of package.env this target keeps or drops
PKG_DEPS="lfs/bison:native lfs/flex:native lfs/libnsl lfs/libtirpc"
PKG_DEPS+=" lfs/libxml2"
CONF_FLAGS="-Dsystemdunitdir=/lib/systemd/system"
CONF_FLAGS+=" -Ddocs=disabled -Dexamples=false -Dnis=enabled"
CONF_FLAGS+=" -Dlogind=disabled -Delogind=disabled -Daudit=disabled -Dpam_userdb=disabled"
CONF_FLAGS+=" -Deconf=disabled -Dpwaccess=disabled -Dselinux=disabled"
