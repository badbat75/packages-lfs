# libedit, target native: the line editing of the lldb and the clang-repl of the global LLVM
# (setup_llvm), on the ncurses of lfs/ncurses:native
PKG_DEPS="lfs/ncurses"
### libedit.pc says 3.1 only: the version of the release is in share/libedit.version (postbuild.sh)
PKG_CHECK="[ x\$( cat ${INSTALL_SHAREDIR}/libedit.version 2>/dev/null || true ) == x${PKG_VER} ] && [ -f ${INSTALL_LIBDIR}/pkgconfig/libedit.pc ]"
### Built by the gnu toolchain: lfs/llvm:native depends on it, there is no clang before that
PKG_TOOLCHAIN=gnu
