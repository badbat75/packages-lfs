# libxcb
PKG_VER=1.17.0
PKG_URL="https://xorg.freedesktop.org/archive/individual/lib/libxcb-${PKG_VER}.tar.xz"
### The graphs of the doxygen documentation: dot of lfs/graphviz:native
PKG_DEPS="lfs/doxygen:native lfs/graphviz:native lfs/libXau lfs/libXdmcp"
BUILD_PROCESS=configmake
PKG_AUTOCONF=1
CONF_FLAGS=""
PKG_MAKETARGETS="all,install-strip"

CONF_ENV="PYTHON=cross-python3"
PKG_DEPS+=" lfs/xcb-proto"
