# doxygen
PKG_VER=1.18.0
PKG_URL="https://doxygen.nl/files/doxygen-${PKG_VER}.src.tar.gz"
PKG_DEPS="lfs/bison:native lfs/flex:native"
BUILD_PROCESS=cmakebuild
CMAKE_GENERATOR="Unix Makefiles"
CONF_FLAGS="-Dbuild_doc=OFF -Wno-dev"
### The sysroot find_program of cmake picks the bison and flex of the target and runs them under qemu:
### bison spawns m4 with absolute data paths, which -L does not remap. The native tools of the
### toolchain generate the parsers of the build
CONF_FLAGS+=" -DBISON_EXECUTABLE=${GLOBAL_TOOLCHAIN_PATH}/bin/bison"
CONF_FLAGS+=" -DFLEX_EXECUTABLE=${GLOBAL_TOOLCHAIN_PATH}/bin/flex"
PKG_MAKETARGETS="all,install/strip"
