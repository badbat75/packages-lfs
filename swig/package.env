# swig: the generator of the bindings of C libraries for the scripting languages
### A tool of the build machine (lfs/swig:native): the python modules of lfs/libaudit
PKG_VER=4.5.1
PKG_URL="https://downloads.sourceforge.net/swig/swig-${PKG_VER}.tar.gz"
PKG_DEPS="lfs/pcre2"
BUILD_PROCESS=configmake
CONF_FLAGS="--without-alllang"
### The default target of the top Makefile is swig (there is no "all")
PKG_MAKETARGETS=",install"
