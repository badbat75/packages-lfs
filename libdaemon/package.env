# libdaemon
PKG_VER=0.14
PKG_URL="https://0pointer.de/lennart/projects/libdaemon/libdaemon-${PKG_VER}.tar.gz"
### lynx: the text README, the dump of README.html
PKG_DEPS="lfs/doxygen:native lfs/lynx:native"
BUILD_PROCESS=configmake
PKG_AUTOCONF=1
CONF_FLAGS=""
PKG_MAKEVARS="docdir=/usr/share/doc/libdaemon-${PKG_VER}"
PKG_MAKETARGETS="all,install-strip"

