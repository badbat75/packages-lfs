# autoconf, target native: the autoconf of the build machine, which smart_autoreconf runs for every
# PKG_AUTOCONF build (configmake)
### The m4 of lfs/m4:native, which autom4te records, and the perl of lfs/perl5:native, the first of the
### PATH, in the hashbang of the programs
PKG_DEPS+=" lfs/m4 lfs/perl5"
CONF_VARS+=" M4=${GLOBAL_TOOLCHAIN_PATH}/bin/m4"
### The version, and the m4 and the perl of the global toolchain: an autoconf built with others (the ones
### of the build host) is built again
PKG_CHECK="[ \"\$( ${INSTALL_EXECPREFIX}/bin/autoconf --version 2>/dev/null | head -n1 )\" == \"autoconf (GNU Autoconf) ${PKG_VER}\" ] && grep -q \"'${GLOBAL_TOOLCHAIN_PATH}/bin/m4'\" ${INSTALL_EXECPREFIX}/bin/autom4te && head -n1 ${INSTALL_EXECPREFIX}/bin/autom4te | grep -q '^#! *${GLOBAL_TOOLCHAIN_PATH}/perl5/bin/perl'"
