# autoconf, target sysroot
### Built with the m4 of lfs/m4:native, which the Makefile writes into autom4te (@M4@) and runs to
### freeze the m4 files; postbuild.sh puts the one of the image there, /usr/bin/m4 of lfs/m4
PKG_DEPS+=" lfs/m4 lfs/m4:native"
CONF_VARS+=" M4=${GLOBAL_TOOLCHAIN_PATH}/bin/m4"
