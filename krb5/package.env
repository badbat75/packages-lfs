# krb5
PKG_VER=1.22.2
PKG_URL="https://kerberos.org/dist/krb5/$(echo ${PKG_VER} | cut -d. -f1,2)/krb5-${PKG_VER}.tar.gz"
PKG_DEPS="lfs/bison:native lfs/e2fsprogs:bootstrap"
BUILD_PROCESS=configmake
#PKG_AUTOCONF=1
#AUTOCONF_PATH=src
CONF_PATH=src
CONF_FLAGS="--localstatedir=/var/lib \
			--with-system-et \
			--with-system-ss \
			--with-system-verto=no \
			--enable-dns-for-realm"
CONF_VARS="krb5_cv_attr_constructor_destructor=yes,yes \
			ac_cv_func_regcomp=yes \
			ac_cv_printf_positional=yes"
PKG_MAKETARGETS="all,install-strip"
### configure adds -Werror=discarded-qualifiers after CFLAGS unless WARN_CFLAGS is already set, and
### the C23 strchr of glibc 2.44 (on with _GNU_SOURCE whatever the -std) keeps the const of its
### argument: "cp = strchr(name, ':')" in ccbase.c stops the build. Warnings stay, errors go.
CONF_VARS+=" WARN_CFLAGS=-Wall"

PKG_DEPS+=" lfs/libedit"
PKG_DEPS+=" lfs/openldap:bootstrap"
CONF_FLAGS+=" --with-ldap"

### The targets split what the build installs (split_install in the postbuild.sh of
### variants/target/<target>): :lib the libraries (the GSSAPI of curl, openssh, sudo, bind9, cyrus-sasl),
### the client plugins, the include files, pc files and krb5-config, :client the kinit, klist, kpasswd,
### kadmin... tools, :server everything else (the KDC, kadmind, kprop, the LDAP database module and
### its libkdb_ldap, the sample programs), both over :lib. :bootstrap is the libraries without LDAP,
### which openldap depends on. Without a target the whole krb5, with the documentation. The lists
### are paths of the image, find -path patterns (a * also matches a /)
KRB5_LIBPATH=${INSTALL_LIBDIR}${INSTALL_LIBSUFFIX}
KRB5_MANPATH=${INSTALL_SHAREDIR}/man
KRB5_LIB_FILES="${KRB5_LIBPATH}/libkrb5* ${KRB5_LIBPATH}/libk5crypto* ${KRB5_LIBPATH}/libgssapi_krb5*"
KRB5_LIB_FILES+=" ${KRB5_LIBPATH}/libgssrpc* ${KRB5_LIBPATH}/libkadm5* ${KRB5_LIBPATH}/libkdb5* ${KRB5_LIBPATH}/libkrad*"
KRB5_LIB_FILES+=" ${KRB5_LIBPATH}/libverto* ${KRB5_LIBPATH}/pkgconfig/* ${KRB5_LIBPATH}/krb5/plugins/tls/*"
KRB5_LIB_FILES+=" ${KRB5_LIBPATH}/krb5/plugins/preauth/otp.so ${KRB5_LIBPATH}/krb5/plugins/preauth/pkinit.so"
KRB5_LIB_FILES+=" ${KRB5_LIBPATH}/krb5/plugins/preauth/spake.so ${INSTALL_INCLUDEDIR}/*"
KRB5_LIB_FILES+=" ${INSTALL_EXECPREFIX}/bin/krb5-config ${KRB5_MANPATH}/man1/krb5-config.1 ${INSTALL_SHAREDIR}/locale/*"
KRB5_LIB_FILES+=" ${KRB5_MANPATH}/man5/krb5.conf.5 ${KRB5_MANPATH}/man5/*k5identity.5 ${KRB5_MANPATH}/man5/*k5login.5"
KRB5_LIB_FILES+=" ${KRB5_MANPATH}/man7/kerberos.7 ${INSTALL_SHAREDIR}/examples/krb5/krb5.conf"
KRB5_LIB_FILES+=" ${INSTALL_SHAREDIR}/examples/krb5/services.append"
KRB5_CLIENT_FILES="${INSTALL_EXECPREFIX}/bin/kinit ${INSTALL_EXECPREFIX}/bin/klist ${INSTALL_EXECPREFIX}/bin/kdestroy"
KRB5_CLIENT_FILES+=" ${INSTALL_EXECPREFIX}/bin/kpasswd ${INSTALL_EXECPREFIX}/bin/kswitch ${INSTALL_EXECPREFIX}/bin/kvno"
KRB5_CLIENT_FILES+=" ${INSTALL_EXECPREFIX}/bin/ktutil ${INSTALL_EXECPREFIX}/bin/kadmin ${INSTALL_EXECPREFIX}/bin/k5srvutil"
KRB5_CLIENT_FILES+=" ${INSTALL_EXECPREFIX}/bin/ksu ${KRB5_MANPATH}/man1/kinit.1 ${KRB5_MANPATH}/man1/klist.1"
KRB5_CLIENT_FILES+=" ${KRB5_MANPATH}/man1/kdestroy.1 ${KRB5_MANPATH}/man1/kpasswd.1 ${KRB5_MANPATH}/man1/kswitch.1"
KRB5_CLIENT_FILES+=" ${KRB5_MANPATH}/man1/kvno.1 ${KRB5_MANPATH}/man1/ktutil.1 ${KRB5_MANPATH}/man1/kadmin.1"
KRB5_CLIENT_FILES+=" ${KRB5_MANPATH}/man1/k5srvutil.1 ${KRB5_MANPATH}/man1/ksu.1"
