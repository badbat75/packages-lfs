# krb5
PKG_VER=1.22.2
PKG_URL="https://kerberos.org/dist/krb5/$(echo ${PKG_VER} | cut -d. -f1,2)/krb5-${PKG_VER}.tar.gz"
PKG_DEPS="lfs/bison:native lfs/e2fsprogs:bootstrap"
BUILD_PROCESS=configmake
#PKG_AUTOCONF=1
#AUTOCONF_PATH=src
CONF_PATH=src
CONF_FLAGS="--localstatedir=/var/lib \
			--with-system-et \
			--with-system-ss \
			--with-system-verto=no \
			--enable-dns-for-realm"
CONF_VARS="krb5_cv_attr_constructor_destructor=yes,yes \
			ac_cv_func_regcomp=yes \
			ac_cv_printf_positional=yes"
PKG_MAKETARGETS="all,install-strip"
### configure adds -Werror=discarded-qualifiers after CFLAGS unless WARN_CFLAGS is already set, and
### the C23 strchr of glibc 2.44 (on with _GNU_SOURCE whatever the -std) keeps the const of its
### argument: "cp = strchr(name, ':')" in ccbase.c stops the build. Warnings stay, errors go.
CONF_VARS+=" WARN_CFLAGS=-Wall"

PKG_DEPS+=" lfs/libedit"
PKG_DEPS+=" lfs/openldap:bootstrap"
PKG_DEPS+=" lfs/bind9:bootstrap"
CONF_FLAGS+=" --with-ldap"
