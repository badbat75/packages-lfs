# mold
PKG_VER=2.42.1
PKG_URL="https://github.com/rui314/mold/archive/refs/tags/v${PKG_VER}.tar.gz"
PKG_DEPS="lfs/zlib lfs/zstd"
BUILD_PROCESS=cmakebuild
### lfs/mold:cross is built by setup_full_toolchain before lfs/ninja:native
CMAKE_GENERATOR="Unix Makefiles"
PKG_MAKETARGETS="all,install/strip"
### zlib and zstd of the sysroot; TBB, mimalloc (64 bit targets only) and BLAKE3 are the bundled
### copies, linked statically
CONF_FLAGS="-DBUILD_TESTING=OFF -DMOLD_USE_SYSTEM_TBB=OFF -DMOLD_USE_SYSTEM_MIMALLOC=OFF"
