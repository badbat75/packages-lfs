# dtc
PKG_VER=1.8.1
PKG_URL="https://www.kernel.org/pub/software/utils/dtc/dtc-${PKG_VER}.tar.xz"
PKG_DEPS="lfs/flex:native lfs/bison:native"
BUILD_PROCESS=mesonninja
### The device tree compiler and its tools (fdtoverlay, fdtget, fdtput): a static libfdt (mesonninja
### passes --default-library=static), so the tools need no library path; no python binding, yaml
### output or test suite
PKG_OVERRIDESHARED=0
PKG_OVERRIDESTATIC=1
CONF_FLAGS="-Dtools=true -Dpython=disabled -Dyaml=disabled -Dvalgrind=disabled -Dtests=false"
