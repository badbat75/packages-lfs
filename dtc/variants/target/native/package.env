# dtc, target native: fdtoverlay for utilities/qemu_cmdgen (QEMU_DTBO of a platform); postbuild.sh
# leaves out libfdt, so the check also rebuilds a toolchain that got its header
PKG_CHECK="[ \"\$( ${INSTALL_EXECPREFIX}/bin/dtc --version 2>/dev/null || true )\" == \"Version: DTC ${PKG_VER}\" ] && [ -x ${INSTALL_EXECPREFIX}/bin/fdtoverlay ] && [ ! -e ${INSTALL_INCLUDEDIR}/libfdt.h ]"
