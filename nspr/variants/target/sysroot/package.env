# nspr, target sysroot
### config/nsinstall installs the headers during the build: in a cross build configure compiles it with
### HOST_CC, which defaults to CC, the compiler of the target, and it only ran through the binfmt
### entry of qemu. The compiler of the build host instead
CONF_VARS="HOST_CC=\"\${CC_FOR_BUILD}\" HOST_CFLAGS=\"\${CFLAGS_FOR_BUILD}\" HOST_LDFLAGS=\"\${LDFLAGS_FOR_BUILD}\""
