# cmake, target native
### Not the default build: the values of package.env this target keeps or drops
CONF_FLAGS=

PKG_CHECK="[ x\$( ${INSTALL_EXECPREFIX}/bin/cmake --version | awk 'NR==1{print \$3}' || true ) == x${PKG_VER} ]"
BUILD_PROCESS=custom
