# cmake
PKG_VER=4.4.3
PKG_URL="https://github.com/Kitware/CMake/releases/download/v${PKG_VER}/cmake-${PKG_VER}.tar.gz"
PKG_DEPS=
PKG_MAKETARGETS="all,install/strip"

BUILD_PROCESS=cmakebuild
### cmakebuild makes the target build a cross build for CMake: it does not install itself with the
### bin/cmake it built, and its try_run checks (kwsys, curl, libarchive) go through <HARCH>-run
CONF_FLAGS=
