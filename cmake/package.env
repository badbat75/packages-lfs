# cmake
PKG_VER=4.4.3
PKG_URL="https://github.com/Kitware/CMake/releases/download/v${PKG_VER}/cmake-${PKG_VER}.tar.gz"
PKG_DEPS=
PKG_MAKETARGETS="all,install/strip"

BUILD_PROCESS=cmakebuild
### A cross build for CMake (CMAKE_SYSTEM_NAME): otherwise, on a host of the architecture of the target
### (generic-x64), CMake installs itself with the bin/cmake it built, which runs there without the
### libraries of the sysroot. Its try_run checks (kwsys, curl, libarchive) go through qemu
CONF_FLAGS="-DCMAKE_SYSTEM_NAME=Linux -DCMAKE_SYSTEM_PROCESSOR=${HM} -DCMAKE_CROSSCOMPILING_EMULATOR=qemu-${HM}-static"
