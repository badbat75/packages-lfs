# lua
### 5.4: the Lua of the scripting of lldb (lfs/llvm:lldb, native-lldb), whose bindings need 5.3 or later
PKG_VER=5.4.9
PKG_URL="https://www.lua.org/ftp/lua-${PKG_VER}.tar.gz"
### The Makefile of Lua builds a static library only: build.sh adds the shared one, liblua.so.5.4
### (what lldb and the other programs link), and lua.pc
BUILD_PROCESS=custom
LUA_MAJVER=${PKG_VER%.*}
