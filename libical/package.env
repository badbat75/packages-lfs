# libical
PKG_VER=4.0.5
PKG_URL="https://github.com/libical/libical/releases/download/v${PKG_VER}/libical-${PKG_VER}.tar.gz"
PKG_DEPS="lfs/icu lfs/BerkeleyDB"
BUILD_PROCESS=cmakebuild
### libical 4 builds the Java bindings by default (needs a JDK) and, cross compiling, the GLib
### bindings need the ical-glib-src-generator of a native build (IMPORT_ICAL_GLIB_SRC_GENERATOR):
### both off, bluez needs the core library only
CONF_FLAGS="-DLIBICAL_GLIB=False -DLIBICAL_JAVA_BINDINGS=False"
CONF_FLAGS+=" -DLIBICAL_GOBJECT_INTROSPECTION=False -DLIBICAL_GLIB_VAPI=False"
CONF_FLAGS+=" -DLIBICAL_BUILD_TESTING=False -DLIBICAL_BUILD_DOCS=False -DLIBICAL_BUILD_EXAMPLES=False"
CONF_FLAGS+=" -DPERL_EXECUTABLE=$(which perl)"
PKG_MAKETARGETS="all,install/strip"
