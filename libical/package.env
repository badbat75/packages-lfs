# libical
PKG_VER=4.0.5
PKG_URL="https://github.com/libical/libical/releases/download/v${PKG_VER}/libical-${PKG_VER}.tar.gz"
PKG_DEPS="lfs/icu lfs/BerkeleyDB lfs/GLib lfs/libxml2 lfs/libical:cross"
BUILD_PROCESS=cmakebuild
### libical 4 builds the Java bindings by default (needs a JDK): off. The GLib bindings
### (libical-glib) are generated by ical-glib-src-generator, a program of the build that a cross
### build cannot run: the cross target builds it for the host and installs its cmake export file,
### which the target build imports. No introspection, vapi or gtk-doc documentation.
LIBICAL_COMMON_FLAGS="-DLIBICAL_GLIB=True -DLIBICAL_JAVA_BINDINGS=False"
LIBICAL_COMMON_FLAGS+=" -DLIBICAL_GOBJECT_INTROSPECTION=False -DLIBICAL_GLIB_VAPI=False -DLIBICAL_GLIB_BUILD_DOCS=False"
LIBICAL_COMMON_FLAGS+=" -DLIBICAL_BUILD_TESTING=False -DLIBICAL_BUILD_DOCS=False -DLIBICAL_BUILD_EXAMPLES=False"
LIBICAL_COMMON_FLAGS+=" -DPERL_EXECUTABLE=$(which perl)"
CONF_FLAGS="${LIBICAL_COMMON_FLAGS}"
CONF_FLAGS+=" -DIMPORT_ICAL_GLIB_SRC_GENERATOR=${CROSS_LIBDIR}/cmake/LibIcal/IcalGlibSrcGenerator.cmake"
PKG_MAKETARGETS="all,install/strip"
