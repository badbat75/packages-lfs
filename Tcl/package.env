# Tcl
PKG_VER=8.6.17
PKG_URL="https://downloads.sourceforge.net/tcl/tcl${PKG_VER}-src.tar.gz"
PKG_DEPS=
BUILD_PROCESS=configmake
CONF_PATH="unix"
CONF_FLAGS="--mandir=${INSTALL_SHAREDIR}/man"
CONF_FLAGS+=" --disable-rpath"
PKG_LDFLAGS="-lm -s"
### The stub libraries of Tcl, itcl and tdbc are static by design: with LTO they are built as fat
### objects, whose bytecode build removes (strip_lto_objects)
PKG_OVERRIDESTATIC=1

PKG_MAKETARGETS=",install,install-private-headers"

