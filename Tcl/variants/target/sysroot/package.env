# Tcl, target sysroot
### configure-packages packs the script library into libtcl (zipfs) with a tclsh of the build host: the
### one of lfs/Tcl:native, not the one just built (a program of the target) nor the one of the host
PKG_DEPS+=" lfs/Tcl:native"
CONF_ENV+=" TCLSH_NATIVE=${GLOBAL_TOOLCHAIN_PATH}/bin/tclsh${PKG_VER%.*}"
PKG_MAKEENV+=" TCLSH_NATIVE=${GLOBAL_TOOLCHAIN_PATH}/bin/tclsh${PKG_VER%.*}"
