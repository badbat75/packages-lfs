# Tcl, target native: the tclsh of the build host (the TCL bindings of SQLite run it)
PKG_CHECK="[ x$(echo 'puts [info patchlevel]' | ${GLOBAL_TOOLCHAIN_PATH}/bin/tclsh 2>/dev/null || :) == x${PKG_VER} ]"
### configure-packages runs the tclsh just built (it found a tclsh 9 of the build host in the PATH
### before): built first, alone (with parallel jobs configure-packages comes before it), and run with
### its libtcl, which is not yet where its RUNPATH looks (${PKG_BLDPATH} expanded by runmake.sh)
PKG_MAKETARGETS="binaries,${PKG_MAKETARGETS}"
PKG_MAKEENV+=' LD_LIBRARY_PATH=${PKG_BLDPATH}/unix'
