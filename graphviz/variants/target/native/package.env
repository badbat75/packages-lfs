# graphviz, target native: installed once into the global toolchain
### "dot -V" prints "dot - graphviz version <version> (<date>)" on stderr; the gd plugin writes PNG
PKG_CHECK="${INSTALL_EXECPREFIX}/bin/dot -V 2>&1 | grep -q '^dot - graphviz version ${PKG_VER} ' && echo 'digraph { a -> b }' | ${INSTALL_EXECPREFIX}/bin/dot -Tpng:gd > /dev/null 2>&1"
