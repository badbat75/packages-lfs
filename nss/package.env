# nss
PKG_VER=3.129
PKG_URL="https://archive.mozilla.org/pub/security/nss/releases/NSS_${PKG_VER//./_}_RTM/src/nss-${PKG_VER}.tar.gz"
### patches/: the BLFS standalone build patch (pkg-config file, nss-config), now version-less upstream
PKG_DEPS="lfs/zlib lfs/nspr lfs/p11-kit:bootstrap"
PKG_DEPS+=" lfs/SQLite"
BUILD_PROCESS=simplemake
PKG_MAKEVARS="-C nss OBJDIR_NAME=Release NSS_ENABLE_WERROR=0 MOZILLA_CLIENT=1 NSPR_INCLUDE_DIR=${BIN_PATH}${INSTALL_INCLUDEDIR}/nspr NSPR_LIB_DIR=${BIN_PATH}${INSTALL_LIBDIR}"
PKG_MAKEVARS+=" BUILD_OPT=1 OPTIMIZER=\"\${CFLAGS} \${CPPFLAGS}\" LDFLAGS=\"\${LDFLAGS}\" DSO_LDOPTS=\"-shared \${LDFLAGS}\" NSS_USE_SYSTEM_SQLITE=1"
PKG_MAKEVARS+=" NSS_ENABLE_ECC=1 CHECKLOC= CC=\"\${CC}\" CXX=\"\${CXX}\" CCC=\"\${CXX}\" RANLIB=\"\${RANLIB}\" OS_TEST=${HM} KERNEL=${HARCH}"
PKG_MAKETARGETS="all"
PKG_LDFLAGS="-s"

##### Issues with LLVM toolchain, please re-check in future
##### with x86_64 code.
PKG_TOOLCHAIN=gnu
PKG_MAKEVARS+=" NS_USE_GCC=1"
PKG_CFLAGS="-Wno-stringop-overflow"
## remove lines before and re-enable the code after
#case ${TOOLCHAIN} in
#    gnu)
#        PKG_MAKEVARS+=" NS_USE_GCC=1"
#        PKG_CFLAGS="-Wno-stringop-overflow"
#    ;;
#    llvm)
#    ;;
#esac
############################################################

### The targets split what the build installs (split_install in the postbuild.sh of
### variants/target/<target>): :lib the libraries (what p11-kit, make-ca and Poppler link), their
### include files, nss.pc and nss-config, :tool the certificate and key database tools (certutil,
### pk12util, modutil...: libnss3-tools of Debian). The test programs and test modules (the gtest
### suites, bltest, fipstest, libnssckbi-testlib...) are in the whole nss only, built without a
### target. The lists are paths of the image, find -path patterns (a * also matches a /)
NSS_LIBPATH=${INSTALL_LIBDIR}${INSTALL_LIBSUFFIX}
NSS_BINPATH=${INSTALL_EXECPREFIX}/bin
NSS_LIB_FILES="${NSS_LIBPATH}/libfreebl3.so ${NSS_LIBPATH}/libfreeblpriv3.so ${NSS_LIBPATH}/libnss3.so"
NSS_LIB_FILES+=" ${NSS_LIBPATH}/libnssckbi.so ${NSS_LIBPATH}/libnssdbm3.so ${NSS_LIBPATH}/libnssutil3.so"
NSS_LIB_FILES+=" ${NSS_LIBPATH}/libsmime3.so ${NSS_LIBPATH}/libsoftokn3.so ${NSS_LIBPATH}/libssl3.so"
NSS_LIB_FILES+=" ${NSS_LIBPATH}/*.a ${NSS_LIBPATH}/pkgconfig/nss.pc ${INSTALL_INCLUDEDIR}/nss/*"
NSS_LIB_FILES+=" ${INSTALL_INCLUDEDIR}/dbm/* ${NSS_BINPATH}/nss-config"
NSS_TOOL_FILES="${NSS_BINPATH}/certutil ${NSS_BINPATH}/chktest ${NSS_BINPATH}/cmsutil ${NSS_BINPATH}/crlutil"
NSS_TOOL_FILES+=" ${NSS_BINPATH}/derdump ${NSS_BINPATH}/httpserv ${NSS_BINPATH}/modutil ${NSS_BINPATH}/nss-policy-check"
NSS_TOOL_FILES+=" ${NSS_BINPATH}/ocspclnt ${NSS_BINPATH}/p7content ${NSS_BINPATH}/p7env ${NSS_BINPATH}/p7sign"
NSS_TOOL_FILES+=" ${NSS_BINPATH}/p7verify ${NSS_BINPATH}/pk12util ${NSS_BINPATH}/pk1sign ${NSS_BINPATH}/pwdecrypt"
NSS_TOOL_FILES+=" ${NSS_BINPATH}/rsaperf ${NSS_BINPATH}/selfserv ${NSS_BINPATH}/shlibsign ${NSS_BINPATH}/signtool"
NSS_TOOL_FILES+=" ${NSS_BINPATH}/signver ${NSS_BINPATH}/ssltap ${NSS_BINPATH}/strsclnt ${NSS_BINPATH}/symkeyutil"
NSS_TOOL_FILES+=" ${NSS_BINPATH}/tstclnt ${NSS_BINPATH}/validation ${NSS_BINPATH}/vfychain ${NSS_BINPATH}/vfyserv"
