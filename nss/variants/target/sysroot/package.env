# nss, target sysroot
### coreconf/nsinstall installs the headers during the build: it is compiled with CC, the compiler of
### the target, which the command line gives to every directory (NATIVE_CC cannot replace it), so it
### runs through <HARCH>-run; $(...) is expanded by make (single quotes: \$ reaches runmake.sh)
PKG_MAKEVARS+=' NSINSTALL="${HARCH}-run \$(NSINSTALL_DIR)/\$(OBJDIR_NAME)/nsinstall"'
