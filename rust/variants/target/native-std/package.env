# rust, target native-std: the standard library of the platform into the Rust of the build machine, what
# the cross builds of cargo (--target, cargo_target) link
### Not the default build: the values of target/native this target keeps or drops
PKG_DEPS="lfs/rust:native"
RUST_TARGET=$( cargo_target )
PKG_URL="https://static.rust-lang.org/dist/rust-std-${PKG_VER}-${RUST_TARGET}.tar.xz"
PKG_SRCDIR=rust-std_${PKG_VER}-${RUST_TARGET}
RUST_COMPONENTS="rust-std-${RUST_TARGET}"
PKG_CHECK="[ -d ${INSTALL_LIBDIR}/rustlib/${RUST_TARGET}/lib ]"
