# rust, target native: rustc, cargo and rustfmt of the build machine, with its standard library, in
# ${GLOBAL_TOOLCHAIN_PATH}/rust-<version> (setup_rust puts its bin in the PATH); native-std starts from
# here too
INSTALL_PREFIX=${GLOBAL_TOOLCHAIN_PATH}/rust-${PKG_VER}
INSTALL_EXECPREFIX=${INSTALL_PREFIX}
INSTALL_LIBDIR=${INSTALL_PREFIX}/lib
INSTALL_INCLUDEDIR=${INSTALL_PREFIX}/include
INSTALL_SYSCONFDIR=${INSTALL_PREFIX}/etc
INSTALL_SHAREDIR=${INSTALL_PREFIX}/share
RUST_TARGET=$( cargo_target build )
PKG_URL="https://static.rust-lang.org/dist/rust-${PKG_VER}-${RUST_TARGET}.tar.xz"
PKG_SRCDIR=rust_${PKG_VER}-${RUST_TARGET}
RUST_COMPONENTS="rustc,cargo,rustfmt-preview,rust-std-${RUST_TARGET}"
### "rustc --version" prints "rustc <version> (<commit> <date>)"
PKG_CHECK="[ \"\$( ${INSTALL_EXECPREFIX}/bin/rustc --version 2>/dev/null | awk '{print \$2}' )\" == ${PKG_VER} ] && [ -x ${INSTALL_EXECPREFIX}/bin/cargo ]"
### Nothing compiled, and setup_rust comes before every compiler of the framework
PKG_TOOLCHAIN=gnu
