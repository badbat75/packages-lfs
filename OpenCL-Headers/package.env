# OpenCL-Headers
### The Khronos OpenCL C headers, for lfs/OpenCL-ICD-Loader and the programs linked with it
PKG_VER=2026.05.29
PKG_URL="https://github.com/KhronosGroup/OpenCL-Headers/archive/refs/tags/v${PKG_VER}.tar.gz"
BUILD_PROCESS=cmakebuild
### A top level project includes CTest: its tests would be built by the install target
CONF_FLAGS="-DBUILD_TESTING=OFF"
PKG_MAKETARGETS=install
