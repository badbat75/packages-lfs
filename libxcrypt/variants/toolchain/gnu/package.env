# libxcrypt, gnu toolchain: gcc 16 links every object against libatomic through its
# libatomic_asneeded.so linker script, a gcc target library that setup_gcc builds after libxcrypt.
# The option travels in CC: libtool drops an unknown -f flag of LDFLAGS when it links a library,
# while it records the configure-time CC, flags included, for every link
if [ "$( package_version lfs/gcc:cross | cut -d. -f1 )" -ge 16 ]
then
	CONF_VARS+=' CC="${CC} -fno-link-libatomic"'
fi
