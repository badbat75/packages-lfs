# libxcrypt, target native: libcrypt of the build host, for the chpasswd of lfs/shadow:native, which
# hashes the passwords of the image with yescrypt
PKG_CHECK="[ \"$(PKG_CONFIG_LIBDIR=${INSTALL_LIBDIR}/pkgconfig pkg-config --modver libxcrypt 2>/dev/null || :)\" == \"${PKG_VER}\" ]"
### Built with gcc: the symbol versions of libcrypt.so do not survive ld.lld ("version script
### assignment of 'XCRYPT_2.0' to symbol 'crypt' failed: symbol not defined")
PKG_TOOLCHAIN=gnu
