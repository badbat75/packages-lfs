# make-ca
PKG_VER=1.8.1
PKG_URL="https://github.com/djlucas/make-ca/archive/refs/tags/v${PKG_VER}.tar.gz"
PKG_DEPS="lfs/openssl:native lfs/p11-kit"
PKG_DEPS+=" lfs/nss"
### certdata.txt download: hg.mozilla.org only redirects now and the server rejects the
### HTTP/0.9 request of 1.8.1; the patch takes the URL and request format of make-ca 1.16.1
PATCHES=make-ca-1.8.1-hg-edge-http11.patch
BUILD_PROCESS=simplemake
PKG_MAKETARGETS="install"
