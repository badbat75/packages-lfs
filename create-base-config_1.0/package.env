BUILD_PROCESS=none
####### Basic configuration files ##########

PKG_TOOLCHAIN=gnu

### The version of the system in /etc/os-release, /etc/lsb-release and /etc/lfs-release (the banner of
### the login prompt): OS_VERSION of the project, else the version of bbxb that builds it
OS_VERSION=${OS_VERSION:-$(git -C "${BB_HOME}" describe --tags --always 2>/dev/null || date +%Y%m%d)}
