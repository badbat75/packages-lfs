# systemd, target bootstrap: the minimal systemd that breaks the dependency cycles (no pam, dbus,
# audit...). Composed from the common part of package.env, not from the full build.
LIBAUDIT_TARGET=bootstrap
PKG_DEPS="${SYSTEMD_COMMON_DEPS} lfs/libcap2:bootstrap"
CONF_FLAGS="${SYSTEMD_COMMON_FLAGS}"
### (feature options: disabled, not false, since v261; coredump is still a boolean)
CONF_FLAGS+=" -Daudit=disabled"
CONF_FLAGS+=" -Ddbus=disabled"
CONF_FLAGS+=" -Dcoredump=false"
CONF_FLAGS+=" -Delfutils=disabled"
CONF_FLAGS+=" -Dlibidn2=disabled"
CONF_FLAGS+=" -Dlibiptc=disabled"
CONF_FLAGS+=" -Dlibcurl=disabled"
CONF_FLAGS+=" -Dimportd=disabled"
CONF_FLAGS+=" -Dmicrohttpd=disabled"
CONF_FLAGS+=" -Dopenssl=disabled"
CONF_FLAGS+=" -Dpam=disabled"
CONF_FLAGS+=" -Dpcre2=disabled"
CONF_FLAGS+=" -Dtpm2=disabled"
PKG_POSTINSTALL_PRIO=
