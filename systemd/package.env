# systemd
PKG_VER=261.3
### Since v256 the stable releases are tagged in the main repository (systemd-stable is frozen)
PKG_URL="https://github.com/systemd/systemd/archive/refs/tags/v${PKG_VER}.tar.gz"
BUILD_PROCESS=mesonninja
### Dependencies and meson options shared by the full build below and by systemd:bootstrap
### (variants/target/bootstrap, the minimal systemd that breaks the dependency cycles)
SYSTEMD_COMMON_DEPS="lfs/flex:native lfs/zlib lfs/xz lfs/bzip2 lfs/zstd lfs/libxml2:bootstrap"
### (split-usr, rootlibdir and nscd are gone since v256: the root filesystem is merged-usr)
SYSTEMD_COMMON_FLAGS="-Dfirstboot=false"
SYSTEMD_COMMON_FLAGS+=" -Dtests=false"
SYSTEMD_COMMON_FLAGS+=" -Dslow-tests=false"
SYSTEMD_COMMON_FLAGS+=" -Dfuzz-tests=false"
SYSTEMD_COMMON_FLAGS+=" -Dinstall-tests=false"
SYSTEMD_COMMON_FLAGS+=" -Dldconfig=false"
SYSTEMD_COMMON_FLAGS+=" -Drpmmacrosdir=no"
### The image keeps /usr/sbin apart from /usr/bin. split-bin=auto looks at /usr/sbin of the build
### host instead, a link to bin in the Fedora container: systemd then called /usr/bin/agetty,
### /usr/bin/sulogin and the other tools util-linux installs in /usr/sbin, and no getty started
SYSTEMD_COMMON_FLAGS+=" -Dsplit-bin=true"
### (feature options take enabled, disabled or auto since v261; true and false are deprecated;
### homed, sysupdate and userdb are decided per build: the full one below, the bootstrap variant)
SYSTEMD_COMMON_FLAGS+=" -Dmode=release"
SYSTEMD_COMMON_FLAGS+=" -Dservice-watchdog="
SYSTEMD_COMMON_FLAGS+=" -Dstandalone-binaries=true"
SYSTEMD_COMMON_FLAGS+=" -Ddefault-kill-user-processes=false"
SYSTEMD_COMMON_FLAGS+=" -Dfirst-boot-full-preset=true"
SYSTEMD_COMMON_FLAGS+=" -Ddns-servers="
SYSTEMD_COMMON_FLAGS+=" -Ddefault-dnssec=no"
SYSTEMD_COMMON_FLAGS+=" -Ddefault-dns-over-tls=no"
SYSTEMD_COMMON_FLAGS+=" -Ddefault-mdns=no"
SYSTEMD_COMMON_FLAGS+=" -Ddefault-llmnr=resolve"
### To be tested
SYSTEMD_COMMON_FLAGS+=" -Dnss-myhostname=true"
SYSTEMD_COMMON_FLAGS+=" -Dnss-mymachines=enabled"
SYSTEMD_COMMON_FLAGS+=" -Dnss-resolve=enabled"
SYSTEMD_COMMON_FLAGS+=" -Dnss-systemd=true"
SYSTEMD_COMMON_FLAGS+=" -Doomd=true"
###
PKG_CFLAGS="-Wno-error=return-type"
### Python modules does not pass sysroot flags...
#PKG_FAULTYCFLAGS=1

### The full systemd, built on top of systemd:bootstrap (the EFI stub is added by
### variants/target/default/arch/, the linker settings by variants/toolchain/; its postbuild.sh
### and postinstall.sh are in variants/target/default, the bootstrap build has none)
PKG_DEPS="${SYSTEMD_COMMON_DEPS} lfs/systemd:bootstrap"
PKG_DEPS+=" lfs/libcap2 lfs/libaudit lfs/openssl lfs/Linux-PAM lfs/polkit lfs/GLib lfs/kmod lfs/util-linux"
PKG_DEPS+=" lfs/acl lfs/libxcrypt"
### Optional packages
PKG_DEPS+=" lfs/gnutls"
PKG_DEPS+=" lfs/btrfs-progs"
PKG_DEPS+=" lfs/curl"
PKG_DEPS+=" lfs/cryptsetup"
PKG_DEPS+=" lfs/elfutils"
PKG_DEPS+=" lfs/libgcrypt"
#PKG_DEPS+=" lfs/libidn"
PKG_DEPS+=" lfs/libidn2"
PKG_DEPS+=" lfs/libmicrohttpd"
PKG_DEPS+=" lfs/libpwquality"
PKG_DEPS+=" lfs/libseccomp"
PKG_DEPS+=" lfs/libxkbcommon"
PKG_DEPS+=" lfs/lz4"
PKG_DEPS+=" lfs/make-ca"
PKG_DEPS+=" lfs/p11-kit"
PKG_DEPS+=" lfs/pcre2"
PKG_DEPS+=" lfs/quota-tools"
PKG_DEPS+=" lfs/libbpf"
PKG_DEPS+=" lfs/iptables"
PKG_DEPS+=" lfs/qrencode"
PKG_DEPS+=" lfs/libfido2"
PKG_DEPS+=" lfs/tpm2-tss"
PKG_DEPS+=" lfs/kexec-tools"
PKG_DEPS+=" lfs/rsync"
###
CONF_FLAGS="${SYSTEMD_COMMON_FLAGS}"
### Every feature whose dependency the project builds is enabled (auto would silently drop one the
### cross build fails to detect). Without a recipe or host tool here, left at their default: selinux,
### apparmor, passwdqc, xenctrl, libarchive, bootloader (sd-boot wants pyelftools), ukify (pefile)
### and bpf-framework (bpftool and a bpf clang). homed needs userdb.
CONF_FLAGS+=" -Dman=auto"
### systemd-sysusers, which LFS leaves out: the systemd-journald module of dracut requires it, and
### without it dracut drops systemd-initrd and dracut-systemd too; /init of the initramfs then had
### no initrd.target and no rescue.service, and systemd froze
CONF_FLAGS+=" -Dsysusers=true"
CONF_FLAGS+=" -Dhomed=enabled -Dsysupdate=enabled -Duserdb=true"
CONF_FLAGS+=" -Drepart=enabled -Dimportd=enabled -Dremote=enabled -Dimds=enabled -Dnspawn=enabled -Dvmspawn=enabled"
CONF_FLAGS+=" -Dseccomp=enabled -Dpolkit=enabled -Dacl=enabled -Daudit=enabled -Dpam=enabled -Dkmod=enabled"
CONF_FLAGS+=" -Dblkid=enabled -Dfdisk=enabled -Dlibmount=enabled"
CONF_FLAGS+=" -Dpwquality=enabled -Dlibcrypt=enabled -Dlibcryptsetup=enabled -Dlibcryptsetup-plugins=enabled"
CONF_FLAGS+=" -Dlibcurl=enabled -Dlibidn2=enabled -Dmicrohttpd=enabled -Dqrencode=enabled"
CONF_FLAGS+=" -Dgcrypt=enabled -Dgnutls=enabled -Dopenssl=enabled -Dp11kit=enabled -Dlibfido2=enabled -Dtpm2=enabled"
CONF_FLAGS+=" -Delfutils=enabled -Dzlib=enabled -Dbzip2=enabled -Dxz=enabled -Dlz4=enabled -Dzstd=enabled"
CONF_FLAGS+=" -Dxkbcommon=enabled -Dpcre2=enabled -Dglib=enabled -Ddbus=enabled"
CONF_FLAGS+=" -Dpamlibdir=${INSTALL_LIBDIR}${INSTALL_LIBSUFFIX}/security"
CONF_FLAGS+=" -Dpamconfdir=${INSTALL_SYSCONFDIR}/pam.d"
CONF_FLAGS+=" -Ddbussystemservicedir=${INSTALL_SHAREDIR}/dbus-1/system-services"
CONF_FLAGS+=" -Ddbussessionservicedir=${INSTALL_SHAREDIR}/dbus-1/services"
CONF_FLAGS+=" -Ddbuspolicydir=${INSTALL_SHAREDIR}/dbus-1/system.d"
CONF_FLAGS+=" -Ddbus-interfaces-dir=${INSTALL_SHAREDIR}/dbus-1/interfaces"
CONF_FLAGS+=" -Dbashcompletiondir=${INSTALL_SHAREDIR}/bash-completion/completions/"
CONF_FLAGS+=" -Dquotaon-path=${INSTALL_EXECPREFIX}/sbin/quotaon"
CONF_FLAGS+=" -Dquotacheck-path=${INSTALL_EXECPREFIX}/sbin/quotacheck"
CONF_FLAGS+=" -Dkexec-path=${INSTALL_EXECPREFIX}/sbin/kexec"
PKG_POSTINSTALL_PRIO="10"
