# wpa_supplicant, target native: wpa_passphrase alone, which derives the WPA key of the WiFi
### configuration of projects/lfs.prj. The internal crypto of wpa_supplicant (SHA-1, PBKDF2,
### libtommath built in, prebuild.sh) links nothing but libc, so no dependency
PKG_DEPS=
PKG_MAKETARGETS="wpa_passphrase"
PKG_CFLAGS=
### wpa_passphrase has no version option: the check derives the key of the IEEE 802.11i test vector
PKG_CHECK="[ x\$( echo password | ${INSTALL_EXECPREFIX}/bin/wpa_passphrase IEEE 2>/dev/null | sed -n 's/^[[:space:]]*psk=//p' || true ) == xf42c6fc52df0ebef9ebb4b90b38a5f902e83fe1b135a70e23aed762e9710a12e ]"
