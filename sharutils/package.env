# sharutils
PKG_VER=4.15.2
PKG_URL="https://ftp.gnu.org/gnu/sharutils/sharutils-${PKG_VER}.tar.xz"
PKG_DEPS="lfs/bison:native lfs/flex:native"
BUILD_PROCESS=configmake
CONF_FLAGS=""
### libopts/compat/compat.h defines its own bool with "false" and "true", keywords since C23,
### the default of gcc 15 and later
PKG_CFLAGS="-std=gnu17"
PKG_MAKETARGETS="all,install-strip"
