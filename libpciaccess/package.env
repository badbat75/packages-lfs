# libpciaccess
PKG_VER=0.19
PKG_URL="https://www.x.org/archive/individual/lib/libpciaccess-${PKG_VER}.tar.xz"
### Since 0.18 libpciaccess builds with meson only (no configure); pci.ids stays in share/hwdata
### (the default of the pci-ids option) and zlib reads the compressed one
PKG_DEPS="lfs/zlib"
BUILD_PROCESS=mesonninja
CONF_FLAGS="-Dzlib=enabled"
