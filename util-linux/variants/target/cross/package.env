# util-linux, target cross: only libuuid and libblkid with their headers, for the platform toolchain
### Not the default build: the values of package.env this target keeps or drops
PKG_DEPS="lfs/bison:native lfs/gettext:cross"

CONF_FLAGS=" --disable-liblastlog2"
PKG_MAKETARGETS="libuuid.la,libblkid.la,install-nodist_blkidincHEADERS,install-uuidincHEADERS"
