# util-linux, target native: libuuid and libblkid alone, for the uuid module of the native Python
# (setup_python) and lfs/btrfs-progs:native, instead of the libraries of the build host
### Not the default build: the values of package.env this target keeps or drops
PKG_DEPS="lfs/bison:native"
CONF_FLAGS="--disable-all-programs --enable-libuuid --enable-libblkid --disable-nls --disable-liblastlog2 \
            --without-systemd --without-python --without-tinfo --without-ncursesw --without-readline"
CONF_VARS=
### configure made by smart_autoreconf with the autotools of the global toolchain (prebuild.sh of the
### recipe runs the autoreconf of autoconf:cross, which setup_python comes before)
PKG_AUTOCONF=1
PKG_MAKEVARS=
PKG_CHECK="grep -qx 'Version: ${PKG_VER}' ${GLOBAL_TOOLCHAIN_PATH}/lib/pkgconfig/uuid.pc && grep -qx 'Version: ${PKG_VER}' ${GLOBAL_TOOLCHAIN_PATH}/lib/pkgconfig/blkid.pc"
