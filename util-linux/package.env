# util-linux
PKG_VER=2.42.4
PKG_URL="https://github.com/util-linux/util-linux/archive/refs/tags/v${PKG_VER}.tar.gz"
PKG_DEPS="lfs/bison:native lfs/gettext:cross"
BUILD_PROCESS=configmake
#PKG_AUTOCONF=1
CONF_FLAGS="ADJTIME_PATH=/var/lib/hwclock/adjtime \
            --with-systemdsystemunitdir=/lib/systemd/system \
            --disable-chfn-chsh \
            --disable-login \
            --disable-nologin \
            --disable-su \
            --disable-setpriv \
            --disable-runuser \
            --disable-pylibmount \
            --disable-makeinstall-chown \
            --without-tinfo"
### configure takes tmpfilesdir from systemd.pc, which does not exist yet (systemd depends on
### util-linux): lastlog2.conf, the tmpfiles line that creates /var/lib/lastlog, was not installed
### and lastlog2-import.service failed at every boot
CONF_FLAGS+=" --with-tmpfilesdir=${INSTALL_PREFIX}/lib/tmpfiles.d"
CONF_VARS="ADJTIME_PATH=/var/lib/hwclock/adjtime runstatedir=/run"
PKG_MAKEVARS="NCURSES_LIBS=-lncurses"
PKG_DEPS+=" lfs/zlib lfs/bzip2 lfs/ncurses lfs/readline lfs/SQLite"
PKG_DEPS+=" lfs/util-linux:cross"
### systemd:bootstrap, the minimal systemd that breaks the dependency cycles, gives configure the
### libsystemd.pc and systemd.pc it looks for: with them found, HAVE_SYSTEMD installs
### fstrim.service and fstrim.timer, uuidd.service and uuidd.socket and lastlog2-import.service.
### The bootstrap depends on no util-linux, so the cycle with the full systemd (which depends on
### this package) does not close
PKG_DEPS+=" lfs/systemd:bootstrap"
### The cross build (libuuid and libblkid only) is variants/target/cross, the warning flags of
### each toolchain are in variants/toolchain/

#PKG_TOOLCHAIN=gnu
