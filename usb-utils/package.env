# usb-utils
PKG_VER=019
PKG_URL="https://www.kernel.org/pub/linux/utils/usb/usbutils/usbutils-${PKG_VER}.tar.xz"
### Since 017 usbutils builds with meson only (no configure) and reads the USB IDs from the udev
### hwdb through libudev: no usb.ids file to install any more
PKG_DEPS="lfs/libusb lfs/systemd"
BUILD_PROCESS=mesonninja
