# libspectre
PKG_VER=0.2.12
PKG_URL="http://libspectre.freedesktop.org/releases/libspectre-${PKG_VER}.tar.gz"
PKG_DEPS="lfs/ghostscript"
BUILD_PROCESS=configmake
PKG_AUTOCONF=1
PKG_MAKETARGETS=",install"
# ac_cv_prog_cc_c23: autoconf adds the option of the newest standard the compiler knows to CC, and the
# sources are older: libspectre/ps.c defines its functions with an identifier list, which C23 removed.
# gcc still takes them with a warning, clang does not; the next probe of configure answers C11
CONF_VARS="ac_cv_prog_cc_c23=no"

PKG_COPYSRC=1