# Cairo
PKG_VER=1.18.4
### The GNOME mirror stops at the 1.17 development series; the releases live on cairographics.org
PKG_URL="https://www.cairographics.org/releases/cairo-${PKG_VER}.tar.xz"
PKG_DEPS="lfs/libpng lfs/Pixman lfs/fontconfig lfs/GLib lfs/libX11 lfs/libXrender lfs/libxcb"
### Since 1.18 cairo builds with meson only and the xml, gl/glesv3, drm, qt, cogl, directfb and skia
### backends are gone: the meson features replace the old --enable flags (tee, xlib-xcb)
BUILD_PROCESS=mesonninja
CONF_FLAGS="-Dpng=enabled -Dzlib=enabled -Dfontconfig=enabled -Dfreetype=enabled -Dglib=enabled"
CONF_FLAGS+=" -Dxlib=enabled -Dxcb=enabled -Dxlib-xcb=enabled"
### The symbol lookup of the debug utilities links libbfd of the sysroot binutils: off
CONF_FLAGS+=" -Dsymbol-lookup=disabled -Dgtk_doc=false"

PKG_CFLAGS="-Wno-enum-conversion"

#PKG_DEPS+=" lfs/Cogl"
PKG_DEPS+=" lfs/ghostscript"
#PKG_DEPS+=" lfs/GTK+"
#PKG_DEPS+=" lfs/GTK+2"
#PKG_DEPS+=" lfs/GTK-Doc"
PKG_DEPS+=" lfs/librsvg"
PKG_DEPS+=" lfs/lzo"
PKG_DEPS+=" lfs/Poppler"
#PKG_DEPS+=" lfs/Qt"
#PKG_DEPS+=" lfs/Qt4"
#PKG_DEPS+=" lfs/Valgrind"
#PKG_DEPS+=" lfs/DirectFB"
PKG_DEPS+=" lfs/jbig2dec"
PKG_DEPS+=" lfs/libspectre"
#PKG_DEPS+=" lfs/Skia"
CONF_FLAGS+=" -Dtee=enabled -Dlzo=enabled -Dspectre=enabled"
