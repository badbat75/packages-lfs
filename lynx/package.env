# lynx: the text web browser
### A tool of the build machine (lfs/lynx:native): the text README of lfs/libdaemon is the dump of its
### README.html (lynx --dump)
PKG_VER=2.9.3
PKG_URL="https://invisible-mirror.net/archives/lynx/tarballs/lynx${PKG_VER}.tar.bz2"
PKG_DEPS="lfs/ncurses"
BUILD_PROCESS=configmake
CONF_FLAGS="--with-screen=ncursesw --without-ssl --disable-nls --sysconfdir=${INSTALL_SYSCONFDIR}/lynx"
PKG_MAKETARGETS="all,install"
