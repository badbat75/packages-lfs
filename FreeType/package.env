# FreeType
PKG_VER=2.14.3
PKG_URL="https://downloads.sourceforge.net/freetype/freetype-${PKG_VER}.tar.xz"
PKG_DEPS="lfs/libpng lfs/which lfs/bzip2 lfs/zlib"
BUILD_PROCESS=mesonninja
CONF_FLAGS=""
#PKG_MAKETARGETS="all,install"

### HarfBuzz without introspection: the full one needs the full GLib, which reaches FreeType through
### D-Bus, libX11 and fontconfig
PKG_DEPS+=" lfs/HarfBuzz:bootstrap lfs/brotli lfs/python3"
