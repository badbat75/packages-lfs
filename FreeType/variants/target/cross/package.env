# FreeType, target cross: the FreeType of the build machine, for the programs a build runs there (the
# build-time grub-mkfont of lfs/GRUB, which makes the unicode.pf2 font of the image). Only its own
# code: no library of the sysroot, the zlib of its sources
PKG_DEPS=
CONF_FLAGS="-Dzlib=internal -Dbzip2=disabled -Dpng=disabled -Dharfbuzz=disabled -Dbrotli=disabled -Dtests=disabled"
### Static only: the programs that link it run from their build tree, with no RUNPATH to the toolchain
PKG_OVERRIDESHARED=0
PKG_OVERRIDESTATIC=1
