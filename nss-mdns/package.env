# nss-mdns
PKG_VER=0.15.1
PKG_URL="https://github.com/avahi/nss-mdns/releases/download/v${PKG_VER}/nss-mdns-${PKG_VER}.tar.gz"
### The modules ask avahi-daemon over its socket: without it they resolve nothing
PKG_DEPS="lfs/Avahi"
BUILD_PROCESS=configmake
### The ltmain.sh of the release (libtool 2.4.6) drops -fuse-ld from the link of the modules: clang
### then linked with ld.bfd, which rejects the --thinlto-jobs of lld. autoreconf brings the libtool
### of the toolchain
PKG_AUTOCONF=1
### The socket where lfs/Avahi puts it (the default, ${runstatedir}, is /var/run). The tests want check
CONF_FLAGS="AVAHI_SOCKET=/run/avahi-daemon/socket --disable-tests"
PKG_MAKETARGETS="all,install-strip"
