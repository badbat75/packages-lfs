# xz, target native: liblzma of the _lzma module of the native Python (setup_python), instead of the one
# of the build host
PKG_DEPS=
CONF_FLAGS="--disable-nls --disable-doc"
PKG_CHECK="grep -qx 'Version: ${PKG_VER}' ${INSTALL_LIBDIR}/pkgconfig/liblzma.pc"
### Built by the gnu toolchain: lfs/llvm:native depends on it, there is no clang before that
PKG_TOOLCHAIN=gnu
