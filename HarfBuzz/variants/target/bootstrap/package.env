# HarfBuzz, target bootstrap: the library alone, for lfs/FreeType
### Not the default build: the values of package.env this target keeps or drops
### No introspection: HarfBuzz-0.0.gir includes GObject-2.0.gir, which only the full lfs/GLib installs,
### and GLib depends on D-Bus, which reaches FreeType (libX11, fontconfig): the full HarfBuzz comes
### later, for the packages that want it
PKG_DEPS="lfs/GLib:bootstrap lfs/icu lfs/FreeType:bootstrap lfs/Graphite2:bootstrap"
CONF_FLAGS="-Dintrospection=disabled -Dtests=disabled"
