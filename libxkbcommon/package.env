# libxkbcommon
PKG_VER=1.13.2
PKG_URL="https://github.com/xkbcommon/libxkbcommon/archive/refs/tags/xkbcommon-${PKG_VER}.tar.gz"
PKG_DEPS="lfs/bison:native lfs/flex:native lfs/doxygen:native lfs/xkeyboard-config lfs/libxcb"
PKG_DEPS+=" lfs/wayland lfs/wayland-protocols"
### The wayland-scanner the build runs (native: true, build.pkg_config_path of mesonninja)
PKG_DEPS+=" lfs/wayland:cross"
BUILD_PROCESS=mesonninja
CONF_FLAGS="-Denable-wayland=true"
CONF_FLAGS+=" -Dxkb-config-extra-path=${INSTALL_SHAREDIR}/X11/xkb"
#PKG_MAKETARGETS="all,install"
