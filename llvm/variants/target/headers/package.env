# llvm, target headers: install only the headers, with the per-component targets of the LLVM
### cmake build: the LLVM headers (include/llvm, include/llvm-c, the generated ones too), the
### clang headers (include/clang, include/clang-c: the API, not the builtin headers) and the
### OpenCL resource headers of clang (lib/clang/<major>/include/opencl-c.h, opencl-c-base.h,
### which Mesa bundles into rusticl). They depend on the tablegen targets only: on a tree
### without the libraries this flavor builds in minutes. The libraries are lfs/llvm:libs
PKG_MAKETARGETS="install-llvm-headers-stripped,install-clang-headers-stripped,install-opencl-resource-headers-stripped"
