# llvm, target compiler-rt: the profile runtime of the clang of the platform toolchain, what clang links
# for --coverage and -fprofile-* (libclang_rt.profile.a in the resource directory of lfs/llvm:native,
# under the normalized triple of the target, which the clang of the platform toolchain shares through
# its lib link). Only that part: the runtime library of every build is libgcc (CLANG_DEFAULT_RTLIB),
# and clang asks for the builtins, the sanitizers and the rest of compiler-rt only when a build names
# them. Built in the sources of the package (postbuild.sh); nothing goes into the sysroot
### Not the default build: the values of package.env this target keeps or drops
PKG_DEPS="lfs/llvm:native"
BUILD_PROCESS=none
### The library in the resource directory of the global clang: a new lfs/llvm:native has none
PKG_CHECK="[ -f \"\$( ${GLOBAL_TOOLCHAIN_PATH}/llvm-${PKG_VER}/bin/clang -print-resource-dir )/lib/\$( ${GLOBAL_TOOLCHAIN_PATH}/llvm-${PKG_VER}/bin/clang --target=${HARCH} -dumpmachine )/libclang_rt.profile.a\" ]"
