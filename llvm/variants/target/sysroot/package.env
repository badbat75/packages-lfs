# llvm, target sysroot (default, libllvm, headers, sources): the flavors pass identical
### configuration flags and prefixes, so they share one build directory (no target suffix),
### reused by every build of the package: PKG_KEEPBUILDDIR keeps the sources (no re-extract,
### no re-patch) and the build tree, the cmake/ninja build stays incremental and libllvm,
### headers and the full suite compile LLVM only once. native keeps its own directory: a
### different toolchain environment, only llvm-tblgen
PKG_BLDPATH=${BLD_PATH}/${PKG_FULLNAME}
PKG_KEEPBUILDDIR=1
