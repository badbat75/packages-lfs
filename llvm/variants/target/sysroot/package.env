# llvm, target sysroot (default, llvm-libs, headers, sources): the flavors pass identical
### configuration flags and prefixes, so they share one build directory (no target suffix),
### reused by every build of the package: PKG_KEEPBUILDDIR keeps the sources (no re-extract,
### no re-patch) and the build tree, the cmake/ninja build stays incremental and llvm-libs,
### headers and the full suite compile LLVM only once
PKG_BLDPATH=${BLD_PATH}/${PKG_FULLNAME}
PKG_KEEPBUILDDIR=1

### A cross build: the machine of the image, the plugin header of the binutils of the sysroot
CONF_FLAGS+=" -DLLVM_HOST_TRIPLE=${HARCH}"
CONF_FLAGS+=" -DLLVM_BINUTILS_INCDIR:FILEPATH=\"\${SYSROOT}/usr/include\""
CONF_FLAGS+=" -DLLVM_LIBDIR_SUFFIX:STRING=${HARCH_LIB}${INSTALL_LIBSUFFIX}"
### The programs the build runs are the ones of the global LLVM (lfs/llvm:native, the same version):
### the tablegens of llvm, clang and lldb, clang-tidy-confusable-chars-gen, which the NATIVE subbuild
### would make with the compiler of the build host otherwise. llvm-min-tblgen, the tablegen of the
### LLVM headers, is not installed: without LLVM_TABLEGEN, which LLVM reflects on it, the NATIVE
### subbuild makes one (on another machine it does not run, and it links the libraries of the host)
CONF_FLAGS+=" -DLLVM_NATIVE_TOOL_DIR=${GLOBAL_TOOLCHAIN_PATH}/llvm-${LLVM_VER}/bin"
CONF_FLAGS+=" -DLLVM_TABLEGEN:FILEPATH=${GLOBAL_TOOLCHAIN_PATH}/llvm-${LLVM_VER}/bin/llvm-tblgen"
PKG_DEPS+=" lfs/llvm:native"
