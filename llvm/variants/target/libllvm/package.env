# llvm, target libllvm: install only the libraries Mesa links, with the per-component
### targets of the LLVM cmake build (each a `cmake -DCMAKE_INSTALL_COMPONENT=<x>` run,
### the -stripped ones with -DCMAKE_INSTALL_DO_STRIP=1): llvm-config, the LLVM libraries
### (the libLLVM dylib and the statics), the clang libraries and the cmake config of
### lib/cmake/llvm. The headers are lfs/llvm:headers. Replaces install/strip plus the prune
### of the postbuild, which never installed what is not needed
PKG_MAKETARGETS="install-llvm-libraries-stripped,install-clang-libraries-stripped,install-cmake-exports-stripped,install-llvm-config-stripped"
