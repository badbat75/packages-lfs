# llvm, target lldb: the lldb of the image, with the scripting in python (lfs/python3) and in lua
# (lfs/lua), a standalone build of its sources over the LLVM and clang of the image (lfs/llvm), with the
# tablegens of the global LLVM (lfs/llvm:native, native-lldb)
### Not the default build: the values of package.env and target/sysroot this target keeps or drops
### A build directory of its own: the one of target/sysroot is the LLVM of the other targets
PKG_BLDPATH=${BLD_PATH}/${PKG_FULLNAME}-lldb
PKG_DEPS="lfs/llvm lfs/llvm:native-lldb lfs/python3 lfs/lua lfs/lua:native ${LLDB_DEPS}"
CONF_FLAGS="-S\${PKG_SRCPATH}/lldb ${LLDB_FLAGS}"
CONF_FLAGS+=" -DLLVM_HOST_TRIPLE=${HARCH} -DLLVM_LIBDIR_SUFFIX:STRING=${HARCH_LIB}${INSTALL_LIBSUFFIX}"
LLDB_CMAKEDIR=${INSTALL_LIBDIR}${INSTALL_LIBSUFFIX}/cmake
CONF_FLAGS+=' -DLLVM_DIR=${SYSROOT}'"${LLDB_CMAKEDIR}/llvm"' -DClang_DIR=${SYSROOT}'"${LLDB_CMAKEDIR}/clang"
CONF_FLAGS+=" -DLLVM_TABLEGEN=${GLOBAL_TOOLCHAIN_PATH}/llvm-${PKG_VER}/bin/llvm-tblgen"
CONF_FLAGS+=" -DLLDB_TABLEGEN_EXE=${GLOBAL_TOOLCHAIN_PATH}/llvm-${PKG_VER}/bin/lldb-tblgen"
### The python of the image: its headers and library, the python of the build machine for the scripts
### of the build; the three values lldb reads from it on the machine it runs on
CONF_FLAGS+=" -DPython3_EXECUTABLE=${PYTHON_FOR_BUILD}"
CONF_FLAGS+=' -DPython3_INCLUDE_DIR=${SYSROOT}'"${INSTALL_INCLUDEDIR}/python${PYTHONBIN_VER}"
CONF_FLAGS+=' -DPython3_LIBRARY=${SYSROOT}'"${INSTALL_LIBDIR}${INSTALL_LIBSUFFIX}/libpython${PYTHONBIN_VER}.so"
CONF_FLAGS+=" -DLLDB_PYTHON_RELATIVE_PATH=lib/python${PYTHONBIN_VER}/site-packages"
CONF_FLAGS+=" -DLLDB_PYTHON_EXE_RELATIVE_PATH=bin/python${PYTHONBIN_VER}"
CONF_FLAGS+=" -DLLDB_PYTHON_EXT_SUFFIX=.cpython-${PYTHONBIN_VER/./}-${HARCH}.so"
### The lua of the image, its version the one of the lua of the build machine
CONF_FLAGS+=' -DLUA_INCLUDE_DIR=${SYSROOT}'"${INSTALL_INCLUDEDIR}"' -DLUA_LIBRARIES=${SYSROOT}'"${INSTALL_LIBDIR}${INSTALL_LIBSUFFIX}/liblua.so"
CONF_FLAGS+=" -DLUA_EXECUTABLE=${GLOBAL_TOOLCHAIN_PATH}/bin/lua -DLUA_VERSION_MAJOR=5 -DLUA_VERSION_MINOR=4"
