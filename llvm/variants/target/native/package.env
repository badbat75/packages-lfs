# llvm, target native: the LLVM of the global toolchain, in its own directory
# ${GLOBAL_TOOLCHAIN_PATH}/llvm-<version> (setup_llvm puts its bin in the PATH, the clang of every
# platform toolchain is a copy of its clang with its lib, setup_clang_config). The programs the
# cross builds of lfs/llvm run (LLVM_NATIVE_TOOL_DIR) come from here
### The compiler of the build host: there is no clang before this one
PKG_TOOLCHAIN=gnu
PKG_OVERRIDELTO=0
INSTALL_PREFIX=${GLOBAL_TOOLCHAIN_PATH}/llvm-${PKG_VER}
INSTALL_EXECPREFIX=${INSTALL_PREFIX}
INSTALL_LIBDIR=${INSTALL_PREFIX}/lib
INSTALL_INCLUDEDIR=${INSTALL_PREFIX}/include
INSTALL_SYSCONFDIR=${INSTALL_PREFIX}/etc
INSTALL_SHAREDIR=${INSTALL_PREFIX}/share
### The sources of the target builds, prepared once (sources_key), and a kept build tree of its own
PKG_KEEPBUILDDIR=1

### The libraries of the global toolchain (the native recipes of PKG_DEPS), found before the ones of
### the build host and loaded through the RUNPATH of the native builds; the RUNPATH of LLVM itself
### ($ORIGIN/../lib) is the one of its cmake build, which cmakebuild skips otherwise
CONF_FLAGS+=" -DCMAKE_PREFIX_PATH=${GLOBAL_TOOLCHAIN_PATH} -DZLIB_ROOT=${GLOBAL_TOOLCHAIN_PATH}"
CONF_FLAGS+=" -DCMAKE_SKIP_RPATH:BOOL=OFF"
### The plugin header of lfs/binutils:native (LLVMgold.so, the LTO plugin of bfd)
CONF_FLAGS+=" -DLLVM_BINUTILS_INCDIR=${GLOBAL_TOOLCHAIN_PATH}/include"

### The version, and the FFI_ROOT that postbuild.sh writes into LLVMConfig.cmake: an LLVM without it
### is not this recipe's (setup_llvm built it by hand, without FFI)
PKG_CHECK="[ x\$( ${INSTALL_EXECPREFIX}/bin/llvm-config --version 2>/dev/null || true ) == x${PKG_VER} ] && [ -x ${INSTALL_EXECPREFIX}/bin/clang-tidy-confusable-chars-gen ] && grep -qxF '  set(FFI_ROOT ${GLOBAL_TOOLCHAIN_PATH})' ${INSTALL_LIBDIR}/cmake/llvm/LLVMConfig.cmake"
