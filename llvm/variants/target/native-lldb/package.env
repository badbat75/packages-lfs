# llvm, target native-lldb: the lldb of the global LLVM, with the scripting in python (the python of the
# global toolchain, setup_python) and in lua, a standalone build of its sources over lfs/llvm:native,
# installed into the same prefix (target/native). setup_full_toolchain builds it after the python
### Not the default build: the values of package.env and target/native this target keeps or drops
PKG_DEPS="lfs/llvm:native lfs/python3:native lfs/lua:native ${LLDB_DEPS}"
CONF_FLAGS="-S\${PKG_SRCPATH}/lldb ${LLDB_FLAGS}"
CONF_FLAGS+=" -DLLVM_DIR=${INSTALL_LIBDIR}/cmake/llvm -DClang_DIR=${INSTALL_LIBDIR}/cmake/clang"
### The libraries of the global toolchain, and the RUNPATH of lldb ($ORIGIN/../lib) with them
CONF_FLAGS+=" -DCMAKE_PREFIX_PATH=${GLOBAL_TOOLCHAIN_PATH} -DCMAKE_SKIP_RPATH:BOOL=OFF"
### The python of setup_python, whose library is in its own prefix
CONF_FLAGS+=" -DPython3_EXECUTABLE=${PYTHON_FOR_BUILD}"
PKG_LDFLAGS="-Wl,-rpath,${GLOBAL_TOOLCHAIN_PATH}/python-${PYTHON_VER}/lib"
### lldb, and the scripting in both languages: "script -l <language> -- print(6*7)" prints 42 twice
PKG_CHECK="[ \"\$( ${INSTALL_EXECPREFIX}/bin/lldb -b -o 'script -l python -- print(6*7)' -o 'script -l lua -- print(6*7)' 2>/dev/null | grep -c '^42\$' )\" == 2 ]"
