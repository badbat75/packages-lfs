# llvm
### The version: LLVM_VER of the project overrides it
LLVM_VER=${LLVM_VER:-23.1.2}
PKG_VER=${LLVM_VER}
PKG_URL="https://github.com/llvm/llvm-project/archive/refs/tags/llvmorg-${PKG_VER}.tar.gz"
### The same LLVM in every build, the global one of the build machine (lfs/llvm:native) and the ones
### of the image: the libraries below (lfs/<name>:native for the global one, the sysroot for the
### others), the projects, every backend. The variants give only where it installs and what it
### builds with
PKG_DEPS="lfs/binutils lfs/zlib lfs/zstd lfs/xz lfs/libxml2 lfs/ncurses lfs/libedit lfs/libffi"
BUILD_PROCESS=cmakebuild
CMAKE_GENERATOR=Ninja
CONF_FLAGS="-S\${PKG_SRCPATH}/llvm"
case ${PKG_OVERRIDELTO:-${LTOENABLE:-0}} in
	1|fat) CONF_FLAGS+=" -DLLVM_ENABLE_LTO=fat"
		;;
	2|thin)	CONF_FLAGS+=" -DLLVM_ENABLE_LTO=thin"
		;;
esac
### Since LLVM 23 libclc is a runtime (LLVM_ENABLE_RUNTIMES) built with the just built clang, out of
### reach for a cross build: the target libclc builds it from these same sources with the clang of the
### target native. The profile runtime of compiler-rt is the target compiler-rt
CONF_FLAGS+=" -DLLVM_ENABLE_PROJECTS=\"clang;clang-tools-extra;lld;lldb;polly\""
CONF_FLAGS+=" -DLLVM_TARGETS_TO_BUILD=all"
CONF_FLAGS+=" -DLLVM_BUILD_LLVM_DYLIB:BOOL=ON -DLLVM_LINK_LLVM_DYLIB:BOOL=ON"
CONF_FLAGS+=" -DCLANG_LINK_CLANG_DYLIB:BOOL=ON -DCLANG_PLUGIN_SUPPORT:BOOL=ON"
CONF_FLAGS+=" -DLLVM_ENABLE_RTTI:BOOL=ON -DLLVM_ENABLE_EH:BOOL=ON"
CONF_FLAGS+=" -DLLVM_ENABLE_LIBCXX:BOOL=OFF"
### The libraries: compressed sections (zlib, zstd), llvm-mt and the gdb-remote XML of lldb (libxml2),
### the line editing of lldb and clang-repl (libedit), the curses GUI (ncurses) and the MiniDebugInfo
### (lzma) of lldb, the external calls of lli (libffi). No lua and python in lldb
CONF_FLAGS+=" -DLLVM_ENABLE_ZLIB=FORCE_ON -DLLVM_ENABLE_ZSTD=FORCE_ON -DLLVM_ENABLE_LIBXML2=FORCE_ON"
CONF_FLAGS+=" -DLLVM_ENABLE_LIBEDIT:BOOL=ON -DLLVM_ENABLE_FFI:BOOL=ON"
CONF_FLAGS+=" -DLLDB_ENABLE_LIBEDIT:BOOL=ON -DLLDB_ENABLE_CURSES:BOOL=ON -DLLDB_ENABLE_LZMA:BOOL=ON"
CONF_FLAGS+=" -DLLDB_ENABLE_LIBXML2:BOOL=ON -DLLDB_ENABLE_LUA:BOOL=OFF -DLLDB_ENABLE_PYTHON:BOOL=OFF"
CONF_FLAGS+=" -DLLVM_USE_PERF:BOOL=ON -DLLVM_POLLY_LINK_INTO_TOOLS:BOOL=ON"
CONF_FLAGS+=" -DLLVM_INCLUDE_UTILS:BOOL=ON -DLLVM_INSTALL_UTILS:BOOL=ON"
CONF_FLAGS+=" -DLLVM_INCLUDE_EXAMPLES:BOOL=OFF -DLLVM_INCLUDE_TESTS:BOOL=OFF -DLLVM_INCLUDE_BENCHMARKS:BOOL=OFF"
CONF_FLAGS+=" -DLLVM_BUILD_EXAMPLES:BOOL=OFF -DLLVM_BUILD_TESTS:BOOL=OFF -DLLVM_ENABLE_BINDINGS:BOOL=OFF"
CONF_FLAGS+=" -DENABLE_LINKER_BUILD_ID:BOOL=ON"
### The runtime library of every clang is libgcc, as the gcc of the platform
CONF_FLAGS+=" -DCLANG_DEFAULT_RTLIB=libgcc -DCLANG_DEFAULT_UNWINDLIB=libgcc"
### One link job per 8 GiB of memory, read when runconfig.sh runs (single quotes): the links of
### libLLVM, libclang-cpp and lldb take several GiB each
CONF_FLAGS+=' -DLLVM_PARALLEL_LINK_JOBS=$(( $(grep MemTotal /proc/meminfo | tr -dc 0-9) / 8388608 + 1 ))'
CONF_FLAGS+=" -Wno-dev"
PKG_OVERRIDESHARED=0
PKG_OVERRIDESTATIC=1
PKG_TOOLCHAIN=llvm
### The make targets of the flavors are in variants/target/

PKG_MAKETARGETS="install/strip"
