# rsync
PKG_VER=3.5.1
PKG_URL="https://www.samba.org/ftp/rsync/src/rsync-${PKG_VER}.tar.gz"
PKG_DEPS="lfs/zlib"
PKG_DEPS+=" lfs/popt"
PKG_DEPS+=" lfs/lz4"
PKG_DEPS+=" lfs/xxhash"
BUILD_PROCESS=configmake
#PKG_AUTOCONF=1
CONF_FLAGS="--without-included-zlib"
PKG_LDFLAGS="-s"
PKG_MAKETARGETS=",install"

