# kernel, platform generic-aarch64 or generic-armv7 or generic-x64
CONF_FLAGS+=" -m VIRTIO_MEM -m CONFIG_VIRTIO_BALLOON -m CONFIG_VIRTIO_MMIO"
### The screen from the first line of the kernel: simpledrm on the framebuffer the UEFI firmware leaves
### (sysfb), then virtio-gpu, both built in with DRM and the PCI transport of virtio; as modules the
### console reached the screen only when the initramfs loaded them, and the lines before stayed on the
### serial port
CONF_FLAGS+=" -e VIRTIO_PCI -e DRM -e DRM_VIRTIO_GPU -e SYSFB_SIMPLEFB -e DRM_SIMPLEDRM"
CONF_FLAGS+=" -e FB -e DRM_FBDEV_EMULATION -e FRAMEBUFFER_CONSOLE"
CONF_FLAGS+=" -m VIRTIO_INPUT -m HW_RANDOM_VIRTIO -m SND_VIRTIO -m VIRTIO_FS"
#CONF_FLAGS+=" -d DRM_NOUVEAU -d DRM_ROCKCHIP -d DRM_SUN4I -d DRM_MSM -d DRM_TEGRA"
### Added to the file systems of WITH_KERNEL_FS, which a replacement dropped: with WITH_INITRAMFS=1 ext4
### is a module, and an initramfs without it does not mount the root
PKG_KERNEL_INITRAMFS_DRIVERS+=" virtio_input"
### cfg80211 as a module: built in (x86_64_defconfig), it asks for regulatory.db at its init, before
### the root file system is mounted, and never finds it (lfs/wireless-regdb installs it there);
### mac80211 follows it to a module
CONF_FLAGS+=" -m CFG80211 -m MAC80211"
### What QEMU gives the guest besides the virtio devices, all as modules: virtio-fs needs FUSE; vsock
### (vhost-vsock-pci) for a guest agent; the virtual radios of mac80211_hwsim (modprobe mac80211_hwsim
### radios=2: hostapd on one, wpa_supplicant or NetworkManager on the other) and the drivers of the
### common USB WiFi dongles passed through (-device usb-host), with their firmware of linux-firmware;
### Bluetooth, which the defconfig of x86_64 leaves out: the virtual controller of hci_vhci for bluez
### and the USB dongles
CONF_FLAGS+=" -m FUSE_FS -m VSOCKETS -m VIRTIO_VSOCKETS"
CONF_FLAGS+=" -m MAC80211_HWSIM -m RTL8XXXU -m RT2X00 -m RT2800USB -m MT7601U -m ATH9K_HTC"
CONF_FLAGS+=" -m BT -m BT_HCIVHCI -m BT_HCIBTUSB"
### Last: scripts/config makes every later name upper case unless --keep-case, and the symbol is MT76x2U
CONF_FLAGS+=" --keep-case -m MT76x2U"
