# bubblewrap
PKG_VER=0.13.0
PKG_URL="https://github.com/containers/bubblewrap/releases/download/v${PKG_VER}/bubblewrap-${PKG_VER}.tar.xz"
### bwrap: the unprivileged sandbox lfs/glycin starts every image loader in (user namespaces, seccomp)
PKG_DEPS="lfs/libcap2"
BUILD_PROCESS=mesonninja
### man: xsltproc and the docbook style sheets of the host
CONF_FLAGS="-Dman=disabled -Dselinux=disabled -Dtests=false"
