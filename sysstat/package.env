# sysstat
PKG_VER=12.8.0
PKG_URL="https://github.com/sysstat/sysstat/archive/refs/tags/v${PKG_VER}.tar.gz"
PKG_AUTOCONF=1
PKG_COPYSRC=1
BUILD_PROCESS=configmake
CONF_ENV="sa_lib_dir=${INSTALL_PREFIX}/lib/sa \
    sa_dir=/var/log/sa \
    conf_dir=/etc/sysconfig"
### configure finds systemd.pc in the sysroot and "make install" would run "systemctl enable
### sysstat.service" on the host: --enable-copy-only limits the install to copying the files,
### the unit directory is pinned to the one the postbuild fills
CONF_FLAGS="--disable-file-attr --enable-copy-only --with-systemdsystemunitdir=/lib/systemd/system"
PKG_CFLAGS="-Wno-deprecated-declarations"
#PKG_MAKETARGETS="all,install"

