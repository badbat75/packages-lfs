# gcc, targets libgcc, libatomic, libstdc++-v3, libgomp, libssp, libvtv, libsanitizer, libquadmath: the
# target libraries of the cross gcc (setup_gcc, after the C library), built in the build tree of
# gcc:cross, installed into the platform toolchain and packaged for the sysroot
### Not the default build: the values of package.env these targets keep or drop
PKG_DEPS="lfs/gcc:cross"
BUILD_PROCESS=none
### The sources of gcc:cross (gthr-posix.h of libgcc), prepared once
PKG_KEEPBUILDDIR=1
GCC_MAJVER=${PKG_VER%%.*}
GCC_CROSS_BLDPATH=${BLD_PATH}/${PKG_NAME}_${PKG_VER}-cross
GCC_STAGE_CC_WRAPPER="${CCWRAPPER:+sh ${PKG_RECIPEPATH}/files/sccache_wrapper ${CCWRAPPER}}"
### The libraries go into the sysroot and the image; libsanitizer only into the platform toolchain
GCC_PACKAGE_LIBRARY=1
### WITH_MAIN_GCC=1 (setup_gcc --main_gcc): the gcc of the image, its libraries linked into the library
### directory of the sysroot; otherwise they stay in the directory of the version, which ld.so.conf.d names
WITH_MAIN_GCC=${WITH_MAIN_GCC:-0}
