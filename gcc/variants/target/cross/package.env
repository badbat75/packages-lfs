# gcc, target cross: the cross gcc of the platform toolchain (setup_gcc), stage 2: the C and C++
# compilers, whose build tree the target libraries reuse (the libgcc,... targets). Every cross-<name>
# target (cross-stage1, cross-libgcc) starts from this file
### The libraries of the build machine in the global toolchain, the bootstrap compiler and the
### headers and start files of the C library it needs (glibc:stage1), unless the sysroot is the image of
### a distribution with its own
PKG_DEPS="lfs/bison:native lfs/flex:native lfs/doxygen:native lfs/zlib:native"
PKG_DEPS+=" lfs/libgmp:native lfs/libmpfr:native lfs/libmpc:native lfs/libisl:native"
PKG_DEPS+=" lfs/gcc:cross-stage1"
### The sysroot of the cross gcc (gcc_sysroot, toolchain.functions): the image of a distribution when
### it has the C library, the sysroot of the project otherwise
GCC_SYSROOT=$( gcc_sysroot 2>/dev/null || echo "${BIN_PATH}" )
PKG_DEPS+=$( [ "${GCC_SYSROOT}" == "${BIN_PATH}" ] && echo " lfs/glibc:stage1" || true )
### The build tree of this target, kept for the target libraries
GCC_CROSS_BLDPATH=${BLD_PATH}/${PKG_NAME}_${PKG_VER}-cross
PKG_KEEPBUILDDIR=1
PKG_CHECK="[[ \"\$( ${INSTALL_EXECPREFIX}/bin/${HARCH}-g++ -dumpfullversion 2>/dev/null || true )\" == ${PKG_VER%.*}.* ]] && [ -f ${GCC_CROSS_BLDPATH}/config.status ]"

GCC_MAJVER=${PKG_VER%%.*}
CONF_FLAGS="--build=${BARCH} --host=${BARCH} --target=${HARCH} --prefix=${INSTALL_PREFIX}"
### The architecture of the platform: the default -march of the compiler
CONF_FLAGS+=" --enable-targets=${HM}-${HOS}-${HLIBC} --with-arch-directory=${HM}${HMARCH:+ --with-arch=${HMARCH}}"
CONF_FLAGS+="${HMFPU:+ --with-fpu=${HMFPU}}${HMFLOATABI:+ --with-float=${HMFLOATABI}}"
CONF_FLAGS+=" --with-sysroot=${GCC_SYSROOT} --with-system-zlib"
CONF_FLAGS+=" --with-mpc-include=${GLOBAL_TOOLCHAIN_PATH}/include --with-mpc-lib=${GLOBAL_TOOLCHAIN_PATH}/lib"
CONF_FLAGS+=" --with-mpfr-include=${GLOBAL_TOOLCHAIN_PATH}/include --with-mpfr-lib=${GLOBAL_TOOLCHAIN_PATH}/lib"
CONF_FLAGS+=" --with-gmp-include=${GLOBAL_TOOLCHAIN_PATH}/include --with-gmp-lib=${GLOBAL_TOOLCHAIN_PATH}/lib"
CONF_FLAGS+=" --with-isl-include=${GLOBAL_TOOLCHAIN_PATH}/include --with-isl-lib=${GLOBAL_TOOLCHAIN_PATH}/lib"
GCC_CROSS_FLAGS="--enable-version-specific-runtime-libs --with-gcc-major-version-only --enable-checking=release"
GCC_CROSS_FLAGS+="$( [ "${MULTI_ARCH}" -eq 1 ] && [ -z "${HARCH_LIB}" ] && echo " --enable-multiarch" || true )"
GCC_CROSS_FLAGS+=" --disable-option-checking --disable-nls --disable-multilib"
CONF_FLAGS+=" ${GCC_CROSS_FLAGS}"
CONF_FLAGS+=" --enable-languages=${GCC_LANGUAGES:-c,c++} --enable-threads=posix --enable-shared"
CONF_FLAGS+=" --enable-tls --enable-__cxa_atexit --disable-libunwind-exceptions --enable-gnu-unique-object"
CONF_FLAGS+=" --enable-linker-build-id --enable-libstdcxx-backtrace"
CONF_FLAGS+=" --with-linker-hash-style=gnu --enable-plugin --enable-initfini-array --enable-gnu-indirect-function"
CONF_FLAGS+="$( [[ "${GCC_LANGUAGES}" =~ fortran ]] && echo " --enable-libquadmath --enable-libquadmath-support" || true )"

### The host programs: the warnings of a release, the optimization of GCC_OPTLEVEL, LTO of GCC_LTOENABLE
GCC_WARNING_FLAGS="-Wno-maybe-uninitialized -Wno-stringop-overflow -Wno-stack-usage -Wno-alloc-size-larger-than"
PKG_CFLAGS="${GCC_WARNING_FLAGS}${GCC_OPTLEVEL:+ -O${GCC_OPTLEVEL}}"
PKG_CXXFLAGS="${PKG_CFLAGS}"
PKG_OVERRIDELTO=${GCC_LTOENABLE:-0}
### Without the headers of the platform toolchain, which the cross environment adds before the ones of
### the sources: the ctf.h of lfs/binutils:cross hides the one of gcc. The programs the build runs on
### the build machine get the same flags (set when the build is configured, single quotes)
CONF_VARS='CFLAGS="${CFLAGS//-I${TOOLCHAIN_PATH}\/include/}" CXXFLAGS="${CXXFLAGS//-I${TOOLCHAIN_PATH}\/include/}"'
CONF_VARS+=' CFLAGS_FOR_BUILD="${CFLAGS//-I${TOOLCHAIN_PATH}\/include/}" CXXFLAGS_FOR_BUILD="${CXXFLAGS//-I${TOOLCHAIN_PATH}\/include/}"'
### The target libraries (libgcc, libstdc++...) go into the image: the flags of the platform, no run
### time path of the global toolchain, the source path maps of a target build (host_path_maps), or
### __FILE__ of their assert messages names the build and source trees
GCC_TARGET_CFLAGS="${PLATFORM_CFLAGS} ${GCC_WARNING_FLAGS}$( SYSROOT=${GCC_SYSROOT} host_path_maps 2>/dev/null | sed 's/^/ -ffile-prefix-map=/' | tr -d '\n' || true )"
CONF_VARS+=" CFLAGS_FOR_TARGET=\"${GCC_TARGET_CFLAGS}\" CXXFLAGS_FOR_TARGET=\"${GCC_TARGET_CFLAGS}\""
CONF_VARS+=" LDFLAGS_FOR_TARGET=\"${GNU_EXTRALDFLAGS}\""
### The compiler wrapper (sccache) for the xgcc of the build tree too (files/sccache_wrapper)
GCC_STAGE_CC_WRAPPER="${CCWRAPPER:+sh ${PKG_RECIPEPATH}/files/sccache_wrapper ${CCWRAPPER}}"
PKG_MAKEVARS="STAGE_CC_WRAPPER=\"${GCC_STAGE_CC_WRAPPER}\""
PKG_MAKETARGETS="all-host,install-strip-host"
