# gcc, target cross-libgcc: the libgcc the C library is built with, before it exists (no posix threads),
# in the build tree of gcc:cross and only for the platform toolchain; the libgcc target replaces it
### Not the default build: the values of target/cross this target keeps or drops
PKG_DEPS="lfs/gcc:cross"
PKG_CHECK=
PKG_KEEPBUILDDIR=1
BUILD_PROCESS=none
