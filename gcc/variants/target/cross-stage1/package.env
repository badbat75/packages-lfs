# gcc, target cross-stage1: the bootstrap C compiler of the platform toolchain, without the headers of a
# C library (glibc:stage1 is built with it), in a build tree of its own
### Not the default build: the values of target/cross this target keeps or drops
PKG_DEPS="lfs/bison:native lfs/flex:native lfs/zlib:native"
PKG_DEPS+=" lfs/libgmp:native lfs/libmpfr:native lfs/libmpc:native lfs/libisl:native"
PKG_KEEPBUILDDIR=0
### Any compiler of this version: the one of stage 2 too
PKG_CHECK="[[ \"\$( ${INSTALL_EXECPREFIX}/bin/${HARCH}-gcc -dumpfullversion 2>/dev/null || true )\" == ${PKG_VER%.*}.* ]]"
CONF_FLAGS="${CONF_FLAGS%% --enable-languages=*} --enable-languages=c --without-headers --disable-shared"
PKG_MAKETARGETS="all-gcc,install-strip-gcc"
