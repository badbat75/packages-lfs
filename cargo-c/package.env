# cargo-c: the cargo cbuild/cinstall subcommands building C ABI libraries from Rust crates
### A host tool (lfs/cargo-c:native) for the meson builds of librsvg and the like; the host
### openssl headers serve the cargo crate it links
PKG_VER=0.10.25
PKG_URL="https://github.com/lu-zero/cargo-c/archive/refs/tags/v${PKG_VER}.tar.gz"
BUILD_PROCESS=cargobuild
PKG_OVERRIDELTO=0
CONF_FLAGS=""
CARGO_BINLIST="cargo-capi cargo-cbuild cargo-cinstall cargo-ctest"
PKG_LDFLAGS=-s
