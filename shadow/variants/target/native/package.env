# shadow, target native: useradd and chpasswd, which the directives of osconfig.functions run on the
# host against the root of a mounted image (--prefix: the databases of the target, no chroot)
### No PAM, audit, ACL, logind or cracklib: the yescrypt of lfs/libxcrypt:native only
PKG_DEPS="lfs/bison:native lfs/libxcrypt:native"
CONF_FLAGS="--without-libbsd --without-libpam --without-audit --without-acl --without-attr --without-selinux \
	--without-btrfs --without-su --disable-logind --disable-nls --with-yescrypt"
PKG_MAKEVARS=
PKG_MAKETARGETS="all"
### The programs have no version option: the version they were built from is in a file next to them
### (postbuild.sh)
PKG_CHECK="[ x\$( cat ${INSTALL_SHAREDIR}/shadow.version 2>/dev/null || true ) == x${PKG_VER} ]"
