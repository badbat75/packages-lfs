u_format_unpack_neon.c and pan_afbc.c turn NEON on for the rest of the file with
#pragma GCC target ("fpu=neon") and choose the NEON path at run time. clang ignores the pragma and
has no per function equivalent on ARM (target("fpu=neon") leaves the intrinsics refused,
target("neon") crashes the backend on ARMv6): without a NEON baseline (__ARM_NEON, the ARM1176 of
the Pi 1 has none) it stops on "needs target feature neon". With clang on such a target the NEON
path goes; gcc, clang with NEON (-mfpu=neon-*) and aarch64 are unchanged.

--- a/src/panfrost/lib/pan_afbc.c
+++ b/src/panfrost/lib/pan_afbc.c
@@ -8,7 +8,10 @@
 #include "util/detect_arch.h"
 #include "util/u_cpu_detect.h"
 
-#if DETECT_ARCH_AARCH64 || (DETECT_ARCH_ARM && !defined(__SOFTFP__))
+/* The GCC target pragma below turns NEON on for the rest of the file: clang ignores it, and on
+ * ARM it has no per function equivalent, so without a NEON baseline (__ARM_NEON) it refuses the
+ * intrinsics and the NEON path goes. */
+#if DETECT_ARCH_AARCH64 || (DETECT_ARCH_ARM && !defined(__SOFTFP__) && (defined(__ARM_NEON) || !defined(__clang__)))
 /* armhf builds default to VFP, not NEON, and refuses to compile NEON
  * intrinsics unless you tell it "no really". */
 #if DETECT_ARCH_ARM
@@ -105,7 +108,7 @@
       pan_afbc_payload_uncompressed_size(format, modifier);
    uint32_t body_size = 0;
 
-#if DETECT_ARCH_ARM && !defined(__SOFTFP__)
+#if DETECT_ARCH_ARM && !defined(__SOFTFP__) && (defined(__ARM_NEON) || !defined(__clang__))
 
    if (unlikely(!util_get_cpu_caps()->has_neon))
       goto no_neon;
