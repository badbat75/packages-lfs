# Mesa
PKG_VER=26.2.3
PKG_URL="https://mesa.freedesktop.org/archive/mesa-${PKG_VER}.tar.xz"
PKG_DEPS="lfs/bison:native lfs/flex:native lfs/cbindgen:native lfs/libX11 lfs/libXfixes lfs/libxshmfence lfs/libXxf86vm lfs/libxcb lfs/libXrandr"
PKG_DEPS+=" lfs/wayland-protocols"
### meson.build imports yaml with the cross python for every configuration since Mesa 24.2
PKG_DEPS+=" python/PyYAML"
BUILD_PROCESS=mesonninja
### Mesa 26.2 refuses to configure with b_lto ("Building Mesa with LTO is not supported")
PKG_OVERRIDELTO=0
CONF_FLAGS="-Dplatforms=x11,wayland"
CONF_FLAGS+=" -Dvalgrind=disabled"
CONF_FLAGS+=" -Dstrip=true"
#PKG_MAKETARGETS="all,install"

PKG_DEPS+=" lfs/libva"
PKG_DEPS+=" lfs/libvdpau"
### llvm-libs: the libLLVM dylib and the clang libraries of the target, no lld (the full build is
### the development tools of lfs.prj). It depends on lfs/llvm:headers, built first: the LLVM
### and clang headers and the OpenCL C headers of clang that mesa-clc-bundle-headers links
### into rusticl
PKG_DEPS+=" lfs/llvm:llvm-libs"
PKG_DEPS+=" lfs/libgcrypt"
PKG_DEPS+=" lfs/nettle"
PKG_DEPS+=" lfs/libunwind"
### The freedreno tools (freedreno is in the gallium drivers but on x86_64): without libarchive in the
### sysroot meson took it from its wrap, from the network
PKG_DEPS+=" lfs/libarchive"
PKG_DEPS+=" lfs/lm-sensors"
#PKG_DEPS+=" lfs/libtizonia"
PKG_DEPS+=" lfs/Vulkan-Loader lfs/glslang lfs/Vulkan-SPIRV-LLVM-Translator"
PKG_DEPS+=" python/pycparser"
### The llvm-config of the sysroot is a program of the target: through <HARCH>-run (meson splits the
### variable into a command)
CONF_ENV="LLVM_CONFIG=\"${HARCH}-run \${SYSROOT}${INSTALL_EXECPREFIX}/bin/llvm-config\""
### The gallium drivers: the ones of every machine and those of the GPUs of the ARM boards (Broadcom of
### the Raspberry Pi, Qualcomm, Vivante, Tegra, Mali); variants/arch/x86_64 has the Intel and AMD ones
### instead. Expanded when runconfig.sh runs (single quotes)
MESA_GALLIUM_DRIVERS="nouveau,svga,virgl,softpipe,llvmpipe,zink"
MESA_GALLIUM_DRIVERS+=",v3d,vc4,freedreno,etnaviv,tegra,lima,panfrost"
CONF_FLAGS+=' -Dgallium-drivers=${MESA_GALLIUM_DRIVERS}'
CONF_FLAGS+=" -Dvulkan-drivers=auto"
### rusticl, the OpenCL frontend. Its Rust goes through meson: rustc for the target and the clang
### arguments of bindgen come from a second cross file (prebuild.sh) that meson merges with the one
### of the framework. static-libclc links the libclc SPIR-V in, read at build time from libexecdir of
### libclc.pc: that is the image path under the FDO sysroot rules, so the environment override of
### pkgconf points meson at the sysroot copy (single quotes: expanded when runconfig.sh runs). The
### OpenCL C headers of clang are looked up at run time in the libdir that llvm-config of the sysroot
### reports (a host path): mesa-clc-bundle-headers links them in
PKG_DEPS+=" lfs/libclc"
CONF_FLAGS+=" -Dgallium-rusticl=true -Dstatic-libclc=all -Dmesa-clc-bundle-headers=enabled"
CONF_ENV+=' PKG_CONFIG_LIBCLC_LIBEXECDIR=${PKG_CONFIG_SYSROOT_DIR}${INSTALL_SHAREDIR}/clc'
CONF_FLAGS+=' --cross-file ${PKG_SRCPATH}/bbxb-rust.ini'
### The proc macros are built for the build machine, whose linker meson also takes from the C compiler
### command (CC_FOR_BUILD, sccache first): the compiler alone, expanded when runconfig.sh runs
CONF_ENV+=' RUSTC_LD_FOR_BUILD=${CC_FOR_BUILD##* }'
PKG_MAKEENV="sed 's,-isystem/usr/include ,,g' -i build.ninja;"
