# wpa2
PKG_VER=2.11
### git.w1.fi no longer serves cgit snapshots of the whole hostap tree ("Unsupported snapshot
### format"): each target takes its own release tarball, which carries src/ and its own directory.
### The sources are re-extracted for every build, so the two targets can share PKG_SRCPATH.
case ${PKG_TARGET} in
	hostapd)
		PKG_URL="https://w1.fi/releases/hostapd-${PKG_VER}.tar.gz"
	;;
	*)
		PKG_URL="https://w1.fi/releases/wpa_supplicant-${PKG_VER}.tar.gz"
	;;
esac

case ${PKG_TARGET} in
	wpa_supplicant)
		BUILD_PROCESS=simplemake
		PKG_MAKETARGETS="all"
		PKG_DEPS="lfs/D-Bus lfs/ncurses lfs/readline lfs/libnl lfs/openssl lfs/pcsc-lite firmwares/wireless-regdb"
		PKG_MAKEVARS="PREFIX=${INSTALL_PREFIX} INCDIR=${INSTALL_INCLUDEDIR} BINDIR=/sbin -C wpa_supplicant"
		PKG_CFLAGS="-I\${SYSROOT}${INSTALL_INCLUDEDIR}/PCSC"
		PKG_CFLAGS+=" -Wno-deprecated-declarations"
		### DBus Configuration
		PKG_DEPS+=" lfs/D-Bus"
	;;
	hostapd)
		BUILD_PROCESS=simplemake
		PKG_MAKETARGETS="all"
		PKG_DEPS="lfs/libnl"
		PKG_MAKEVARS="PREFIX=${INSTALL_PREFIX} INCDIR=${INSTALL_INCLUDEDIR} BINDIR=${INSTALL_PREFIX}/sbin -C hostapd"
	;;
	*)
		BUILD_PROCESS=downloadonly
	;;
esac
