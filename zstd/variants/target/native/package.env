# zstd, target native: the zstd that packs the initramfs kernelbuild makes on the host (dracut)
### The programs without the zlib, lzma and lz4 formats: no dependency on the host libraries
PKG_DEPS=
PKG_MAKEVARS+=" HAVE_ZLIB=0 HAVE_LZMA=0 HAVE_LZ4=0"
PKG_CHECK="${INSTALL_EXECPREFIX}/bin/zstd -V 2>/dev/null | grep -q ' v${PKG_VER},'"
