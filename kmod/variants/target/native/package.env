# kmod, target native: libkmod of the build host, for the dracut-install of lfs/dracut:native, and
# depmod and modinfo, which the kernel builds and dracut run
### The compressions of the modules the kernels install (.ko.xz) from the libraries of the global
### toolchain, no module signing: no target dependencies
PKG_DEPS="lfs/xz:native lfs/zstd:native lfs/zlib:native"
CONF_FLAGS="--without-openssl --with-xz --with-zstd --with-zlib --disable-manpages"
PKG_CHECK="[ \"$(PKG_CONFIG_LIBDIR=${INSTALL_LIBDIR}/pkgconfig pkg-config --modver libkmod 2>/dev/null || :)\" == \"${PKG_VER}\" ] && [ -L ${INSTALL_EXECPREFIX}/bin/depmod ]"
