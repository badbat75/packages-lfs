# kmod, target native: libkmod of the build host, for the dracut-install of lfs/dracut:native
### The compressions of the modules the kernels install (.ko.xz) from the development files of the
### host, no module signing: no target dependencies
PKG_DEPS=
CONF_FLAGS="--without-openssl --with-xz --with-zstd --with-zlib --disable-manpages"
PKG_CHECK="[ \"$(PKG_CONFIG_LIBDIR=${INSTALL_LIBDIR}/pkgconfig pkg-config --modver libkmod 2>/dev/null || :)\" == \"${PKG_VER}\" ]"
