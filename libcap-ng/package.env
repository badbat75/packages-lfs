# libcap-ng
PKG_VER=0.9.6
### No release tarball since 0.9 (people.redhat.com stops at 0.8): the tag archive, autoreconf'd
PKG_URL="https://github.com/stevegrubb/libcap-ng/archive/refs/tags/v${PKG_VER}.tar.gz"
PKG_AUTOCONF=1
BUILD_PROCESS=configmake
### The Python bindings serve no build of the project
CONF_FLAGS="--without-python --without-python3"
PKG_MAKETARGETS="all,install-strip"
