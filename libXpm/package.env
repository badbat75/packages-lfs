# libXpm
PKG_VER=3.5.19
PKG_URL="https://www.x.org/pub/individual/lib/libXpm-${PKG_VER}.tar.xz"
PKG_DEPS="lfs/xorgproto lfs/libX11 lfs/libXext"
BUILD_PROCESS=configmake
PKG_AUTOCONF=1
CONF_FLAGS=""
### The compressed pixmaps go through gzip, compress and uncompress, whose paths configure bakes into
### the library: a search on the PATH found the programs of the toolchain (lfs/ncompress:cross was a
### dependency for compress), the image paths are given instead (compress comes from lfs/ncompress)
CONF_VARS="XPM_PATH_GZIP=/usr/bin/gzip XPM_PATH_COMPRESS=/usr/bin/compress XPM_PATH_UNCOMPRESS=/usr/bin/uncompress"
PKG_MAKETARGETS="all,install-strip"
