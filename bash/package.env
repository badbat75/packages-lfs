# bash
PKG_VER=5.2p37
### the savannah cgit snapshot of the 5.2 patch 37 commit is gone (cgit answers 502/404);
### the GNU release tarball carries the same 5.2 sources with patches 1 to 37 applied
PKG_URL="https://ftp.gnu.org/gnu/bash/bash-$(echo ${PKG_VER} | sed 's/p/./').tar.gz"
PKG_DEPS="lfs/bison:native lfs/flex:native lfs/ncurses lfs/readline"

BUILD_PROCESS=configmake
#PKG_OVERRIDELTO=0
CONF_FLAGS="--without-bash-malloc --with-installed-readline"
PKG_MAKETARGETS="all,install-strip"
PKG_MAKEVARS="STRIP=${HARCH}-strip"

case ${TOOLCHAIN} in
    llvm)
        PKG_CFLAGS="-Wno-deprecated-non-prototype -Wno-parentheses"
        ;;
esac
