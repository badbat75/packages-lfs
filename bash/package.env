# bash
PKG_VER=5.3
### The GNU release tarball; a 5.2pNN version spells the patch level as 5.2.NN in the file name
PKG_URL="https://ftp.gnu.org/gnu/bash/bash-$(echo ${PKG_VER} | sed 's/p/./').tar.gz"
PKG_DEPS="lfs/bison:native lfs/flex:native lfs/ncurses lfs/readline"

BUILD_PROCESS=configmake
#PKG_OVERRIDELTO=0
CONF_FLAGS="--without-bash-malloc --with-installed-readline"
PKG_MAKETARGETS="all,install-strip"
### install-strip goes through support/install-sh -s, which strips with ${STRIPPROG:-strip}: the
### host strip does not recognise the target binaries (the old sed on Makefile.in no longer applies)
PKG_MAKEENV="STRIPPROG=${HARCH}-strip"
