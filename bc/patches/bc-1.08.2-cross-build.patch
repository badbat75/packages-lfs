diff -Naur bc/bc/Makefile.am bc.new/bc/Makefile.am
--- bc/bc/Makefile.am	2024-12-27 00:13:28.000000000 +0100
+++ bc.new/bc/Makefile.am	2026-09-16 16:58:40.740420194 +0200
@@ -8,7 +8,7 @@
              sbc.y fix-libmath.sed
 noinst_HEADERS = libmath.h
 
-CLEANFILES = fbc-bootstrap global_bootstrap.o libmath.tmp
+CLEANFILES = fbc-bootstrap global_bootstrap.o_host libmath.tmp
 
 DISTCLEANFILES = sbc sbc.c sbc.h
 
@@ -19,6 +19,7 @@
 
 AM_CPPFLAGS = -I$(srcdir) -I$(srcdir)/../h
 LIBBC = ../lib/libbc.a
+LIBBC_HOST = ../lib/libbc_host.a
 LIBL = @LEXLIB@
 LDADD = $(LIBBC) $(LIBL) @READLINELIB@
 
@@ -31,10 +32,22 @@
 scan.o: bc.h
 global.o: libmath.h
 
-fbcOBJ = main.o bc.o scan.o execute.o load.o storage.o util.o warranty.o
-fbc-bootstrap: $(fbcOBJ) $(LIBBC)
-	$(COMPILE) -DBOOTSTRAP -c -o global_bootstrap.o global.c
-	$(LINK) -o $@ $(fbcOBJ) global_bootstrap.o $(LIBBC) $(LIBL) $(READLINELIB) $(LIBS)
+fbcOBJ = $(addsuffix _host,main.o bc.o scan.o execute.o load.o storage.o util.o warranty.o)
+
+%.o_host : CC:=$(CC_FOR_BUILD)
+%.o_host : AM_CFLAGS:=
+%.o_host : CFLAGS:=
+%.o_host : %.c
+	$(COMPILE) -c $(CFLAGS) $(INCLUDES) -o $@ $<
+
+fbc-bootstrap: CC:=$(CC_FOR_BUILD)
+fbc-bootstrap: CCLD:=$(CC_FOR_BUILD)
+fbc-bootstrap: CFLAGS:=
+fbc-bootstrap: AM_CFLAGS:=
+fbc-bootstrap: LDFLAGS:=
+fbc-bootstrap: $(fbcOBJ) $(LIBBC_HOST)
+	$(COMPILE) -DBOOTSTRAP -c -o global_bootstrap.o_host global.c
+	$(LINK) -o $@ $(fbcOBJ) global_bootstrap.o_host $(LIBBC_HOST) $(LIBL) $(READLINELIB) $(LIBS)
 
 libmath.h: libmath.b
 	$(MAKE) fbc-bootstrap
