# bc, target native: the bc of the build machine, which the kernel build runs (timeconst.h, the kernel
# recipes); without the readline of the image
PKG_DEPS="lfs/bison:native lfs/flex:native"
CONF_FLAGS=""
PKG_CHECK="[ \"\$( ${INSTALL_EXECPREFIX}/bin/bc --version 2>/dev/null | head -n1 )\" == \"bc ${PKG_VER}\" ]"
