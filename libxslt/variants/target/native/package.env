# libxslt, target native: the xsltproc of the build machine, with the XML catalog of lfs/libxml2:native
# (the DocBook of lfs/docbook-xml and lfs/docbook-xsl): the manual pages of lfs/systemd and lfs/polkit,
# lfs/xkeyboard-config, lfs/xmlto:native
PKG_DEPS="lfs/libxml2"
CONF_FLAGS+=" --without-python"
PKG_CHECK="grep -qx 'Version: ${PKG_VER}' ${INSTALL_LIBDIR}/pkgconfig/libxslt.pc"
